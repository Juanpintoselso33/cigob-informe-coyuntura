                <span class="cg-rez-seg cg-rez-seg--pulso" style={`width:${rez.share_pulso * 100}%`}></span>
                <span class="cg-rez-seg cg-rez-seg--medio" style={`width:${(1 - rez.share_pulso - rez.share_estructural) * 100}%`}></span>
                <span class="cg-rez-seg cg-rez-seg--estr" style={`width:${rez.share_estructural * 100}%`}></span>
              </div>
              <ul class="cg-rez-leyenda">
                <li><span class="cg-rez-dot cg-rez-dot--pulso"></span>{Math.round(rez.share_pulso * 100)}% pulso inmediato — últimas semanas</li>
                <li><span class="cg-rez-dot cg-rez-dot--medio"></span>{Math.round((1 - rez.share_pulso - rez.share_estructural) * 100)}% ventana intermedia</li>
                <li><span class="cg-rez-dot cg-rez-dot--estr"></span>{Math.round(rez.share_estructural * 100)}% describe el año anterior</li>
