---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import IndicadorTile from "../components/IndicadorTile.astro";
import IndicadorModal from "../components/IndicadorModal.astro";
import {
  informe, CINTURONES, verdictDeCinturon, indicadoresOrdenados,
  fuentesDeCinturon, cap, indiceDe, label,
} from "../lib/datos.ts";

export function getStaticPaths() {
  return CINTURONES.map(c => ({ params: { slug: c.slug }, props: { meta: c } }));
}

const { meta } = Astro.props;
const c = informe.cinturones[meta.key];
const verdict = verdictDeCinturon(c.estado);
const verdictLabel = { verde: "Estable", amarillo: "En tensión", rojo: "Crítico" }[verdict];
const filas = indicadoresOrdenados(c);
// Los indicadores de contexto (en_indice === false) no construyen la tensión:
// se muestran en un bloque aparte para no confundirlos con los del índice.
const filasIndice = filas.filter(({ ind }) => ind.en_indice !== false);
const filasContexto = filas.filter(({ ind }) => ind.en_indice === false);
const fuentes = fuentesDeCinturon(c);
const indice = indiceDe(c);   // ITCM / ITCG / ITVC / ITCP, o null (espíritu)
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Gráfico de robustez (ADR-0019): la DISTRIBUCIÓN de la simulación Monte
// Carlo como curva de densidad SVG (server-side, estética de sparkline):
// área suave en el color del cinturón, franja p05-p95 resaltada, línea del
// valor publicado y — para índices base-100 — la línea de referencia del 100.
const rob = indice?.data.robustez ?? null;
const coma = (v: number) => String(v).replace(".", ",");
let robSvg: {
  W: number; H: number; base: number; area: string; line: string;
  x05: number; x95: number; xval: number; x100: number | null;
  pct: (x: number) => number;
} | null = null;
if (rob?.hist && rob.hist_max! > rob.hist_min!) {
  const W = 1120, H = 150;   // panorámico: la card ocupa el ancho completo de la sección
  const n = rob.hist.length;
  const bw = (rob.hist_max! - rob.hist_min!) / n;
  // dominio x = el rango simulado (la campana ocupa todo el ancho); la
  // referencia del 100 solo se dibuja si cae adentro — si no, lo dice el texto
  let x0 = rob.hist_min!, x1 = rob.hist_max!;
  const pad = (x1 - x0) * 0.04;
  x0 -= pad; x1 += pad;
  // suavizado con media móvil (±2 bins) para leerse como densidad
  const sm = rob.hist.map((_, i) => {
    let s = 0, c = 0;
    for (let k = -2; k <= 2; k++) {
      const j = i + k;
      if (j >= 0 && j < n) { s += rob.hist![j]; c++; }
    }
    return s / c;
  });
  const mx = Math.max(...sm);
  const X = (v: number) => ((v - x0) / (x1 - x0)) * W;
  const base = H - 16;
  const Y = (v: number) => base - (v / mx) * (base - 10);
  const pts = sm.map((v, i) =>
    `${X(rob.hist_min! + (i + 0.5) * bw).toFixed(1)},${Y(v).toFixed(1)}`);
  const linea = `M${X(rob.hist_min!).toFixed(1)},${base} L${pts.join(" L")} L${X(rob.hist_max!).toFixed(1)},${base}`;
  robSvg = {
    W, H, base, area: `${linea} Z`, line: linea,
    x05: X(rob.p05), x95: X(rob.p95), xval: X(indice!.data.valor),
    x100: indice!.base100 && 100 >= x0 && 100 <= x1 ? X(100) : null,
    pct: (x: number) => (x / W) * 100,
  };
}
// base-100 con toda la simulación debajo de la línea de base → se narra en texto
const robBajoBase = !!(rob && indice?.base100 && rob.hist_max! < 100);

// Datos extra para los modales de detalle (robustez / validación / matriz)
const domLabel = rob?.dominante ? (label(rob.dominante.indicador) ?? rob.dominante.indicador) : null;
const domDelta = rob?.dominante && indice
  ? Math.round((rob.dominante.indice_sin - indice.data.valor) * 10) / 10 : null;
const robAmplitud = rob ? Math.round((rob.p95 - rob.p05) * 10) / 10 : null;

// Validación externa (una por cinturón con paramétrica): co-movimiento del
// índice reconstruido mes a mes contra su contraste externo propio (ITVC
// recalculado SIN su componente ICC, para no ser circular, contra el ICC
// UTDT; ITCM/ITCG/ITCP contra su propio par de mercado o de prensa). Ambas
// series se rebasean/normalizan al período común para dibujarlas en una
// misma escala.
const val = indice?.data.validacion ?? null;
// Matriz de validación cruzada (las cuatro paramétricas con contraste
// externo — ITCM/ITCG/ITVC/ITCP): se muestra solo en esos cinturones, con la
// fila del índice propio señalada. El filtro es genérico (busca la sigla del
// cinturón actual entre las filas ya calculadas), así que un cinturón sin
// validación propia (n < 12 meses de solape) queda afuera automáticamente
// sin necesidad de una excepción explícita por nombre.
const cruzRaw = indice ? ((informe as any).validacion_cruzada ?? null) : null;
const cruz = cruzRaw?.filas?.some((f: { indice: string }) => f.indice === indice!.sigla)
  ? cruzRaw : null;
// etiquetas cortas de las anclas externas para la matriz en mobile
const CRUZ_CORTAS: Record<string, string> = {
  riesgo: "Riesgo país", merval: "Merval USD", icc: "ICC", epu: "EPU Argentina",
};
let valSvg: {
  W: number; H: number; base: number; top: number;
  lineaIndice: string; lineaExterna: string;
  ticks: { x: number; label: string }[]; y100: number | null;
} | null = null;
if (val && val.pares.length >= 12) {
  const W = 1120, H = 200, base = H - 26, top = 16, padx = 16;
  // Dos modos de escala (definidos por publicar según el par):
  //   rebase100    → ambas series a 100 en el primer mes (vida: escalas afines)
  //   minmax_inv   → externa INVERTIDA y ambas normalizadas al rango del
  //                  período (macro: el riesgo país en pb no comparte escala)
  let serieA: number[], serieB: number[];
  if (val.plot === "minmax_inv" || val.plot === "minmax") {
    const norm = (s: number[]) => {
      const lo = Math.min(...s), hi = Math.max(...s);
      return s.map(v => ((v - lo) / (hi - lo || 1)) * 100);
    };
    serieA = norm(val.pares.map(p => p[1]));
    serieB = norm(val.pares.map(p => (val.plot === "minmax_inv" ? -p[2] : p[2])));
  } else {
    const p0 = val.pares[0];
    serieA = val.pares.map(p => (p[1] / p0[1]) * 100);
    serieB = val.pares.map(p => (p[2] / p0[2]) * 100);
  }
  const todos = [...serieA, ...serieB];
  const y0 = Math.min(...todos) - 3, y1 = Math.max(...todos) + 3;
  const VX = (i: number) => padx + (i / (val.pares.length - 1)) * (W - padx * 2);
  const VY = (v: number) => base - ((v - y0) / (y1 - y0)) * (base - top);
  const trazo = (s: number[]) =>
    "M" + s.map((v, i) => `${VX(i).toFixed(1)},${VY(v).toFixed(1)}`).join(" L");
  valSvg = {
    W, H, base, top,
    lineaIndice: trazo(serieA), lineaExterna: trazo(serieB),
    ticks: val.pares.map((p, i) => ({ ym: p[0], i }))
      .filter(t => t.ym.endsWith("-01"))
      .map(t => ({ x: VX(t.i), label: t.ym.slice(0, 4) })),
    y100: val.plot === "rebase100" ? VY(100) : null,
  };
}

// Gráfico interactivo del modal de validación: series CRUDAS (la card muestra
// las normalizadas) con el valor real de cada mes en el tooltip.
const valChartData = val && indice ? {
  slug: meta.slug,
  indice: { nombre: `${indice.sigla} (reconstrucción)`, unidad: "puntos" },
  externa: {
    nombre: val.externa_label.replace(", invertido", ""),
    unidad: ({ macro: "pb", gestion: "puntos", vida_cotidiana: "puntos" } as Record<string, string>)[meta.key] ?? "",
  },
  ejeBInvertido: val.plot === "minmax_inv",   // correlación negativa: mismo sentido visual que la card
  pares: val.pares,
} : null;
// Distribución interactiva del modal de robustez
const robChartData = rob?.hist && indice ? {
  slug: meta.slug, sigla: indice.sigla,
  hist: rob.hist, hist_min: rob.hist_min, hist_max: rob.hist_max,
  p05: rob.p05, p95: rob.p95, valor: indice.data.valor,
  n_draws: rob.n_draws, base100: !!indice.base100,
} : null;
---
<Layout title={`${meta.nombre} · Informe de Coyuntura · CiGob`}>
  <Nav />
  <header class={`cg-hero cg-detalle-hero cg-detalle-hero--${meta.slug}`} id="top">
    <div class="cg-hero-inner cg-detalle-inner">
      <p class="cg-eyebrow"><a href={`${base}/`}>← Resumen</a> · Cinturón</p>
      <h1 class="cg-hero-title cg-detalle-title">{meta.nombre}</h1>
      <p class="cg-hero-lead cg-detalle-lead">{meta.sub}.</p>
      <div class="cg-detalle-meta">
        <span class:list={["cg-verdict", verdict]}><span class="cg-verdict-dot"></span>{verdictLabel}</span>
        <span class="cg-detalle-chip">Score <strong>{c.score}/10</strong></span>
        {indice && <span class="cg-detalle-chip">{indice.sigla} <strong>{indice.data.valor}{indice.base100 ? "" : "/100"}</strong> · {indice.data.banda_legible}</span>}
        <span class="cg-detalle-chip">Riesgo: <strong>{cap(c.barbarismo_riesgo)}</strong></span>
        <span class="cg-detalle-chip">{filas.length} indicadores</span>
      </div>
    </div>
  </header>
  <main class="cg-main">
    {indice && (
      <section class="cg-section">
        <div class="cg-section-head">
          <p class="cg-eyebrow">Índice paramétrico</p>
          <h2 class="cg-h2">{indice.sigla}: {indice.data.valor}{indice.base100 ? " (base 100 = 4T-2023)" : "/100"} — {indice.data.banda_legible}</h2>
          <p class="cg-h2-sub">{indice.descripcion}</p>
        </div>
        <div class="cg-itcm-dims">
          {Object.entries(indice.data.dimensiones).map(([dkey, dim]) => (
            <div class={`cg-itcm-dim cg-dim--clickable${dim.critica ? " cg-itcm-dim--critica" : ""}`}
                 data-dimension={dkey} data-cinturon={meta.slug}
                 role="button" tabindex="0" aria-label={`Ver la composición de ${dim.nombre}`}>
              <div class="cg-itcm-dim-head">
                <span class="cg-itcm-dim-name">{dim.nombre}</span>
                <span class="cg-itcm-dim-val"><strong>{dim.puntaje}</strong>{indice.base100 ? "" : "/100"} · pesa {Math.round(dim.peso * 100)}%</span>
              </div>
              <div class="cg-bar" role="img" aria-label={`${dim.puntaje} de 100`}>
                <div class="cg-bar-fill" style={`width:${Math.min(100, dim.puntaje)}%`}></div>
              </div>
              {dim.critica && (
                <p class="cg-dim-critica">
                  <span class="cg-dim-critica-chip">Dimensión crítica</span>
                  {" "}el promedio del índice no la compensa
                </p>
              )}
            </div>
          ))}
        </div>
        <p class="cg-dims-hint">Tocá una dimensión para ver su composición: indicadores, pesos y puntajes.</p>
        {indice.data.ajustes_aplicados.length > 0 && (
          <p class="cg-h2-sub" style="margin-top:12px;">
            <strong>Ajustes del analista:</strong>{" "}
            {indice.data.ajustes_aplicados.map(a => `${a.indicador}: ${a.de} → ${a.a} (${a.justificacion})`).join(" · ")}
          </p>
        )}
      </section>
    )}
    <section class="cg-section">
      <div class="cg-section-head">
        <p class="cg-eyebrow">Indicadores</p>
        <h2 class="cg-h2">El detalle, hoy</h2>
        <p class="cg-h2-sub">
          {indice
            ? "Los que construyen el índice de tensión. Tocá cualquiera para ver qué mide, qué aporta y su evolución. Automatizados primero; carga manual y estimaciones al final."
            : "Tocá cualquier indicador para ver qué mide, qué aporta y su evolución. Automatizados primero; carga manual y estimaciones al final."}
        </p>
      </div>
      <div class="cg-tile-grid">
        {filasIndice.map(({ key, ind }) => <IndicadorTile ikey={key} ind={ind} slug={meta.slug} />)}
      </div>
    </section>

    {filasContexto.length > 0 && (
      <section class="cg-section">
        <div class="cg-section-head">
          <p class="cg-eyebrow">Contexto</p>
          <h2 class="cg-h2">No integran el índice</h2>
          <p class="cg-h2-sub">Datos de seguimiento que ayudan a leer el cinturón pero <strong>no construyen la tensión</strong> del {indice?.sigla ?? "índice"}: quedan fuera del cálculo para que el indicador sea transparente.</p>
        </div>
        <div class="cg-tile-grid">
          {filasContexto.map(({ key, ind }) => <IndicadorTile ikey={key} ind={ind} slug={meta.slug} />)}
        </div>
      </section>
    )}

    {rob && robSvg && indice && (
      <section class="cg-section">
        <div class="cg-section-head">
          <p class="cg-eyebrow">Robustez</p>
          <h2 class="cg-h2">¿Cuánto depende el {indice.sigla} de la ponderación elegida?</h2>
          <p class="cg-h2-sub">
            Análisis de sensibilidad (Monte Carlo): el índice se recalcula en{" "}
            {rob.n_draws.toLocaleString("es-AR")} escenarios perturbando{" "}
            {indice.base100 ? "los pesos ±20%" : "los pesos ±20% y los valores de entrada ±5%"}.
            La curva es la distribución de resultados; la franja sombreada, donde cae el 90% de los casos.
          </p>
        </div>
        <div class={`cg-rob cg-rob--${meta.slug}`} data-det="rob" role="button" tabindex="0"
             aria-label="Ver el detalle del análisis de robustez">
          <div class="cg-rob-head">
            <span>Distribución simulada del {indice.sigla}</span>
            <span>90% de los casos: <strong>{coma(rob.p05)} – {coma(rob.p95)}</strong></span>
          </div>
          <svg class="cg-rob-svg" viewBox={`0 0 ${robSvg.W} ${robSvg.H}`} role="img"
               aria-label={`Distribución simulada del ${indice.sigla}: entre ${coma(rob.p05)} y ${coma(rob.p95)} en el 90% de los escenarios`}>
            <defs>
              <clipPath id="rob-clip">
                <rect x={robSvg.x05} y="0" width={robSvg.x95 - robSvg.x05} height={robSvg.H} />
              </clipPath>
            </defs>
            <path d={robSvg.area} fill="var(--rob-c)" fill-opacity="0.10" />
            <path d={robSvg.area} fill="var(--rob-c)" fill-opacity="0.32" clip-path="url(#rob-clip)" />
            <path d={robSvg.line} fill="none" stroke="var(--rob-c)" stroke-width="2" stroke-linejoin="round" />
            {robSvg.x100 !== null && (
              <line x1={robSvg.x100} x2={robSvg.x100} y1="4" y2={robSvg.base}
                    stroke="var(--muted)" stroke-width="1.5" stroke-dasharray="4 3" opacity="0.65" />
            )}
            <line x1={robSvg.xval} x2={robSvg.xval} y1="8" y2={robSvg.base}
                  stroke="var(--dark)" stroke-width="1.8" />
            <circle cx={robSvg.xval} cy="8" r="3.4" fill="var(--dark)" />
            <line x1="0" x2={robSvg.W} y1={robSvg.base} y2={robSvg.base}
                  stroke="var(--bd)" stroke-width="1" />
          </svg>
          <div class="cg-rob-ticks">
            <span class="cg-rob-tick" style={`left:${robSvg.pct(robSvg.x05)}%`}>{coma(rob.p05)}</span>
            <span class="cg-rob-tick cg-rob-tick--val" style={`left:${robSvg.pct(robSvg.xval)}%`}>{coma(indice.data.valor)}</span>
            <span class="cg-rob-tick" style={`left:${robSvg.pct(robSvg.x95)}%`}>{coma(rob.p95)}</span>
            {robSvg.x100 !== null && (
              <span class="cg-rob-tick cg-rob-tick--ext" style={`left:${robSvg.pct(robSvg.x100)}%`}>100 = 4T-23</span>
            )}
          </div>
          <p class="cg-h2-sub">
            El {indice.sigla} queda entre <strong>{coma(rob.p05)}</strong> y{" "}
            <strong>{coma(rob.p95)}</strong> en el 90% de los casos (tensión{" "}
            {coma(rob.tension_rango[0])}–{coma(rob.tension_rango[1])}): la lectura del
            cinturón no depende de la ponderación exacta ni del error de medición de las fuentes.
            {robBajoBase && (
              <Fragment>
                {" "}Incluso el escenario más favorable queda <strong>debajo de la línea
                de base</strong> (100 = promedio 4T-2023).
              </Fragment>
            )}
          </p>
          <div class="cg-det-cta">Ver el detalle →</div>
        </div>
        {val && valSvg && (
          <Fragment>
            <div class="cg-section-head cg-val-head">
              <p class="cg-eyebrow">Validación externa</p>
              <h2 class="cg-h2">{val.titulo}</h2>
              <p class="cg-h2-sub">{val.sub}</p>
            </div>
            <div class={`cg-rob cg-rob--${meta.slug} cg-val`} data-det="val" role="button" tabindex="0"
                 aria-label="Ver el detalle de la validación externa">
              <div class="cg-rob-head">
                <span>El {indice.sigla} y su contraste externo, mes a mes</span>
                <span>correlación <strong>{coma(val.r_niveles)}</strong> · {val.n} meses</span>
              </div>
              <svg class="cg-rob-svg" viewBox={`0 0 ${valSvg.W} ${valSvg.H}`} role="img"
                   aria-label={`Evolución comparada: ${val.serie_label} y ${val.externa_label}`}>
                {valSvg.y100 !== null && (
                  <line x1="0" x2={valSvg.W} y1={valSvg.y100} y2={valSvg.y100}
                        stroke="var(--muted)" stroke-width="1" stroke-dasharray="4 3" opacity="0.45" />
                )}
                {valSvg.ticks.map(t => (
                  <Fragment>
                    <line x1={t.x} x2={t.x} y1={valSvg.top} y2={valSvg.base}
                          stroke="var(--bd)" stroke-width="1" opacity="0.6" />
                    <text x={t.x + 6} y={valSvg.base + 16} fill="var(--muted)"
                          font-size="11" font-family="inherit">{t.label}</text>
                  </Fragment>
                ))}
                <path d={valSvg.lineaExterna} fill="none" stroke="#64748B"
                      stroke-width="1.8" stroke-linejoin="round" opacity="0.85" />
                <path d={valSvg.lineaIndice} fill="none" stroke="var(--rob-c)"
                      stroke-width="2.4" stroke-linejoin="round" />
                <line x1="0" x2={valSvg.W} y1={valSvg.base} y2={valSvg.base}
                      stroke="var(--bd)" stroke-width="1" />
              </svg>
              <p class="cg-val-leyenda">
                <span class="cg-val-chip cg-val-chip--indice">{val.serie_label}</span>
                <span class="cg-val-chip cg-val-chip--externa">{val.externa_label}</span>
                <span class="cg-val-chip-nota">{val.trans_label}</span>
              </p>
              <p class="cg-h2-sub">{val.conclusion}</p>
              <div class="cg-det-cta">Ver el detalle →</div>
            </div>
          </Fragment>
        )}
        {cruz && (
          <Fragment>
            <div class="cg-section-head cg-val-head">
              <p class="cg-eyebrow">Validación cruzada</p>
              <h2 class="cg-h2">{cruz.titulo}</h2>
              <p class="cg-h2-sub">{cruz.sub}</p>
            </div>
            <div class={`cg-rob cg-rob--${meta.slug} cg-cruz`} data-det="cruz" role="button" tabindex="0"
                 aria-label="Ver el detalle de la validación cruzada">
              <table class="cg-cruz-tabla">
                <thead>
                  <tr>
                    <th></th>
                    {cruz.externas.map(e => (
                      <th>
                        <span class="cg-cruz-lbl-lg">{e[1]}</span>
                        <span class="cg-cruz-lbl-sm">{CRUZ_CORTAS[e[0]] ?? e[1]}</span>
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {cruz.filas.map(f => (
                    <tr class:list={[f.indice === indice.sigla && "es-actual"]}>
                      <th>{f.indice}{f.indice === indice.sigla && <span class="cg-cruz-este"> (este cinturón)</span>}</th>
                      {cruz.externas.map(e => (
                        // sin espacios entre el número y el span: el salto de línea
                        // quedaba como espacio final y descentraba el número ~6px
                        <td class:list={[f.propio === e[0] && "es-propio"]}>{(f[e[0]].r > 0 ? "+" : "") + coma(f[e[0]].r)}<span class="cg-cruz-n">{f[e[0]].n} meses</span></td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
              <p class="cg-cruz-nota">
                Las celdas sombreadas marcan el contraste natural de cada índice. Correlaciones
                sobre las reconstrucciones mensuales, sin ajustes del analista, desde dic-2023.
              </p>
              <p class="cg-h2-sub">{cruz.conclusion}</p>
              <div class="cg-det-cta">Ver el detalle →</div>
            </div>
          </Fragment>
        )}
      </section>
    )}

    <section class="cg-section cg-sources" id="fuentes">
      <p class="cg-eyebrow">Fuentes</p>
      <ul>{fuentes.map(f => <li>{f}</li>)}</ul>
    </section>

    {meta.key === "vida_cotidiana" && (
      <section class="cg-section cg-nota-met">
        <p class="cg-eyebrow">Nota metodológica</p>
        <p>
          El cinturón se puntúa con el <strong>ITVC-B100</strong>, un índice de{" "}
          <strong>seguimiento de gestión</strong>: cada componente se rebasea a 100 en el{" "}
          <strong>promedio del 4º trimestre de 2023</strong> (no diciembre puntual, para
          amortiguar la distorsión de la devaluación) y el índice acumula la mejora o el
          deterioro desde el arranque del mandato. Alimentos y tarifas se miden por su{" "}
          <strong>nivel relativo a los salarios</strong> (¿suben más o menos que los
          ingresos?), la actividad industrial y la construcción por su{" "}
          <strong>nivel desestacionalizado</strong> (no la variación de un mes), y el
          endeudamiento se corrige por la <strong>tasa de mora</strong> de la cartera de
          consumo — más deuda con mora estable es acceso al crédito; con mora disparada, es
          sobreendeudamiento. Excepciones declaradas: informalidad con base anual 2023 (la
          serie trimestral pública murió en 2020) y delitos con base anual SNIC 2023. El{" "}
          <strong>score {c.score}/10</strong> deriva del <strong>ITVC {c.itvc?.valor}</strong>:
          tensión = 5 − (ITVC − 100) × 0,2.
        </p>
      </section>
    )}

    {meta.key === "gestion" && (
      <section class="cg-section cg-nota-met">
        <p class="cg-eyebrow">Nota metodológica</p>
        <p>
          El cinturón mide la <strong>brecha entre lo prometido y lo ejecutado</strong> de la
          agenda de reformas, en cinco dimensiones (paramétrica CIGOB, jul-2026; puntaje{" "}
          <strong>interpolado</strong> entre los umbrales institucionales — sin escalones de
          banda). La <strong>apertura comercial</strong> se puntúa por la{" "}
          <strong>alícuota efectiva</strong> del comercio exterior (recaudación de derechos de
          importación y exportación sobre el intercambio total); la brecha cambiaria puntúa una
          sola vez, en su propio indicador, y el componente aduanero (canal verde) no tiene
          fuente pública estructurada y queda fuera. Las <strong>privatizaciones</strong> avanzan
          por <strong>etapas verificables</strong> (0 = sin definir → 4 = operación cerrada) sobre
          la cartera habilitada por la Ley Bases, no por conteo de anuncios. La{" "}
          <strong>reforma laboral</strong> sigue el <strong>Fondo de Cese</strong> (el propio
          decreto 847/2024 lo presenta como la herramienta central contra la litigiosidad). La{" "}
          <strong>asistencia directa</strong> mide la desintermediación del gasto social (TDPS) y
          el <strong>orden público</strong>, la reducción de cortes en CABA vs. 2023 — con la
          advertencia de que el protocolo está judicialmente cuestionado (anulado en dic-2025, en
          apelación). El <strong>score {c.score}/10</strong> y el{" "}
          <strong>ITCG {c.itcg?.valor}/100</strong> son la misma medición en dos escalas:
          tensión = (100 − ITCG) / 10.
        </p>
      </section>
    )}

    {meta.key === "macro" && (
      <section class="cg-section cg-nota-met">
        <p class="cg-eyebrow">Nota metodológica</p>
        <p>
          La <strong>recaudación tributaria</strong> se puntúa por su variación{" "}
          <strong>interanual real</strong> (deflactada por el IPC del mismo período), para
          aislar la recuperación genuina del efecto inflacionario. Las <strong>reservas</strong>{" "}
          se miden <strong>netas de libre disponibilidad</strong> (el número del mercado): el
          neto estricto de la planilla SDDS del BCRA más los depósitos del Tesoro y el Bopreal a
          12 meses, que no son pasivos del BCRA para defender el tipo de cambio. La dimensión de
          financiamiento usa el <strong>Índice de Capacidad Prestable</strong> (precio, volumen
          y asignación del crédito), no la tasa nominal. La estabilidad monetaria incorpora el{" "}
          <strong>Índice de Desequilibrio Monetario</strong> (brecha interanual real entre la
          oferta amplia de pesos —M3 privado— y la demanda transaccional —M2 privado—), y una
          quinta dimensión de <strong>competitividad externa</strong> puntúa el{" "}
          <strong>tipo de cambio real multilateral</strong>: la apreciación se lee como tensión.
          La sexta dimensión, <strong>inversión</strong>, combina el{" "}
          <strong>IAI</strong> (inversión física: construcción y bienes de capital) y el{" "}
          <strong>ICIP</strong> (capitalización digital: servicios tech y productividad);
          sus umbrales se calibraron a la volatilidad real de las series, no al ±2% teórico.
          Cada indicador se puntúa por <strong>interpolación entre las anclas</strong> de su
          tabla de umbrales (sin escalones de banda: dos valores casi iguales reciben
          puntajes casi iguales). El <strong>score {c.score}/10</strong> y
          el <strong>ITCM {c.itcm?.valor}/100</strong> son la misma medición en dos escalas:
          tensión = (100 − ITCM) / 10; la escala 0–10 permite comparar macro con los otros
          cuatro cinturones y componer el score global.
        </p>
      </section>
    )}
  </main>
  <Footer />
  <IndicadorModal />

  {indice && (
    <div class="cg-modal" id="cg-det-modal" hidden>
      <div class="cg-modal-card cg-det-card">
        <button class="cg-modal-close" id="cg-det-close" aria-label="Cerrar">×</button>
        <div id="cg-det-body"></div>
      </div>
    </div>
  )}

  {rob && indice && (
    <template id="cg-det-rob">
      <p class="cg-eyebrow">Robustez · {indice.sigla}</p>
      <h3 class="cg-modal-title">¿Cuánto puede moverse el índice sin que cambie la historia?</h3>
      <p class="cg-modal-desc">
        Ningún índice compuesto es inocente: depende de qué pesos se eligieron y de la
        precisión de las fuentes. Este ejercicio mide cuánto importa eso acá: el{" "}
        {indice.sigla} se recalcula <strong>{rob.n_draws.toLocaleString("es-AR")} veces</strong>,
        perturbando al azar en cada corrida los pesos de dimensiones e indicadores
        (hasta ±20% de su valor) y las mediciones de entrada (hasta ±5% del ancho entre
        sus umbrales de puntuación, para que el ruido sea proporcional a lo que de verdad
        puede mover un puntaje). El azar usa una semilla fija: el ejercicio es reproducible.
      </p>
      <dl class="cg-modal-ficha">
        <div><dt>Valor publicado</dt><dd>{coma(indice.data.valor)}</dd></div>
        <div><dt>90% de los casos</dt><dd>{coma(rob.p05)} – {coma(rob.p95)}</dd></div>
        <div><dt>Amplitud</dt><dd>{coma(robAmplitud!)} puntos</dd></div>
        <div><dt>En tensión (0-10)</dt><dd>{coma(rob.tension_rango[0])} – {coma(rob.tension_rango[1])}</dd></div>
      </dl>
      <p class="cg-modal-h4">La distribución de los {rob.n_draws.toLocaleString("es-AR")} escenarios</p>
      <div id="cg-det-rob-chart" data-sigla={indice.sigla}></div>
      <p class="cg-formula-leyenda">
        Pasá el cursor (o el dedo) por la campana: cada punto dice cuántos escenarios
        simulados dieron ese valor del índice.
      </p>
      {domLabel && (
        <Fragment>
          <p class="cg-modal-h4">El componente que más pesa hoy</p>
          <p class="cg-modal-desc">
            <strong>{domLabel}</strong> es el indicador que más arrastra el resultado: si se
            lo quitara del índice (repartiendo su peso entre los demás), el {indice.sigla}{" "}
            sería <strong>{coma(rob.dominante.indice_sin)}</strong> —{" "}
            {domDelta! > 0 ? "una mejora" : "un deterioro"} de {coma(Math.abs(domDelta!))} puntos.
            Que un solo componente explique una diferencia así no invalida el índice, pero es
            la señal a vigilar: su dato manda sobre la lectura del mes.
          </p>
        </Fragment>
      )}
      <p class="cg-modal-h4">Cómo leerlo</p>
      <p class="cg-modal-desc">
        La franja sombreada del gráfico concentra el 90% de los escenarios simulados. Si esa
        franja no cruza un umbral de lectura, la historia que cuenta el cinturón no depende
        de la cocina del índice.{robBajoBase ? " En este caso, incluso el escenario más favorable queda debajo de la línea de base (100 = promedio del 4º trimestre de 2023): el signo del resultado no es discutible por ponderación." : " Hoy la lectura es estable en todo el rango simulado."}
      </p>
    </template>
  )}

  {val && indice && (
    <template id="cg-det-val">
      <p class="cg-eyebrow">Validación externa · {indice.sigla}</p>
      <h3 class="cg-modal-title">{val.titulo}</h3>
      <p class="cg-modal-desc">
        El {indice.sigla} se reconstruye hacia atrás, mes a mes, con las mismas reglas de
        cálculo y <strong>sin ajustes del analista</strong>, y se compara contra{" "}
        <strong>{val.externa_label}</strong>: una medición externa e independiente que no
        alimenta al índice. Si el índice midiera algo real, ambas series deberían moverse
        juntas — sin ser idénticas.
      </p>
      <dl class="cg-modal-ficha">
        <div><dt>Correlación (niveles)</dt><dd>{coma(val.r_niveles)}</dd></div>
        <div><dt>Cambios mes a mes</dt><dd>{coma(val.r_diferencias)}</dd></div>
        <div><dt>Muestra</dt><dd>{val.n} meses</dd></div>
      </dl>
      <p class="cg-modal-h4">Las dos series, en sus valores reales</p>
      <div id="cg-det-val-chart"></div>
      <p class="cg-formula-leyenda">
        Cada escala en su eje: el índice a la izquierda, el contraste externo a la derecha.
        {val.plot === "minmax_inv" && " El eje del contraste está invertido (baja = mejora), igual que en la tarjeta, para que el co-movimiento se lea derecho; el valor del tooltip es el real."}{" "}
        Pasá el cursor (o el dedo) por las curvas para ver el valor de cada mes.
      </p>
      <p class="cg-modal-h4">Por qué dos correlaciones</p>
      <p class="cg-modal-desc">
        La correlación de <strong>niveles</strong> compara las trayectorias completas: en un
        período dominado por una gran tendencia, tiende a dar alta "gratis". La de{" "}
        <strong>cambios mes a mes</strong> es la prueba exigente — pregunta si las dos series
        aceleran y frenan al mismo ritmo, no solo si van para el mismo lado.
      </p>
      <p class="cg-modal-h4">Lectura</p>
      <p class="cg-modal-desc">{val.conclusion}</p>
      <p class="cg-formula-leyenda">{val.trans_label}.</p>
    </template>
  )}

  {cruz && indice && (
    <template id="cg-det-cruz">
      <p class="cg-eyebrow">Validación cruzada</p>
      <h3 class="cg-modal-title">{cruz.titulo}</h3>
      <p class="cg-modal-desc">
        Los tres índices del informe se reconstruyen mes a mes y se comparan contra los tres
        contrastes externos <strong>a la vez</strong>. La pregunta: ¿cada índice se parece más
        a su contraste natural que a los ajenos, o todos miden lo mismo con distinto nombre?
      </p>
      <div id="cg-det-cruz-tabla"></div>
      <p class="cg-modal-h4">Cómo leer la matriz</p>
      <p class="cg-modal-desc">
        Cada fila es un índice; cada columna, una vara externa. Las celdas sombreadas marcan
        el par natural: la macroeconomía con el precio del riesgo argentino, la gestión con el
        valor de las empresas, la vida cotidiana con el ánimo del consumidor. Una fila cuyo
        par natural es el más fuerte de su fila está midiendo algo propio.
      </p>
      <p class="cg-modal-h4">Los límites, declarados</p>
      <p class="cg-modal-desc">
        La muestra es corta (~30 meses) y cubre un período donde toda la economía se movió
        junta: eso infla todas las correlaciones de niveles y hace que las celdas cruzadas
        sean del mismo orden que las propias. Algunos cruces además tienen lectura económica
        genuina — la prima de riesgo soberana también pricea la gestión. Por eso la matriz
        se publica como un contraste de convergencia, no como una prueba de separación
        perfecta.
      </p>
      <p class="cg-modal-h4">Lectura</p>
      <p class="cg-modal-desc">{cruz.conclusion}</p>
      <p class="cg-formula-leyenda">
        Correlaciones sobre las reconstrucciones mensuales, sin ajustes del analista, desde
        diciembre de 2023.
      </p>
    </template>
  )}

  {valChartData && (
    <script type="application/json" id="cg-det-val-data" set:html={JSON.stringify(valChartData)} />
  )}
  {robChartData && (
    <script type="application/json" id="cg-det-rob-data" set:html={JSON.stringify(robChartData)} />
  )}
  <script>
    const modal = document.getElementById("cg-det-modal");
    if (modal) {
      const body = document.getElementById("cg-det-body")!;
      let chart: any = null;
      const abrir = async (key: string) => {
        const tpl = document.getElementById("cg-det-" + key) as HTMLTemplateElement | null;
        if (!tpl) return;
        body.innerHTML = "";
        body.appendChild(tpl.content.cloneNode(true));
        if (key === "cruz") {
          const dest = body.querySelector("#cg-det-cruz-tabla");
          const tabla = document.querySelector(".cg-cruz .cg-cruz-tabla");
          if (dest && tabla) dest.appendChild(tabla.cloneNode(true));
        }
        modal.removeAttribute("hidden");
        document.body.style.overflow = "hidden";
        if (key === "val") {
          const dataEl = document.getElementById("cg-det-val-data");
          const dest = body.querySelector("#cg-det-val-chart") as HTMLElement | null;
          if (dataEl && dest) {
            const d = JSON.parse(dataEl.textContent!);
            const { dualTimeChart, colorDe } = await import("../lib/charts.ts");
            const aPuntos = d.pares.map((p: any) => ({ fecha: p[0] + "-01", valor: p[1] }));
            const bPuntos = d.pares.map((p: any) => ({ fecha: p[0] + "-01", valor: p[2] }));
            chart = dualTimeChart(dest,
              { ...d.indice, puntos: aPuntos }, { ...d.externa, puntos: bPuntos },
              { color: colorDe(d.slug), ejeBInvertido: !!d.ejeBInvertido });
          }
        }
        if (key === "rob") {
          const dataEl = document.getElementById("cg-det-rob-data");
          const dest = body.querySelector("#cg-det-rob-chart") as HTMLElement | null;
          if (dataEl && dest) {
            const d = JSON.parse(dataEl.textContent!);
            const { distChart, colorDe } = await import("../lib/charts.ts");
            chart = distChart(dest, d, { color: colorDe(d.slug) });
          }
        }
      };
      const cerrar = () => {
        modal.setAttribute("hidden", "");
        document.body.style.overflow = "";
        if (chart) { chart.destroy(); chart = null; }
      };
      for (const el of document.querySelectorAll<HTMLElement>("[data-det]")) {
        el.addEventListener("click", () => abrir(el.dataset.det!));
        el.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") { e.preventDefault(); abrir(el.dataset.det!); }
        });
      }
      document.getElementById("cg-det-close")!.addEventListener("click", (e) => { e.stopPropagation(); cerrar(); });
      modal.addEventListener("click", (e) => { if (e.target === modal) cerrar(); });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !modal.hasAttribute("hidden")) cerrar(); });
    }
  </script>
</Layout>
