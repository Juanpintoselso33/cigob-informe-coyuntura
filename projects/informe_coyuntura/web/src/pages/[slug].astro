---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import IndicadorTile from "../components/IndicadorTile.astro";
import IndicadorModal from "../components/IndicadorModal.astro";
import {
  informe, CINTURONES, verdictDeCinturon, indicadoresOrdenados,
  fuentesDeCinturon, cap, indiceDe,
} from "../lib/datos.ts";

export function getStaticPaths() {
  return CINTURONES.map(c => ({ params: { slug: c.slug }, props: { meta: c } }));
}

const { meta } = Astro.props;
const c = informe.cinturones[meta.key];
const verdict = verdictDeCinturon(c.estado);
const verdictLabel = { verde: "Estable", amarillo: "En tensión", rojo: "Crítico" }[verdict];
const filas = indicadoresOrdenados(c);
// Los indicadores de contexto (en_indice === false) no construyen la tensión:
// se muestran en un bloque aparte para no confundirlos con los del índice.
const filasIndice = filas.filter(({ ind }) => ind.en_indice !== false);
const filasContexto = filas.filter(({ ind }) => ind.en_indice === false);
const fuentes = fuentesDeCinturon(c);
const indice = indiceDe(c);   // ITCM (macro) / ITCG (gestión) o null
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<Layout title={`${meta.nombre} · Informe de Coyuntura · CiGob`}>
  <Nav />
  <header class={`cg-hero cg-detalle-hero cg-detalle-hero--${meta.slug}`} id="top">
    <div class="cg-hero-inner cg-detalle-inner">
      <p class="cg-eyebrow"><a href={`${base}/`}>← Resumen</a> · Cinturón</p>
      <h1 class="cg-hero-title cg-detalle-title">{meta.nombre}</h1>
      <p class="cg-hero-lead cg-detalle-lead">{meta.sub}.</p>
      <div class="cg-detalle-meta">
        <span class:list={["cg-verdict", verdict]}><span class="cg-verdict-dot"></span>{verdictLabel}</span>
        <span class="cg-detalle-chip">Score <strong>{c.score}/10</strong></span>
        {indice && <span class="cg-detalle-chip">{indice.sigla} <strong>{indice.data.valor}/100</strong> · {indice.data.banda_legible}</span>}
        <span class="cg-detalle-chip">Riesgo: <strong>{cap(c.barbarismo_riesgo)}</strong></span>
        <span class="cg-detalle-chip">{filas.length} indicadores</span>
      </div>
    </div>
  </header>
  <main class="cg-main">
    {indice && (
      <section class="cg-section">
        <div class="cg-section-head">
          <p class="cg-eyebrow">Índice paramétrico</p>
          <h2 class="cg-h2">{indice.sigla}: {indice.data.valor}/100 — {indice.data.banda_legible}</h2>
          <p class="cg-h2-sub">{indice.descripcion}</p>
        </div>
        <div class="cg-itcm-dims">
          {Object.entries(indice.data.dimensiones).map(([dkey, dim]) => (
            <div class="cg-itcm-dim">
              <div class="cg-itcm-dim-head">
                <span class="cg-itcm-dim-name">{dim.nombre}</span>
                <span class="cg-itcm-dim-val"><strong>{dim.puntaje}</strong>/100 · pesa {Math.round(dim.peso * 100)}%</span>
              </div>
              <div class="cg-bar" role="img" aria-label={`${dim.puntaje} de 100`}>
                <div class="cg-bar-fill" style={`width:${dim.puntaje}%`}></div>
              </div>
            </div>
          ))}
        </div>
        {indice.data.ajustes_aplicados.length > 0 && (
          <p class="cg-h2-sub" style="margin-top:12px;">
            <strong>Ajustes del analista:</strong>{" "}
            {indice.data.ajustes_aplicados.map(a => `${a.indicador}: ${a.de} → ${a.a} (${a.justificacion})`).join(" · ")}
          </p>
        )}
      </section>
    )}
    <section class="cg-section">
      <div class="cg-section-head">
        <p class="cg-eyebrow">Indicadores</p>
        <h2 class="cg-h2">El detalle, hoy</h2>
        <p class="cg-h2-sub">
          {indice
            ? "Los que construyen el índice de tensión. Tocá cualquiera para ver qué mide, qué aporta y su evolución. Automatizados primero; carga manual y estimaciones al final."
            : "Tocá cualquier indicador para ver qué mide, qué aporta y su evolución. Automatizados primero; carga manual y estimaciones al final."}
        </p>
      </div>
      <div class="cg-tile-grid">
        {filasIndice.map(({ key, ind }) => <IndicadorTile ikey={key} ind={ind} slug={meta.slug} />)}
      </div>
    </section>

    {filasContexto.length > 0 && (
      <section class="cg-section">
        <div class="cg-section-head">
          <p class="cg-eyebrow">Contexto</p>
          <h2 class="cg-h2">No integran el índice</h2>
          <p class="cg-h2-sub">Datos de seguimiento que ayudan a leer el cinturón pero <strong>no construyen la tensión</strong> del {indice?.sigla ?? "índice"}: quedan fuera del cálculo para que el indicador sea transparente.</p>
        </div>
        <div class="cg-tile-grid">
          {filasContexto.map(({ key, ind }) => <IndicadorTile ikey={key} ind={ind} slug={meta.slug} />)}
        </div>
      </section>
    )}

    <section class="cg-section cg-sources" id="fuentes">
      <p class="cg-eyebrow">Fuentes</p>
      <ul>{fuentes.map(f => <li>{f}</li>)}</ul>
    </section>

    {meta.key === "gestion" && (
      <section class="cg-section cg-nota-met">
        <p class="cg-eyebrow">Nota metodológica</p>
        <p>
          El cinturón mide la <strong>brecha entre lo prometido y lo ejecutado</strong> de la
          agenda de reformas, en cinco dimensiones (paramétrica CIGOB, jul-2026). La{" "}
          <strong>apertura comercial</strong> se puntúa con el <strong>ILCE</strong> (Índice de
          Libertad Comercial Efectiva): brecha cambiaria inversa más la <strong>alícuota
          efectiva</strong> del comercio exterior (recaudación de derechos de importación y
          exportación sobre el intercambio total); el componente aduanero (canal verde) no tiene
          fuente pública estructurada y queda fuera. Las <strong>privatizaciones</strong> avanzan
          por <strong>etapas verificables</strong> (0 = sin definir → 4 = operación cerrada) sobre
          la cartera habilitada por la Ley Bases, no por conteo de anuncios. La{" "}
          <strong>reforma laboral</strong> sigue el <strong>Fondo de Cese</strong> (el propio
          decreto 847/2024 lo presenta como la herramienta central contra la litigiosidad). La{" "}
          <strong>asistencia directa</strong> mide la desintermediación del gasto social (TDPS) y
          el <strong>orden público</strong>, la reducción de cortes en CABA vs. 2023 — con la
          advertencia de que el protocolo está judicialmente cuestionado (anulado en dic-2025, en
          apelación). El <strong>score {c.score}/10</strong> y el{" "}
          <strong>ITCG {c.itcg?.valor}/100</strong> son la misma medición en dos escalas:
          tensión = (100 − ITCG) / 10.
        </p>
      </section>
    )}

    {meta.key === "macro" && (
      <section class="cg-section cg-nota-met">
        <p class="cg-eyebrow">Nota metodológica</p>
        <p>
          La <strong>recaudación tributaria</strong> se puntúa por su variación{" "}
          <strong>interanual real</strong> (deflactada por el IPC del mismo período), para
          aislar la recuperación genuina del efecto inflacionario. Las <strong>reservas</strong>{" "}
          se miden <strong>netas de libre disponibilidad</strong> (el número del mercado): el
          neto estricto de la planilla SDDS del BCRA más los depósitos del Tesoro y el Bopreal a
          12 meses, que no son pasivos del BCRA para defender el tipo de cambio. La dimensión de
          financiamiento usa el <strong>Índice de Capacidad Prestable</strong> (precio, volumen
          y asignación del crédito), no la tasa nominal. La estabilidad monetaria incorpora el{" "}
          <strong>Índice de Desequilibrio Monetario</strong> (brecha interanual real entre la
          oferta amplia de pesos —M3 privado— y la demanda transaccional —M2 privado—), y una
          quinta dimensión de <strong>competitividad externa</strong> puntúa el{" "}
          <strong>tipo de cambio real multilateral</strong>: la apreciación se lee como tensión.
          La sexta dimensión, <strong>inversión</strong>, combina el{" "}
          <strong>IAI</strong> (inversión física: construcción y bienes de capital) y el{" "}
          <strong>ICIP</strong> (capitalización digital: servicios tech y productividad);
          sus umbrales se calibraron a la volatilidad real de las series, no al ±2% teórico.
          El <strong>score {c.score}/10</strong> y
          el <strong>ITCM {c.itcm?.valor}/100</strong> son la misma medición en dos escalas:
          tensión = (100 − ITCM) / 10; la escala 0–10 permite comparar macro con los otros
          cuatro cinturones y componer el score global.
        </p>
      </section>
    )}
  </main>
  <Footer />
  <IndicadorModal />
</Layout>
