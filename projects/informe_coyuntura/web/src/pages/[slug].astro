---
import Layout from "../layouts/Layout.astro";
import NivelTension from "../components/NivelTension.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import IndicadorTile from "../components/IndicadorTile.astro";
import IndicadorModal from "../components/IndicadorModal.astro";
import SemaforoLeyenda from "../components/SemaforoLeyenda.astro";
import {
  informe, CINTURONES, indicadoresOrdenados, tensionDeDimension,
  fuentesDeCinturon, cap, indiceDe, label, num, semaforoDe, semaforoAriaLabel, coloresEnIndice,
  tramosSemaforo, LECTURA_SEMAFORO,
} from "../lib/datos.ts";

export function getStaticPaths() {
  return CINTURONES.map(c => ({ params: { slug: c.slug }, props: { meta: c } }));
}

const { meta } = Astro.props;
const c = informe.cinturones[meta.key];
// Pedido editorial del 8-oct-2026, sólo para el cinturón macro: cabecera sin
// banda ni riesgo, barra sin la palabra del tramo y con un texto propio debajo,
// subtítulos a todo el ancho y sin la validación cruzada.
const esMacro = meta.key === "macro";
const PIE_MACRO = "El cinturón macro encuentra sus puntos de tensión en las dimensiones que expresan el nivel de la actividad económica y de la inversión. Para cada una de dichas dimensiones puede profundizarse su análisis recorriendo los indicadores que las sustentan.";
// La cabecera del cinturón se lee por la barra, igual que en la portada: una
// sola vara de color en todo el sitio (los cortes publicados). El `estado` de
// tres valores no se pierde —sigue mandando en la regla sistémica— pero no se
// expresa en color, porque sobre la misma tensión 0-10 parte distinto que el
// semáforo y los dos veredictos se contradecían a la vista.
//
// Se muestra como TEXTO junto a la barra. La primera versión lo borró de la
// página entera y eso fue quitar información: `estado` es el concepto que
// dispara "1 tensionado es manejable, 2 o más no", y el lector no tenía cómo
// saber de qué lado caía este cinturón.
// Acá hubo un chip que decía "Cuenta para la alerta sistémica: Sí/No" a partir
// de `estado`, y era FALSO. Sobre la misma tensión 0-10 hay tres particiones
// distintas y ninguna coincide con las otras:
//
//   semáforo (color)      verde ≤4 · amarillo ≤6 · naranja ≤8 · rojo >8
//   estado                estable ≤3 · en_tension ≤6 · tensionado >6
//   alerta multicinturón  cuenta sólo los de score >= 7
//
// Entre 6 y 7 hay una zona muerta: un cinturón es "tensionado" y NO cuenta para
// la alerta. Con este snapshot le pasa a impacto social, en 6,9. El chip
// afirmaba que sí contaba.
//
// No se puede arreglar desde el front sin escribir el umbral 7 a mano, que es
// justo lo que este rediseño no hace, así que la afirmación se retira: la
// magnitud la da la barra y la regla sistémica vive en el panel de la portada,
// donde se explica. Queda reportado como decisión de metodología (ADR-0194).
const filas = indicadoresOrdenados(c);
// Los indicadores de contexto (en_indice === false) no construyen la tensión:
// se muestran en un bloque aparte para no confundirlos con los del índice.
const filasIndice = filas.filter(({ ind }) => ind.en_indice !== false);
// Dentro de los que no puntúan hay TRES estados distintos y conviene no
// mezclarlos: los de CONTEXTO no miden la dimensión de su índice; los
// CUMPLIDOS sí la miden y salieron del cálculo por haber llegado a su máximo
// y quedarse ahí; los SUSPENDIDOS (ADR-0186) también la miden pero salieron
// por decisión editorial —dudas sobre la fuente, no un techo alcanzado—, así
// que decirles "logrado" sería tan falso como decirles "contexto".
const filasCumplidas = filas.filter(({ ind }) => ind.en_indice === false && ind.cumplido);
const filasSuspendidas = filas.filter(({ ind }) => ind.en_indice === false && ind.suspendido);
const filasSinUniverso = filas.filter(({ ind }) => ind.en_indice === false && ind.estado === "sin_universo");
const filasContexto = filas.filter(({ ind }) => ind.en_indice === false && !ind.cumplido && !ind.suspendido && ind.estado !== "sin_universo");
const fuentes = fuentesDeCinturon(c);
// Textos en llano de «Cómo se calcula este número» (ADR-0352).
const RESUMEN_INDICE: Record<string, string> = {
  macro: "qué tan firme está la economía: la inflación, las cuentas públicas, el financiamiento, la actividad, la competitividad y la inversión.",
  politica: "cuánto poder real tiene el Gobierno para llevar adelante su proyecto: sacar leyes, sostener alianzas con las provincias, mantener unida a su fuerza y manejar el conflicto social, la Justicia y el sector privado. Mide capacidad de gobernar, no popularidad ni intención de voto.",
  gestion: "cuánto de la agenda de reformas prometida se está ejecutando de verdad.",
};
const PARTICULAR_INDICE: Record<string, string> = {
  macro: "Las reservas del Banco Central son una estimación propia de CiGob hecha con los datos que publica el Banco; no equivalen al dato oficial de reservas de libre disponibilidad.",
  gestion: "Las reformas se siguen por pasos que se pueden comprobar, no por anuncios. Las privatizaciones, por ejemplo, van de 0 (sin definir) a 4 (operación cerrada) para cada empresa habilitada por la Ley Bases, y la apertura comercial se mide por lo que efectivamente se cobra de impuestos al comercio exterior.",
  vida_cotidiana: "Algunos indicadores no se comparan con 2023 porque ese punto de partida no era normal. Las tarifas de luz, gas, agua y transporte se miden como parte del salario, contra topes internacionales (10% del ingreso para agua y energía, 5% para transporte), porque en 2023 estaban subsidiadas. Los precios de los alimentos y del alquiler se comparan con la inflación general. El número no es un porcentaje de bienestar ni un pronóstico electoral.",
};
const indice = indiceDe(c);   // ITCM / ITCG / ITCIS / ITCP, o null (espíritu)
// Los indicadores del índice se muestran AGRUPADOS por dimensión, en el mismo
// orden en que se listan las dimensiones arriba: leer el detalle deja de ser
// una grilla plana de quince cards y pasa a seguir la estructura del índice.
// Dentro de cada grupo se conserva el orden de indicadoresOrdenados
// (automatizados primero).
const dimsDe = indice?.data.dimensiones ?? {};
const gruposDim = Object.entries(dimsDe)
  .map(([dkey, dim]) => ({
    dkey,
    nombre: dim.nombre,
    puntaje: dim.puntaje,
    peso: dim.peso,
    critica: !!dim.critica,
    semaforo: dim.semaforo,   // A4: mismo punto que las cards, en el encabezado del grupo
    // Las promesas cumplidas y las suspendidas se muestran DENTRO de su
    // dimensión aunque ya no puntúen: pertenecen ahí, y sacarlas a un bloque
    // aparte haría parecer que miden otra cosa. Van al final del grupo, con
    // su etiqueta.
    filas: [
      ...filasIndice.filter(({ key }) => key in (dim.indicadores ?? {})),
      ...filasCumplidas.filter(({ ind }) => ind.dimension === dkey),
      ...filasSuspendidas.filter(({ ind }) => ind.dimension === dkey),
    ],
  }))
  .filter(g => g.filas.length > 0);
// Red de seguridad: un indicador marcado en_indice pero que ninguna dimensión
// reclama se mostraría igual, en vez de desaparecer sin que nadie se entere.
const enAlgunGrupo = new Set(gruposDim.flatMap(g => g.filas.map(f => f.key)));
const filasSinDimension = filasIndice.filter(({ key }) => !enAlgunGrupo.has(key));
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Gráfico de robustez (ADR-0019): la DISTRIBUCIÓN de la simulación Monte
// Carlo como curva de densidad SVG (server-side, estética de sparkline):
// área suave en el color del cinturón, franja p05-p95 resaltada, línea del
// valor publicado y — para índices base-100 — la línea de referencia del 100.
const rob = indice?.data.robustez ?? null;
let robSvg: {
  W: number; H: number; base: number; area: string; line: string;
  x05: number; x95: number; xval: number; x100: number | null;
  pct: (x: number) => number;
} | null = null;
if (rob?.hist && rob.hist_max! > rob.hist_min!) {
  const W = 1120, H = 150;   // panorámico: la card ocupa el ancho completo de la sección
  const n = rob.hist.length;
  const bw = (rob.hist_max! - rob.hist_min!) / n;
  // dominio x = el rango simulado (la campana ocupa todo el ancho); la
  // referencia del 100 solo se dibuja si cae adentro — si no, lo dice el texto
  let x0 = rob.hist_min!, x1 = rob.hist_max!;
  const pad = (x1 - x0) * 0.04;
  x0 -= pad; x1 += pad;
  // suavizado con media móvil (±2 bins) para leerse como densidad
  const sm = rob.hist.map((_, i) => {
    let s = 0, c = 0;
    for (let k = -2; k <= 2; k++) {
      const j = i + k;
      if (j >= 0 && j < n) { s += rob.hist![j]; c++; }
    }
    return s / c;
  });
  const mx = Math.max(...sm);
  const X = (v: number) => ((v - x0) / (x1 - x0)) * W;
  const base = H - 16;
  const Y = (v: number) => base - (v / mx) * (base - 10);
  const pts = sm.map((v, i) =>
    `${X(rob.hist_min! + (i + 0.5) * bw).toFixed(1)},${Y(v).toFixed(1)}`);
  const linea = `M${X(rob.hist_min!).toFixed(1)},${base} L${pts.join(" L")} L${X(rob.hist_max!).toFixed(1)},${base}`;
  robSvg = {
    W, H, base, area: `${linea} Z`, line: linea,
    x05: X(rob.p05), x95: X(rob.p95), xval: X(indice!.data.valor),
    x100: indice!.base100 && 100 >= x0 && 100 <= x1 ? X(100) : null,
    pct: (x: number) => (x / W) * 100,
  };
}
// base-100 con toda la simulación debajo de la línea de base → se narra en texto
const robBajoBase = !!(rob && indice?.base100 && rob.hist_max! < 100);

// Datos extra para los modales de detalle (robustez / validación / matriz)
const domLabel = rob?.dominante ? (label(rob.dominante.indicador) ?? rob.dominante.indicador) : null;
const domDelta = rob?.dominante && indice
  ? Math.round((rob.dominante.indice_sin - indice.data.valor) * 10) / 10 : null;
// Color del cinturón en cada punta del rango del 90%: si no coinciden, la
// lectura SÍ depende de los pesos y hay que decirlo (pasó con impacto social,
// 91,7–95,4 cruza el corte de 95).
const colorDeValor = (v: number) => {
  const t = tensionDeDimension(v, !!indice?.base100);
  return tramosSemaforo().find(tr => t >= tr.desde && t < tr.hasta)?.color
    ?? tramosSemaforo().at(-1)?.color;
};
const robColores = rob ? [...new Set([colorDeValor(rob.p95), colorDeValor(rob.p05)])] : [];
const robLecturas = robColores.map(c => (c && LECTURA_SEMAFORO[c as keyof typeof LECTURA_SEMAFORO])?.toLowerCase() ?? c);
const robEstable = robColores.length === 1;
const robQueCambia = indice?.base100 ? "los pesos de cada dimensión e indicador" : "los pesos de cada dimensión e indicador y los datos de entrada";
const robAmplitud = rob ? Math.round((rob.p95 - rob.p05) * 10) / 10 : null;

// Validación externa (una por cinturón con paramétrica): co-movimiento del
// índice reconstruido mes a mes contra su contraste externo propio (ITCIS
// recalculado SIN su componente ICC, para no ser circular, contra el ICC
// UTDT; ITCM/ITCG/ITCP contra su propio par de mercado o de prensa). Ambas
// series se rebasean/normalizan al período común para dibujarlas en una
// misma escala.
const val = indice?.data.validacion ?? null;
// Matriz de validación cruzada (las tres paramétricas con contraste
// externo — ITCM/ITCIS/ITCP; el ITCG no tiene, ADR-0336): se muestra solo en esos cinturones, con la
// fila del índice propio señalada. El filtro es genérico (busca la sigla del
// cinturón actual entre las filas ya calculadas), así que un cinturón sin
// validación propia (n < 12 meses de solape) queda afuera automáticamente
// sin necesidad de una excepción explícita por nombre.
const cruzRaw = indice ? ((informe as any).validacion_cruzada ?? null) : null;
// Consistencia interna del índice: no si acierta (eso lo mide la validación
// externa) sino cuánta información distinta aporta cada componente.
const red = indice?.data.redundancia ?? null;
const rez = indice?.data.rezago ?? null;
// Punto de partida: el índice del mes del traspaso, reconstruido con el mismo
// método, para leer la distancia recorrida y no sólo el nivel de hoy.
const lb = indice?.data.linea_base ?? null;
const fam = indice?.data.familias ?? null;
const vin = indice?.data.vintages ?? null;
const cruz = !esMacro && cruzRaw?.filas?.some((f: { indice: string }) => f.indice === indice!.sigla)
  ? cruzRaw : null;
// etiquetas cortas de las anclas externas para la matriz en mobile
const CRUZ_CORTAS: Record<string, string> = {
  lider: "Actividad",
  volumen_hogar: "Volumen del hogar", epu: "Incertidumbre",
};
let valSvg: {
  W: number; H: number; base: number; top: number;
  lineaIndice: string; lineaExterna: string;
  ticks: { x: number; label: string }[]; y100: number | null;
} | null = null;
// Cuando hay factor común (ADR-0161) el gráfico muestra ESE contraste y no una
// estadística suelta: el titular de la sección informa el r contra el factor, y
// un número que no se corresponde con la curva que tiene debajo es peor que no
// publicarlo. El factor es un puntaje estandarizado —cruza el cero—, así que se
// fuerza la escala por rango; rebase100 dividiría por un valor cercano a cero.
const vplot = val?.panel?.factor?.pares_grafico
  ? { pares: val.panel.factor.pares_grafico, plot: "minmax",
      serie_label: val.panel.factor.plano === "diferencias"
        ? `${indice?.Corto ?? "Índice"} — variación mes a mes`
        : val.serie_label,
      externa_label: `Factor común: ${Object.keys(val.panel.factor.cargas)
          .map(k => val.panel.factor.etiquetas[k] ?? k).join(" · ")}`
        + (val.panel.factor.plano === "diferencias" ? " — variación mes a mes" : ""),
      trans_label: val.panel.factor.plano === "diferencias"
        ? "se grafica el cambio de cada mes contra el anterior, que es el plano donde se compara"
        : "series normalizadas al rango del período" }
  : val;
if (vplot?.pares && vplot.pares.length >= 12) {
  const W = 1120, H = 200, base = H - 26, top = 16, padx = 16;
  // Dos modos de escala (definidos por publicar según el par):
  //   rebase100    → ambas series a 100 en el primer mes (vida: escalas afines)
  //   minmax_inv   → externa INVERTIDA y ambas normalizadas al rango del
  //                  período (las dos series no comparten escala)
  let serieA: number[], serieB: number[];
  if (vplot.plot === "minmax_inv" || vplot.plot === "minmax") {
    const norm = (s: number[]) => {
      const lo = Math.min(...s), hi = Math.max(...s);
      return s.map(v => ((v - lo) / (hi - lo || 1)) * 100);
    };
    serieA = norm(vplot.pares.map(p => p[1]));
    serieB = norm(vplot.pares.map(p => (vplot.plot === "minmax_inv" ? -p[2] : p[2])));
  } else {
    const p0 = vplot.pares[0];
    serieA = vplot.pares.map(p => (p[1] / p0[1]) * 100);
    serieB = vplot.pares.map(p => (p[2] / p0[2]) * 100);
  }
  const todos = [...serieA, ...serieB];
  const y0 = Math.min(...todos) - 3, y1 = Math.max(...todos) + 3;
  const VX = (i: number) => padx + (i / (vplot.pares.length - 1)) * (W - padx * 2);
  const VY = (v: number) => base - ((v - y0) / (y1 - y0)) * (base - top);
  const trazo = (s: number[]) =>
    "M" + s.map((v, i) => `${VX(i).toFixed(1)},${VY(v).toFixed(1)}`).join(" L");
  valSvg = {
    W, H, base, top,
    lineaIndice: trazo(serieA), lineaExterna: trazo(serieB),
    ticks: vplot.pares.map((p, i) => ({ ym: p[0], i }))
      .filter(t => t.ym.endsWith("-01"))
      .map(t => ({ x: VX(t.i), label: t.ym.slice(0, 4) })),
    y100: vplot.plot === "rebase100" ? VY(100) : null,
  };
}

// Gráfico interactivo del modal de validación: series CRUDAS (la card muestra
// las normalizadas) con el valor real de cada mes en el tooltip.
const valChartData = val?.pares && indice ? {
  slug: meta.slug,
  indice: { nombre: `${indice.Corto} (reconstrucción)`, unidad: "puntos" },
  externa: {
    nombre: val.externa_label.replace(", invertido", ""),
    unidad: ({ macro: "pb", gestion: "puntos", vida_cotidiana: "puntos", politica: "puntos" } as Record<string, string>)[meta.key] ?? "",
  },
  ejeBInvertido: val.plot === "minmax_inv",   // correlación negativa: mismo sentido visual que la card
  pares: val.pares,
} : null;
// Distribución interactiva del modal de robustez
const robChartData = rob?.hist && indice ? {
  slug: meta.slug, nombre: indice.Corto,
  hist: rob.hist, hist_min: rob.hist_min, hist_max: rob.hist_max,
  p05: rob.p05, p95: rob.p95, valor: indice.data.valor,
  n_draws: rob.n_draws, base100: !!indice.base100,
} : null;
---
<Layout title={`${meta.nombre} · Monitor del Plan de Gobierno · CiGob`}>
  <Nav />
  <header class={`cg-hero cg-detalle-hero cg-detalle-hero--${meta.slug}`} id="top">
    <div class="cg-hero-inner cg-detalle-inner">
      <div class="cg-detalle-cols">
      <div class="cg-detalle-texto">
      <p class="cg-eyebrow"><a href={`${base}/`}>← Resumen</a> · Cinturón</p>
      <h1 class="cg-hero-title cg-detalle-title">{meta.nombre}</h1>
      <p class="cg-hero-lead cg-detalle-lead">{meta.sub}.</p>
      <div class="cg-detalle-meta">
        {/* La barra reemplaza al chip de score, que repetía su número. El
            estado queda al lado, en texto: es otro concepto, no otro color. */}
        {indice && <span class="cg-detalle-chip">{indice.Corto} <strong>{num(indice.data.valor as number)}{indice.base100 ? "" : "/100"}</strong>{!esMacro && <> · {indice.data.banda_legible}</>}</span>}
        {!esMacro && <span class="cg-detalle-chip">Riesgo: <strong>{cap(c.barbarismo_riesgo)}</strong></span>}
        <span class="cg-detalle-chip">{filas.length} {filas.length === 1 ? "indicador" : "indicadores"}</span>
      </div>
      </div>
      <div class="cg-detalle-nivel">
        <NivelTension tension={c.score} titulo={`Tensión de ${meta.nombre}`} tamano="grande"
          ocultarLectura={esMacro} pie={esMacro ? PIE_MACRO : undefined} />
      </div>
      </div>
    </div>
  </header>
  <main class:list={["cg-main", { "cg-main--macro": esMacro }]}>
    {indice && (
      <section class="cg-section">
        <div class="cg-section-head">
          <p class="cg-eyebrow">Índice paramétrico</p>
          <h2 class="cg-h2">{indice.Corto}: {num(indice.data.valor as number)}{indice.base100 ? " (escala de referencia 100)" : "/100"}{!esMacro && <> — {indice.data.banda_legible}</>}</h2>
          <p class="cg-h2-sub">{indice.descripcion}</p>
        </div>
        <div class="cg-itcm-dims">
          {Object.entries(indice.data.dimensiones).map(([dkey, dim]) => (
            <div class={`cg-itcm-dim cg-dim--clickable${dim.critica ? " cg-itcm-dim--critica" : ""}`}
                 data-dimension={dkey} data-cinturon={meta.slug}
                 role="button" tabindex="0" aria-label={`Ver la composición de ${dim.nombre}`}>
              <div class="cg-itcm-dim-head">
                <span class="cg-itcm-dim-name">{dim.nombre}</span>
                <span class="cg-itcm-dim-val">pesa {Math.round(dim.peso * 100)}%</span>
              </div>
              <NivelTension
                tension={dim.semaforo?.tension ?? tensionDeDimension(dim.puntaje, !!indice.base100)}
                titulo={dim.nombre}
                ocultarTitulo
              />
              {dim.critica && (
                <p class="cg-dim-critica">
                  <span class="cg-dim-critica-chip">Dimensión crítica</span>
                  {" "}el promedio del índice no la compensa
                </p>
              )}
            </div>
          ))}
        </div>
        <p class="cg-dims-hint">Tocá una dimensión para ver su composición: indicadores, pesos y puntajes.</p>
        {indice.data.ajustes_aplicados.length > 0 && (
          <p class="cg-h2-sub" style="margin-top:12px;">
            <strong>Ajustes del analista:</strong>{" "}
            {indice.data.ajustes_aplicados.map(a => `${a.indicador}: ${a.de} → ${a.a} (${a.justificacion})`).join(" · ")}
          </p>
        )}
        {/* Cómo se calcula, en llano y al pie de las dimensiones (ADR-0352): antes
            era una nota técnica al final de la página. */}
        <div class="cg-como-se-calcula">
          <h3 class="cg-como-se-calcula-h">Cómo se calcula este número</h3>
          {indice.base100 ? (
            <p>
              El {indice.corto} compara cómo están hoy los hogares con cómo estaban al
              empezar el mandato. <strong>100 es el promedio del último trimestre de 2023</strong>:
              más de 100 quiere decir que la situación mejoró desde entonces, y menos de 100,
              que empeoró. No tiene techo. Hoy marca <strong>{num(indice.data.valor as number)}</strong>.
            </p>
          ) : (
            <p>
              El {indice.corto} resume en un número de 0 a 100 {RESUMEN_INDICE[meta.key]}{" "}
              <strong>0 es la peor situación y 100 la mejor</strong>. Hoy marca{" "}
              <strong>{num(indice.data.valor as number)}</strong>.
            </p>
          )}
          <p>
            Se arma en tres pasos. Primero, cada indicador recibe un puntaje: {indice.base100
              ? "se lo pone en la misma escala, donde 100 es su valor de fines de 2023."
              : "su valor se compara con una tabla fija de referencias, igual para todos los meses, y se traduce a un puntaje de 0 a 100."}{" "}
            Después, los indicadores se agrupan en las {Object.keys(indice.data.dimensiones).length} dimensiones
            de las tarjetas de arriba, y cada una promedia los puntajes de sus indicadores. Por último,
            el índice promedia las dimensiones según su peso:{" "}
            {Object.values(indice.data.dimensiones).map((d, i, a) =>
              `${d.nombre.charAt(0).toLowerCase()}${d.nombre.slice(1)} (${Math.round(d.peso * 100)}%)${i < a.length - 2 ? ", " : i === a.length - 2 ? " y " : "."}`).join("")}{" "}
            Si una dimensión cae muy abajo, se marca como crítica: el promedio no alcanza a compensarla.
          </p>
          {PARTICULAR_INDICE[meta.key] && <p>{PARTICULAR_INDICE[meta.key]}</p>}
          <p>
            El color del cinturón sale de este número: {coloresEnIndice(!!indice.base100)}. Los
            cuatro cinturones usan los mismos cortes de color, y por eso se pueden comparar entre sí.
            Cada indicador tiene su ficha con la fuente, el cálculo y sus límites.
          </p>
        </div>
      </section>
    )}
    <section class="cg-section">
      <div class="cg-section-head">
        <p class="cg-eyebrow">Indicadores</p>
        <h2 class="cg-h2">El detalle, hoy</h2>
        <p class="cg-h2-sub">
          {indice
            ? "Los que construyen el índice. Tocá uno para ver qué mide y cómo viene."
            : "Tocá un indicador para ver qué mide y cómo viene."}
        </p>
      </div>
      <SemaforoLeyenda />
      {gruposDim.length > 0 ? (
        <div class={`cg-dim-groups cg-dim-groups--${meta.slug}`} id="cg-dim-groups">
          {gruposDim.map(g => (
            <div class="cg-dim-group" data-grupo={g.dkey}>
              <div class="cg-dim-group-head">
                <h3 class="cg-dim-group-name">
                  {g.semaforo?.color && (
                    <span
                      class:list={["cg-tile-dot", `sem-${semaforoDe(g)}`]}
                      role="img"
                      aria-label={semaforoAriaLabel(g.semaforo)}
                    ></span>
                  )}
                  {g.nombre}
                </h3>
                <span class="cg-dim-group-meta">
                  <strong>{num(g.puntaje)}</strong>{indice!.base100 ? "" : "/100"} · pesa {Math.round(g.peso * 100)}% · {g.filas.filter(f => !f.ind.cumplido && !f.ind.suspendido).length} {g.filas.filter(f => !f.ind.cumplido && !f.ind.suspendido).length === 1 ? "indicador" : "indicadores"}{g.filas.some(f => f.ind.cumplido) && ` + ${g.filas.filter(f => f.ind.cumplido).length} logrado`}{g.filas.some(f => f.ind.suspendido) && ` + ${g.filas.filter(f => f.ind.suspendido).length} en revisión`}
                </span>
              </div>
              <div class="cg-tile-grid">
                {g.filas.map(({ key, ind }) => (
                  ind.cumplido ? (
                    <div class="cg-cumplido-wrap" title={ind.cumplido.por_que}>
                      <span class="cg-cumplido-chip">✓ Logrado en {ind.cumplido.desde_txt ?? ind.cumplido.desde} · ya no puntúa</span>
                      <IndicadorTile ikey={key} ind={ind} slug={meta.slug} compacto />
                    </div>
                  ) : ind.suspendido ? (
                    <div class="cg-suspendido-wrap" title={ind.suspendido.por_que}>
                      <span class="cg-suspendido-chip">⏸ Fuera del índice desde {ind.suspendido.desde_txt ?? ind.suspendido.desde} · en revisión</span>
                      <IndicadorTile ikey={key} ind={ind} slug={meta.slug} compacto />
                    </div>
                  ) : <IndicadorTile ikey={key} ind={ind} slug={meta.slug} compacto />
                ))}
              </div>
            </div>
          ))}
          {filasSinDimension.length > 0 && (
            <div class="cg-dim-group" data-grupo="__sin_dimension">
              <div class="cg-dim-group-head">
                <h3 class="cg-dim-group-name">Sin dimensión asignada</h3>
              </div>
              <div class="cg-tile-grid">
                {filasSinDimension.map(({ key, ind }) => <IndicadorTile ikey={key} ind={ind} slug={meta.slug} compacto />)}
              </div>
            </div>
          )}
        </div>
      ) : (
        <div class="cg-tile-grid">
          {filasIndice.map(({ key, ind }) => <IndicadorTile ikey={key} ind={ind} slug={meta.slug} compacto />)}
        </div>
      )}
    </section>

    {filasSinUniverso.length > 0 && (
      <section class="cg-section">
        <div class="cg-section-head">
          <p class="cg-eyebrow">Sin universo</p>
          <h2 class="cg-h2">Sin tasa para esta ventana</h2>
          <p class="cg-h2-sub">No hay eventos en el denominador para calcular estos componentes. Permanecen visibles, sin puntaje; su peso se redistribuye entre los componentes observados de la dimensión.</p>
        </div>
        <div class="cg-tile-grid">
          {filasSinUniverso.map(({ key, ind }) => <IndicadorTile ikey={key} ind={ind} slug={meta.slug} compacto />)}
        </div>
      </section>
    )}

    {filasContexto.length > 0 && (
      <section class="cg-section">
        <div class="cg-section-head">
          <p class="cg-eyebrow">Contexto</p>
          <h2 class="cg-h2">No integran el índice</h2>
          <p class="cg-h2-sub">Datos de seguimiento que ayudan a leer el cinturón pero <strong>no construyen la tensión</strong> del {indice?.corto ?? "índice"}: quedan fuera del cálculo para que el indicador sea transparente.</p>
        </div>
        <div class="cg-tile-grid">
          {filasContexto.map(({ key, ind }) => <IndicadorTile ikey={key} ind={ind} slug={meta.slug} compacto />)}
        </div>
      </section>
    )}

    {rob && robSvg && indice && (
      <section class="cg-section">
        <div class="cg-section-head">
          <p class="cg-eyebrow">Robustez</p>
          <h2 class="cg-h2">¿Qué tan firme es este número?</h2>
          <p class="cg-h2-sub">
            El {indice.corto} depende de decisiones del equipo, como cuánto pesa cada
            dimensión, y de datos que pueden traer pequeños errores. Para saber cuánto
            importa eso, lo recalculamos {rob.n_draws.toLocaleString("es-AR")} veces
            cambiando un poco, al azar, {robQueCambia}. El gráfico muestra qué valores
            dieron esos cálculos: cuanto más angosta la campana, más firme el número.
          </p>
        </div>
        <div class={`cg-rob cg-rob--${meta.slug}`} data-det="rob" role="button" tabindex="0"
             aria-label="Ver el detalle del análisis de robustez">
          <div class="cg-rob-head">
            <span>Los {rob.n_draws.toLocaleString("es-AR")} cálculos del {indice.corto}</span>
            <span>9 de cada 10 dieron entre <strong>{num(rob.p05)} y {num(rob.p95)}</strong></span>
          </div>
          <svg class="cg-rob-svg" viewBox={`0 0 ${robSvg.W} ${robSvg.H}`} role="img"
               aria-label={`Distribución simulada del ${indice.corto}: entre ${num(rob.p05)} y ${num(rob.p95)} en el 90% de los escenarios`}>
            <defs>
              <clipPath id="rob-clip">
                <rect x={robSvg.x05} y="0" width={robSvg.x95 - robSvg.x05} height={robSvg.H} />
              </clipPath>
            </defs>
            <path d={robSvg.area} fill="var(--rob-c)" fill-opacity="0.10" />
            <path d={robSvg.area} fill="var(--rob-c)" fill-opacity="0.32" clip-path="url(#rob-clip)" />
            <path d={robSvg.line} fill="none" stroke="var(--rob-c)" stroke-width="2" stroke-linejoin="round" />
            {robSvg.x100 !== null && (
              <line x1={robSvg.x100} x2={robSvg.x100} y1="4" y2={robSvg.base}
                    stroke="var(--muted)" stroke-width="1.5" stroke-dasharray="4 3" opacity="0.65" />
            )}
            <line x1={robSvg.xval} x2={robSvg.xval} y1="8" y2={robSvg.base}
                  stroke="var(--dark)" stroke-width="1.8" />
            <circle cx={robSvg.xval} cy="8" r="3.4" fill="var(--dark)" />
            <line x1="0" x2={robSvg.W} y1={robSvg.base} y2={robSvg.base}
                  stroke="var(--bd)" stroke-width="1" />
          </svg>
          <div class="cg-rob-ticks">
            <span class="cg-rob-tick" style={`left:${robSvg.pct(robSvg.x05)}%`}>{num(rob.p05)}</span>
            <span class="cg-rob-tick cg-rob-tick--val" style={`left:${robSvg.pct(robSvg.xval)}%`}>{num(indice.data.valor)}</span>
            <span class="cg-rob-tick" style={`left:${robSvg.pct(robSvg.x95)}%`}>{num(rob.p95)}</span>
            {robSvg.x100 !== null && (
              <span class="cg-rob-tick cg-rob-tick--ext" style={`left:${robSvg.pct(robSvg.x100)}%`}>100 = fines de 2023</span>
            )}
          </div>
          <p class="cg-h2-sub">
            En 9 de cada 10 cálculos el {indice.corto} dio entre <strong>{num(rob.p05)}</strong> y{" "}
            <strong>{num(rob.p95)}</strong>; el valor publicado es <strong>{num(indice.data.valor)}</strong>.{" "}
            {robEstable
              ? <Fragment>En todo ese rango el cinturón queda en el mismo color (<strong>{robLecturas[0]}</strong>): la lectura no depende de cómo se eligieron los pesos ni de pequeños errores en los datos.</Fragment>
              : <Fragment>Ese rango cruza un corte de color, entre <strong>{robLecturas[0]}</strong> y <strong>{robLecturas[1]}</strong>: el cinturón está cerca del límite y un pequeño cambio en {indice.base100 ? "los pesos" : "los pesos o en los datos"} podría cambiarle el color. Conviene leer el color con esa cautela.</Fragment>}
            {robBajoBase && (
              <Fragment>
                {" "}Incluso el cálculo más favorable queda <strong>debajo de 100</strong>, el nivel de
                fines de 2023: que la situación empeoró desde entonces no depende de los pesos.
              </Fragment>
            )}
          </p>
          <div class="cg-det-cta">Ver el detalle →</div>
        </div>
      </section>
    )}

    <section class="cg-section cg-sources" id="fuentes">
      <p class="cg-eyebrow">Fuentes</p>
      <ul>{fuentes.map(f => <li>{f}</li>)}</ul>
    </section>



  </main>
  <Footer />
  <IndicadorModal />

  {indice && (
    <div class="cg-modal" id="cg-det-modal" hidden>
      <div class="cg-modal-card cg-det-card">
        <button class="cg-modal-close" id="cg-det-close" aria-label="Cerrar">×</button>
        <div id="cg-det-body"></div>
      </div>
    </div>
  )}

  {rob && indice && (
    <template id="cg-det-rob">
      <p class="cg-eyebrow">Robustez · {indice.Corto}</p>
      <h3 class="cg-modal-title">¿Qué tan firme es este número?</h3>
      <p class="cg-modal-desc">
        Todo índice que junta muchos datos depende de cuánto se decidió que pese cada uno
        y de qué tan precisas son las fuentes. Para medir cuánto importa eso, el{" "}
        {indice.corto} se recalcula <strong>{rob.n_draws.toLocaleString("es-AR")} veces</strong>.
        En cada cálculo, los pesos de las dimensiones y de los indicadores se mueven al azar
        hasta un 20% para arriba o para abajo{indice.base100 ? "" : ", y cada dato de entrada se mueve un poco, en proporción a lo que de verdad puede cambiar su puntaje"}.
        El azar arranca siempre del mismo punto, así que cualquiera puede repetir el ejercicio
        y obtener lo mismo.
      </p>
      <dl class="cg-modal-ficha">
        <div><dt>Valor publicado</dt><dd>{num(indice.data.valor)}</dd></div>
        <div><dt>9 de cada 10 cálculos</dt><dd>{num(rob.p05)} – {num(rob.p95)}</dd></div>
        <div><dt>Ancho del rango</dt><dd>{num(robAmplitud!)} puntos</dd></div>
      </dl>
      <p class="cg-modal-h4">Qué dieron los {rob.n_draws.toLocaleString("es-AR")} cálculos</p>
      <div id="cg-det-rob-chart" data-nombre={indice.Corto}></div>
      <p class="cg-formula-leyenda">
        Pasá el cursor (o el dedo) por la campana: cada punto dice cuántos de los cálculos
        dieron ese valor del índice.
      </p>
      {domLabel && (
        <Fragment>
          <p class="cg-modal-h4">El componente que más pesa hoy</p>
          <p class="cg-modal-desc">
            <strong>{domLabel}</strong> es el indicador que más mueve el resultado: si se lo
            sacara del índice y su peso se repartiera entre los demás, el {indice.corto}{" "}
            daría <strong>{num(rob.dominante.indice_sin)}</strong>, {num(Math.abs(domDelta!))} puntos{" "}
            {domDelta! > 0 ? "más" : "menos"}. Eso no invalida el índice, pero dice qué dato
            conviene mirar de cerca: es el que más pesa en la lectura del mes.
          </p>
        </Fragment>
      )}
      <p class="cg-modal-h4">Cómo leerlo</p>
      <p class="cg-modal-desc">
        La parte más oscura del gráfico junta 9 de cada 10 cálculos. Si todo ese tramo queda
        dentro de un mismo color, lo que dice el cinturón no depende de cómo se armó el índice.{" "}
        {robEstable
          ? `Hoy pasa eso: en todo el tramo el cinturón queda en ${robLecturas[0]}.`
          : `Hoy no: el tramo cruza el corte entre ${robLecturas[0]} y ${robLecturas[1]}, así que el color está cerca del límite.`}
        {robBajoBase ? " Y aun el cálculo más favorable queda debajo de 100, el nivel de fines de 2023: que la situación empeoró no depende de los pesos." : ""}
      </p>
    </template>
  )}



  {robChartData && (
    <script type="application/json" id="cg-det-rob-data" set:html={JSON.stringify(robChartData)} />
  )}
  <script>
    import { track } from "../lib/analytics.ts";

    // El slug sale de la URL y no del frontmatter: este <script> lo bundlea
    // Astro, así que no ve las props del componente. La ruta es /macro/,
    // /politica/, etc., de modo que el pathname ES el cinturón.
    const CINTURON = location.pathname.replace(/^\/+|\/+$/g, "") || "inicio";
    track("ver_cinturon", { cinturon: CINTURON });

    const modal = document.getElementById("cg-det-modal");
    if (modal) {
      const body = document.getElementById("cg-det-body")!;
      let chart: any = null;
      const abrir = async (key: string) => {
        const tpl = document.getElementById("cg-det-" + key) as HTMLTemplateElement | null;
        if (!tpl) return;
        body.innerHTML = "";
        body.appendChild(tpl.content.cloneNode(true));
        if (key === "cruz") {
          const dest = body.querySelector("#cg-det-cruz-tabla");
          const tabla = document.querySelector(".cg-cruz .cg-cruz-tabla");
          if (dest && tabla) dest.appendChild(tabla.cloneNode(true));
        }
        modal.removeAttribute("hidden");
        document.body.style.overflow = "hidden";
        if (key === "val") {
          const dataEl = document.getElementById("cg-det-val-data");
          const dest = body.querySelector("#cg-det-val-chart") as HTMLElement | null;
          if (dataEl && dest) {
            const d = JSON.parse(dataEl.textContent!);
            const { dualTimeChart, colorDe } = await import("../lib/charts.ts");
            const aPuntos = d.pares.map((p: any) => ({ fecha: p[0] + "-01", valor: p[1] }));
            const bPuntos = d.pares.map((p: any) => ({ fecha: p[0] + "-01", valor: p[2] }));
            chart = dualTimeChart(dest,
              { ...d.indice, puntos: aPuntos }, { ...d.externa, puntos: bPuntos },
              { color: colorDe(d.slug), ejeBInvertido: !!d.ejeBInvertido });
          }
        }
        if (key === "rob") {
          const dataEl = document.getElementById("cg-det-rob-data");
          const dest = body.querySelector("#cg-det-rob-chart") as HTMLElement | null;
          if (dataEl && dest) {
            const d = JSON.parse(dataEl.textContent!);
            const { distChart, colorDe } = await import("../lib/charts.ts");
            chart = distChart(dest, d, { color: colorDe(d.slug) });
          }
        }
      };
      const cerrar = () => {
        modal.setAttribute("hidden", "");
        document.body.style.overflow = "";
        if (chart) { chart.destroy(); chart = null; }
      };
      for (const el of document.querySelectorAll<HTMLElement>("[data-det]")) {
        el.addEventListener("click", () => abrir(el.dataset.det!));
        el.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") { e.preventDefault(); abrir(el.dataset.det!); }
        });
      }
      document.getElementById("cg-det-close")!.addEventListener("click", (e) => { e.stopPropagation(); cerrar(); });
      modal.addEventListener("click", (e) => { if (e.target === modal) cerrar(); });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !modal.hasAttribute("hidden")) cerrar(); });
    }
  
  // Resaltado de indicadores por dimensión: al pasar el mouse (o enfocar con
  // teclado) una card de dimensión se atenúan los grupos que no le pertenecen.
  // El click FIJA el resaltado además de abrir el modal, así queda puesto
  // cuando el modal se cierra; volver a clickear la misma dimensión lo suelta.
  (() => {
    const grupos = document.getElementById("cg-dim-groups");
    if (!grupos) return;
    const dims = document.querySelectorAll(".cg-itcm-dim[data-dimension]");
    if (!dims.length) return;
    let fijada = null;

    const pintar = (dkey) => {
      if (!dkey) {
        grupos.removeAttribute("data-resalta");
        grupos.querySelectorAll(".cg-dim-group").forEach(g => g.classList.remove("es-activo"));
        dims.forEach(d => d.classList.remove("es-fuente"));
        return;
      }
      grupos.setAttribute("data-resalta", dkey);
      grupos.querySelectorAll(".cg-dim-group").forEach(g =>
        g.classList.toggle("es-activo", g.dataset.grupo === dkey));
      dims.forEach(d => d.classList.toggle("es-fuente", d.dataset.dimension === dkey));
    };

    dims.forEach(card => {
      const dkey = card.dataset.dimension;
      card.addEventListener("mouseenter", () => pintar(dkey));
      card.addEventListener("focus", () => pintar(dkey));
      card.addEventListener("mouseleave", () => pintar(fijada));
      card.addEventListener("blur", () => pintar(fijada));
      // El listener del modal ya vive en otro lado; acá se fija/suelta y, si
      // el grupo quedó fuera de pantalla, se lo trae. Sin esto, hacer foco en
      // una dimensión de abajo atenuaba todo lo visible sin nada iluminado a
      // la vista, que se lee como si la página se hubiera roto.
      card.addEventListener("click", () => {
        fijada = fijada === dkey ? null : dkey;
        pintar(fijada);
        // Solo se registra el fijado, no el soltado: lo que interesa es qué
        // dimensión eligió mirar en detalle, no cuándo dejó de hacerlo.
        if (fijada) track("fijar_dimension", { cinturon: CINTURON, dimension: dkey });
        if (!fijada) return;
        const grupo = grupos.querySelector(`.cg-dim-group[data-grupo="${dkey}"]`);
        if (!grupo) return;
        const r = grupo.getBoundingClientRect();
        const visible = r.top >= 0 && r.top < window.innerHeight * 0.6;
        if (!visible) grupo.scrollIntoView({ behavior: "smooth", block: "start" });
      });
      card.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          fijada = fijada === dkey ? null : dkey;
          pintar(fijada);
          if (fijada) track("fijar_dimension", { cinturon: CINTURON, dimension: dkey });
        }
      });
    });

    // Escape suelta el resaltado, PERO sólo si no hay un modal abierto: ahí
    // Escape es para cerrarlo, y soltar el resaltado en el mismo golpe dejaba
    // al lector sin el efecto justo cuando volvía a mirar los indicadores.
    // En fase de CAPTURA: los handlers de los modales corren en burbujeo, así
    // que si esperáramos el turno normal el modal ya estaría cerrado y siempre
    // pareceria que no había ninguno abierto.
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape" || !fijada) return;
      if (document.querySelector(".cg-modal:not([hidden])")) return;  // Escape es del modal
      fijada = null;
      pintar(null);
    }, true);
  })();
</script>
</Layout>

<style is:global>
  /* Cinturón macro: el pie de la barra es un párrafo de lectura, no una nota. */
  .cg-detalle-hero--macroeconomia .cg-nivel-pie,
  .cg-detalle-hero--macro .cg-nivel-pie { font-size: 15px; line-height: 1.55; }
</style>
