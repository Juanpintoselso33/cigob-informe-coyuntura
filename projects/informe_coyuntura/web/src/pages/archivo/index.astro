---
// Archivo de informes mensuales (ADR-0348). Diseño (7-oct-2026, pedido de
// Juan, a partir de docs/261007_archivo_referencias_diseno.md): una FRANJA de
// meses pintados con la tensión general, que sirve de índice, y una TABLA de
// ediciones con una fila por mes. Las cuatro celdas de los cinturones van
// alineadas en columna, así cada columna se lee como la historia de ese
// cinturón (la idea de #ShowYourStripes). Se marcan los meses en que algo cambió.
//
// Cada mes es una reconstrucción con el Monitor de hoy sobre los datos de su
// última corrida (`public/archivo/AAAA-MM/index.html`, scripts/archivo.py).
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
// La misma barra de nivel del Resumen (pedido de Juan, 7-oct-2026): los cuatro
// tramos pálidos, el tramo que corresponde lleno y la marca donde cae el valor.
import NivelTension from "../../components/NivelTension.astro";
import archivo from "../../contenido/archivo.json";
import { CINTURONES, mesLegible, colorPorTension, LECTURA_SEMAFORO } from "../../lib/datos.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const ORDEN = ["macro", "politica", "vida_cotidiana", "gestion"] as const;
const NOMBRE: Record<string, string> = Object.fromEntries(CINTURONES.map(c => [c.key, c.nombre]));
const CORTO: Record<string, string> = { macro: "Macro", politica: "Política", vida_cotidiana: "Impacto", gestion: "Gestión" };
const coma = (n: number | null | undefined) => (typeof n === "number" ? n.toFixed(1).replace(".", ",") : "—");
const fecha = (iso?: string) =>
  iso ? new Date(iso).toLocaleDateString("es-AR", { day: "numeric", month: "long", year: "numeric", timeZone: "America/Argentina/Buenos_Aires" }) : "";
const anio = (m: string) => m.slice(0, 4);

// Del más nuevo al más viejo; para el cambio y los hitos, se compara cada mes
// con el anterior en el tiempo (el siguiente en la lista).
const meses = (archivo as { meses: any[] }).meses;
// El riesgo dominante se nombra por el CINTURÓN que lo produce, como el pie del
// Hero (ADR-0237): «Político» a secas mandaba a la card de Política cuando el que
// tensa es Impacto social.
const riesgo = (m: any) => (m?.cinturon_dominante ? NOMBRE[m.cinturon_dominante] : m?.riesgo_dominante) ?? null;
const filas = meses.map((m, i) => {
  const ant = meses[i + 1];
  const color = colorPorTension(m.score_global);
  const cint = ORDEN.map(k => {
    const c = m.cinturones?.[k];
    const col = colorPorTension(c?.score);
    return { k, score: c?.score, color: col, lectura: col ? LECTURA_SEMAFORO[col] : "Dato pendiente" };
  });
  const delta = ant && typeof m.score_global === "number" && typeof ant.score_global === "number"
    ? Math.round((m.score_global - ant.score_global) * 10) / 10 : null;
  const cambios: string[] = [];
  if (ant) {
    if (riesgo(ant) && riesgo(m) !== riesgo(ant))
      cambios.push(`el riesgo dominante pasa de ${riesgo(ant)} a ${riesgo(m)}`);
    for (const c of cint) {
      const prev = colorPorTension(ant.cinturones?.[c.k]?.score);
      if (prev && c.color && prev !== c.color) cambios.push(`${NOMBRE[c.k]}: de ${LECTURA_SEMAFORO[prev].toLowerCase()} a ${c.lectura.toLowerCase()}`);
    }
  }
  return { ...m, riesgo_dominante: riesgo(m), color, cint, delta, cambios };
});
const masTenso = (f: typeof filas[number]) =>
  f.cint.filter(c => typeof c.score === "number").sort((a, b) => (b.score as number) - (a.score as number))[0];
// El titular del mes, armado como texto: con fragmentos de Astro quedaban
// espacios sueltos antes de cada punto y coma.
const titular = (f: typeof filas[number]) => {
  const t = masTenso(f);
  return [
    `${f.color ? LECTURA_SEMAFORO[f.color] : "Sin dato"} en el conjunto`,
    f.riesgo_dominante && `riesgo dominante: ${f.riesgo_dominante}`,
    t && t.k !== f.cinturon_dominante && `el cinturón más tenso fue ${NOMBRE[t.k]}`,
  ].filter(Boolean).join("; ") + ".";
};
---
<Layout title="Archivo · Monitor del Plan de Gobierno · CiGob">
  <Nav />
  <main class="cg-main">
    <section class="cg-section ar">
      <div class="cg-section-head">
        <p class="cg-eyebrow">Ediciones anteriores</p>
        <h1 class="cg-h2">Archivo</h1>
        <p class="cg-h2-sub">La tensión de cada mes, medida con el Monitor de hoy sobre los datos que había al cierre de ese mes: la misma vara para todos, así se pueden comparar con el mes vigente.</p>
      </div>

      {filas.length === 0 ? (
        <p class="ar-vacio">Todavía no hay meses archivados.</p>
      ) : (
        <Fragment>
          <nav class="ar-franja" aria-label="Meses archivados">
            {[...filas].reverse().map(f => (
              <a href={`#mes-${f.mes}`} class:list={["ar-franja-mes", f.color && `sem-${f.color}`]} data-mes={f.mes}
                 title={`${mesLegible(f.mes)}: ${f.color ? LECTURA_SEMAFORO[f.color].toLowerCase() : "sin dato"} (${coma(f.score_global)})`}>
                <span class="ar-franja-m">{mesLegible(f.mes).split(" ")[0]} <span class="ar-franja-a">{anio(f.mes)}</span></span>
                <span class="ar-franja-n">{coma(f.score_global)}</span>
                <span class="ar-franja-l">{f.color ? LECTURA_SEMAFORO[f.color] : "Dato pendiente"}</span>
              </a>
            ))}
          </nav>
          <p class="ar-ayuda">Tensión general de cada mes, de 0 a 10. En la tabla, cada columna se lee de arriba abajo como el recorrido de ese cinturón; <span class="ar-hito-ej">★</span> marca los meses en que algo cambió.</p>

          <div class="ar-tabla" role="table" aria-label="Ediciones del Monitor">
            <div class="ar-cab" role="row">
              <span role="columnheader">Mes</span>
              <span role="columnheader">Tensión general</span>
              {ORDEN.map(k => <span role="columnheader" class="ar-c" title={NOMBRE[k]}>{CORTO[k]}</span>)}
              <span role="columnheader" class="ar-riesgo">Riesgo dominante</span>
              <span role="columnheader" class="ar-num ar-delta">Cambio</span>
            </div>
            {filas.map(f => {
              return (
                <details class="ar-fila" id={`mes-${f.mes}`} data-mes={f.mes}>
                  <summary role="row">
                    <span class="ar-mes" role="cell">
                      <span class="ar-mes-t"><span class="ar-mes-n">{mesLegible(f.mes).split(" ")[0]}</span><span class="ar-mes-a">{anio(f.mes)}</span></span>
                      {f.cambios.length > 0 && <span class="ar-hito" title={f.cambios.join(" · ")}>★</span>}
                    </span>
                    <span class="ar-global ar-barra" role="cell" title={f.color ? LECTURA_SEMAFORO[f.color] : "Dato pendiente"}>
                      <NivelTension tension={f.score_global} titulo={`Tensión general de ${mesLegible(f.mes)}`} ocultarTitulo ocultarLectura />
                      <span class="ar-n ar-n-g">{coma(f.score_global)}</span>
                    </span>
                    {f.cint.map(c => (
                      <span class="ar-c ar-barra" role="cell" title={`${NOMBRE[c.k]}: ${c.lectura.toLowerCase()}`}>
                        <NivelTension tension={c.score} titulo={`${NOMBRE[c.k]} en ${mesLegible(f.mes)}`} ocultarTitulo ocultarLectura />
                        <span class="ar-n">{coma(c.score)}</span>
                      </span>
                    ))}
                    <span class="ar-riesgo" role="cell">{f.riesgo_dominante ?? "—"}</span>
                    <span class="ar-num ar-delta" role="cell">
                      {f.delta === null ? "" : f.delta > 0 ? <span class="sube">▲ {coma(f.delta)}</span> : f.delta < 0 ? <span class="baja">▼ {coma(Math.abs(f.delta))}</span> : <span>=</span>}
                    </span>
                  </summary>
                  <div class="ar-detalle">
                    <p class="ar-titular">{titular(f)}</p>
                    <ul class="ar-cint">
                      {f.cint.map(c => (
                        <li><span class:list={["ar-punto", c.color && `sem-${c.color}`]} aria-hidden="true"></span>
                          <span class="ar-cint-n">{NOMBRE[c.k]}</span> <span class="ar-cint-l">{c.lectura.toLowerCase()} · {coma(c.score)}</span></li>
                      ))}
                    </ul>
                    {f.cambios.length > 0 && <p class="ar-cambios">Qué cambió frente al mes anterior: {f.cambios.join("; ")}.</p>}
                    <p class="ar-pie">
                      {f.pagina
                        ? <a class="ar-ver" href={`${base}/archivo/${f.mes}/`} data-mes={f.mes}>Ver el informe completo de {mesLegible(f.mes).toLowerCase()} →</a>
                        : <span class="ar-sin-pagina">El informe completo de este mes se está reconstruyendo con el Monitor de hoy.</span>}
                      <span>Datos al {fecha(f.generado)}</span>
                    </p>
                  </div>
                </details>
              );
            })}
          </div>
        </Fragment>
      )}
    </section>
  </main>
  <Footer />
</Layout>

<script>
  // GA4 directo, sin importar analytics.ts (ver MuroAcceso.astro: un import
  // compartido rompe el emisor del informe en un solo archivo).
  const track = (evento: string, params: Record<string, unknown> = {}) => {
    const limpio = Object.fromEntries(Object.entries(params).filter(([, v]) => v !== undefined && v !== null && v !== ""));
    try { (window as any).gtag?.("event", evento, limpio); } catch {}
  };
  track("ver_archivo");
  document.querySelectorAll<HTMLAnchorElement>(".ar-ver").forEach(a =>
    a.addEventListener("click", () => track("abrir_mes_archivo", { mes: a.dataset.mes })));
  document.querySelectorAll<HTMLDetailsElement>(".ar-fila").forEach(d =>
    d.addEventListener("toggle", () => { if (d.open) track("desplegar_mes_archivo", { mes: d.dataset.mes }); }));
  // La franja lleva a la fila y la abre.
  document.querySelectorAll<HTMLAnchorElement>(".ar-franja-mes").forEach(a =>
    a.addEventListener("click", () => {
      const fila = document.getElementById(`mes-${a.dataset.mes}`) as HTMLDetailsElement | null;
      if (fila) fila.open = true;
    }));
</script>

<style>
  .ar { --sem-verde: var(--verde); --sem-amarillo: var(--amarillo); --sem-naranja: var(--naranja); --sem-rojo: var(--rojo); }
  .ar-vacio { color: var(--muted); }

  /* Franja índice */
  .ar-franja { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px; margin: 8px 0 12px; }
  /* Los tonos pálidos del semáforo con un filete del color fuerte, como los
     tramos de la barra de nivel del Resumen: nunca un bloque macizo. */
  .ar-franja-mes {
    min-width: 0; padding: 12px 14px 10px;
    display: flex; flex-direction: column; align-items: flex-start; gap: 2px;
    border-radius: 4px; text-decoration: none; color: var(--dark);
    background: var(--bg-tint); border-bottom: 4px solid var(--bd);
    transition: transform .12s ease, box-shadow .12s ease;
  }
  .ar-franja-mes:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(27,46,60,.18); text-decoration: none; }
  .ar-franja-m { font-family: var(--ff-ui); font-weight: 600; font-size: 13px; text-transform: capitalize; }
  .ar-franja-a { font-weight: 400; color: var(--muted); }
  .ar-franja-n { font-family: var(--ff-dato); font-weight: 700; font-size: 26px; line-height: 1.1; color: var(--dark); font-variant-numeric: tabular-nums; }
  .ar-franja-l { font-size: 12px; color: var(--muted); }
  .ar-franja-mes.sem-verde { background: var(--verde-soft); border-bottom-color: var(--sem-verde); }
  .ar-franja-mes.sem-amarillo { background: var(--amarillo-soft); border-bottom-color: var(--sem-amarillo); }
  .ar-franja-mes.sem-naranja { background: var(--naranja-soft); border-bottom-color: var(--sem-naranja); }
  .ar-franja-mes.sem-rojo { background: var(--rojo-soft); border-bottom-color: var(--sem-rojo); }
  .ar-ayuda { margin: 0 0 22px; font-size: 13px; color: var(--muted); }
  .ar-hito-ej { color: var(--naranja); }

  /* Tabla de ediciones */
  .ar-tabla { border-top: 2px solid var(--dark); }
  .ar-cab, .ar-fila > summary {
    display: grid;
    grid-template-columns: 120px minmax(170px, 1.4fr) repeat(4, minmax(100px, 1fr)) 90px 52px;
    align-items: center; gap: 0 26px; padding: 0 12px;
  }
  .ar-cab { padding-top: 10px; padding-bottom: 10px; font-family: var(--ff-ui); font-size: 11px; font-weight: 600;
            letter-spacing: .06em; text-transform: uppercase; color: var(--muted); border-bottom: 1px solid var(--bd); }
  .ar-fila { border-bottom: 1px solid var(--bd); }
  .ar-fila > summary { list-style: none; cursor: pointer; min-height: 64px; padding-top: 10px; padding-bottom: 10px; }
  .ar-global, .ar-c { min-width: 0; }
  .ar-cab .ar-c { text-align: left; }
  .ar-fila > summary::-webkit-details-marker { display: none; }
  .ar-fila > summary:hover { background: var(--fondo-hover, #FAFDFE); }
  .ar-fila[open] > summary { background: var(--bg-tint); }
  .ar-mes { font-family: var(--ff-titulo); font-weight: 700; font-size: 17px; color: var(--dark); display: flex; align-items: center; gap: 8px; }
  .ar-mes-t { display: flex; flex-direction: column; line-height: 1.15; }
  .ar-mes-n { text-transform: capitalize; }
  .ar-mes-a { font-family: var(--ff-ui); font-weight: 400; font-size: 12px; color: var(--muted); }
  /* Barra del Resumen + el número, alineados en una línea. */
  .ar-barra { display: flex; align-items: center; gap: 8px; }
  .ar-barra > :global(.cg-nivel) { flex: 1 1 auto; min-width: 0; margin: 0; }
  .ar-barra > :global(.cg-nivel) :global(.cg-nivel-cap) { display: none; }
  .ar-n { flex: none; min-width: 2.2em; text-align: right; font-family: var(--ff-dato); font-size: 13px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .ar-n-g { font-size: 16px; font-weight: 700; color: var(--dark); }
  .ar-mes::before { content: "▸"; font-size: 11px; color: var(--muted); transition: transform .15s; }
  .ar-fila[open] .ar-mes::before { transform: rotate(90deg); }
  .ar-hito { color: var(--naranja); font-size: 14px; }
  .ar-num { text-align: right; font-family: var(--ff-dato); font-variant-numeric: tabular-nums; }
  .ar-score { font-weight: 700; font-size: 16px; color: var(--dark); display: flex; justify-content: flex-end; align-items: center; gap: 8px; }
  .ar-c { text-align: left; }
  .ar-celda { display: block; height: 28px; border-radius: 3px; background: var(--bd); }
  .ar-celda.sem-verde { background: var(--sem-verde); }
  .ar-celda.sem-amarillo { background: var(--sem-amarillo); }
  .ar-celda.sem-naranja { background: var(--sem-naranja); }
  .ar-celda.sem-rojo { background: var(--sem-rojo); }
  .ar-fila .ar-riesgo { font-size: 14px; color: var(--dark); }
  .ar-fila .ar-delta { font-size: 13px; color: var(--muted); }
  .ar-delta .sube { color: var(--naranja); }
  .ar-delta .baja { color: var(--verde); }
  .ar-punto { display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: var(--bd); flex: none; }
  .ar-punto.sem-verde { background: var(--sem-verde); }
  .ar-punto.sem-amarillo { background: var(--sem-amarillo); }
  .ar-punto.sem-naranja { background: var(--sem-naranja); }
  .ar-punto.sem-rojo { background: var(--sem-rojo); }

  .ar-detalle { padding: 6px 12px 20px 30px; background: var(--bg-tint); }
  .ar-titular { margin: 0 0 12px; font-size: 16px; line-height: 1.6; color: var(--dark); }
  .ar-cint { list-style: none; margin: 0 0 12px; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 8px 24px; }
  .ar-cint li { display: flex; align-items: center; gap: 8px; font-size: 14px; }
  .ar-cint-n { font-weight: 700; color: var(--dark); }
  .ar-cint-l { color: var(--muted); }
  .ar-cambios { margin: 0 0 12px; font-size: 14px; color: var(--dark); }
  .ar-pie { margin: 0; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; font-size: 13px; color: var(--muted); }
  .ar-ver { font-weight: 700; font-size: 15px; color: var(--teal-ink); }
  .ar-sin-pagina { font-size: 14px; color: var(--muted); }

  /* Celular: mes, tensión y las cuatro celdas; el resto va al desplegable. */
  @media (max-width: 720px) {
    /* Celular: el mes y la barra general; los cuatro cinturones van al desplegable. */
    .ar-cab, .ar-fila > summary { grid-template-columns: 116px 1fr; gap: 0 10px; padding-left: 8px; padding-right: 8px; }
    .ar-franja { grid-template-columns: repeat(2, 1fr); }
    .ar-riesgo, .ar-delta, .ar-c { display: none; }
    .ar-mes { font-size: 15px; }
    .ar-celda { height: 22px; }
    .ar-franja-mes { padding: 10px 2px 8px; }
    .ar-detalle { padding-left: 14px; }
  }
</style>
