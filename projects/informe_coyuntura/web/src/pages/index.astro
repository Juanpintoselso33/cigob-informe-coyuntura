---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Bluf from "../components/Bluf.astro";
import MarcoTension from "../components/MarcoTension.astro";
import CinturonCard from "../components/CinturonCard.astro";
import SemaforoLeyenda from "../components/SemaforoLeyenda.astro";
import Evolucion from "../components/Evolucion.astro";
import Footer from "../components/Footer.astro";
import IndicadorModal from "../components/IndicadorModal.astro";
import { informe, CINTURONES } from "../lib/datos.ts";
---
<Layout title="Monitor del Plan de Gobierno · CiGob">
  <Nav />
  <Hero />
  <main class="cg-main">
    <Bluf />
    <MarcoTension />
    <section class="cg-section">
      <div class="cg-section-head">
        <p class="cg-eyebrow">Diagnóstico por capa</p>
        <h2 class="cg-h2">Los cinturones, hoy</h2>
        <p class="cg-h2-sub">Cada card: la tensión del cinturón y el peso de sus dimensiones.</p>
      </div>
      <SemaforoLeyenda />
      <div class="cg-grid cg-grid--4">
        {CINTURONES.map(c => (
          <CinturonCard slug={c.slug} nombre={c.nombre} sub={c.sub} cinturon={informe.cinturones[c.key]} />
        ))}
      </div>
    </section>
    <Evolucion />
    {/* «Lectura cruzada · Tensión sistémica» (TensionPanel + Recomendaciones)
        retirada de la portada a pedido de Juan, 7-oct-2026. Los componentes se
        borraron con ella; si alguna vez vuelve, sale de `git show`. */}
    {/* Archivo retirado hasta que exista al menos una edición anterior
        (revisión adversarial 2026-07-11: mostraba solo la edición vigente
        con un placeholder — hemeroteca sin hemeroteca). Reincorporar con
        la edición de agosto 2026. */}
    {/* "Cómo se construye" retirado de la portada (ADR-0320): repetía
        /metodologia, que Nav y Footer ya enlazan. El componente se borró
        con él; si alguna vez vuelve, sale de `git show`. */}
  </main>
  <Footer />
  <IndicadorModal />
</Layout>
