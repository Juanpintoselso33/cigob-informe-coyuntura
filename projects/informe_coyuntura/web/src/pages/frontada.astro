---
// Frontada pública "punta del iceberg" (PROVISIONAL, ruta /frontada).
// La coyuntura leída como el chequeo médico de un cuerpo: cada cinturón es
// un sistema/órgano y su color es su estado de salud. Datos VIVOS del
// snapshot (informe.json); verdict/tally/resumen se derivan del tablero
// (patrón BLUF, nunca quedan viejos). El delta "vs mes anterior" no se
// muestra: no hay edición previa todavía (el archivo vuelve en agosto 2026).
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { informe, CINTURONES, verdictDeCinturon, mesLegible } from "../lib/datos.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const coma = (n: number) => n.toFixed(1).replace(".", ",");
const REST = 0.62;

// Orden de lectura y mapeo cinturón → parte del cuerpo. La `line` describe
// QUÉ mide el sistema (perenne): el número y el color dicen el estado.
const ORDEN = ["politica", "vida_cotidiana", "gestion", "macro", "espiritu_epoca"] as const;
type Key = (typeof ORDEN)[number];
const MAP: Record<Key, { id: string; part: string; line: string }> = {
  politica:       { id: "nervous", part: "Sistema nervioso", line: "El sistema que coordina los poderes y procesa los conflictos del gobierno." },
  vida_cotidiana: { id: "heart",   part: "Corazón y aorta",  line: "El pulso del país: los precios, el salario y la calle, lo que se siente en el bolsillo." },
  gestion:        { id: "liver",   part: "Hígado",           line: "La máquina que metaboliza y ejecuta las reformas del Estado." },
  macro:          { id: "muscle",  part: "Músculo",          line: "La fuerza que sostiene la economía grande: precios, reservas y actividad." },
  espiritu_epoca: { id: "skin",    part: "Piel",             line: "La superficie que refleja el humor social y las ganas de quedarse o irse del país." },
};

// Semáforo del informe (dashboard.css :root) — mismos hex que el resto del tablero
const C:    Record<string, string> = { verde: "#16A34A", amarillo: "#CA8A04", rojo: "#DC2626" };
const INK:  Record<string, string> = { verde: "#0F7A38", amarillo: "#8A5D04", rojo: "#B01B1B" };
const SOFT: Record<string, string> = { verde: "#DCFCE7", amarillo: "#FEF3C7", rojo: "#FEE2E2" };
const LABEL:Record<string, string> = { verde: "Saludable", amarillo: "Alerta", rojo: "En crisis" };

const SYS = ORDEN.map((key) => {
  const meta = CINTURONES.find((c) => c.key === key)!;
  const c = informe.cinturones[key];
  const st = verdictDeCinturon(c.estado);
  return {
    id: MAP[key].id, part: MAP[key].part, belt: meta.nombre, slug: meta.slug,
    score: coma(c.score), scoreN: c.score, st, line: MAP[key].line,
    href: `${base}/${meta.slug}`,
  };
});
const byId = Object.fromEntries(SYS.map((s) => [s.id, s])) as Record<string, (typeof SYS)[number]>;

const DEFAULT = "heart";
const sel = byId[DEFAULT];

// Recuento y síntesis derivados de los datos ────────────────────────────
const g = SYS.filter((s) => s.st === "verde").length;
const a = SYS.filter((s) => s.st === "amarillo").length;
const r = SYS.filter((s) => s.st === "rojo").length;
const nTense = a + r;
const masTenso = [...SYS].sort((x, y) => y.scoreN - x.scoreN)[0];
const nombresList = (xs: string[]) =>
  xs.length === 0 ? "" : xs.join(", ").replace(/, ([^,]*)$/, " y $1");
const beltsSt = (pred: (s: (typeof SYS)[number]) => boolean) =>
  SYS.filter(pred).map((s) => s.belt.toLowerCase());

const verdictHtml = nTense === 0
  ? `Los cinco sistemas del organismo <span class="hl">funcionan sin sobrecarga</span> este mes.`
  : `Hoy el organismo muestra <span class="hl">${nTense} ${nTense === 1 ? "sistema" : "sistemas"} en tensión</span> y ${g} ${g === 1 ? "estable" : "estables"}. El que más acusa el esfuerzo del mes es ${masTenso.part.toLowerCase()} — ${masTenso.belt}.`;

const verdes = beltsSt((s) => s.st === "verde");
const tensos = beltsSt((s) => s.st !== "verde");
const resumenHtml = verdes.length === 0
  ? `La tensión se reparte por todo el organismo este mes. Esta es la foto de tapa: el detalle —los cinco sistemas, indicador por indicador— vive en el informe completo.`
  : tensos.length === 0
  ? `Los cinco sistemas se sostienen sin sobrecarga. Esta es la foto de tapa: el detalle —los cinco sistemas, indicador por indicador— vive en el informe completo.`
  : `Hoy sostienen al cuerpo <b>${nombresList(verdes)}</b>, mientras la tensión se concentra en <b>${nombresList(tensos)}</b>. Esta es la foto de tapa: el detalle —los cinco sistemas, indicador por indicador— vive en el informe completo.`;

const tallyHtml =
  `<b>${g}</b> saludables <span class="sep">·</span> <b>${a}</b> en observación <span class="sep">·</span> ` +
  (r > 0 ? `<b>${r}</b> en crisis` : `ninguno en crisis`);

const gd = informe.generated_at.slice(0, 10).split("-");
const fechaAct = `${gd[2]}/${gd[1]}/${gd[0]}`;
const eyebrow = `Informe de coyuntura · CiGob · ${mesLegible(informe.period)}`;
---
<Layout title="Gobernar la tensión · Informe de Coyuntura CiGob">
  <Nav />
  <main class="cg-main frontada">
    <header class="fr-head">
      <p class="cg-eyebrow">{eyebrow}</p>
      <h1 class="fr-h1">Gobernar la tensión: <em>el chequeo del cuerpo del gobierno.</em></h1>
      <p class="lead">Ningún gobierno puede cuidar todo al mismo tiempo. Este informe sigue, mes a mes, <b>qué parte del cuerpo del gobierno se fortalece y cuál se sacrifica</b> para lograrlo — leyendo la coyuntura como cinco sistemas de un mismo organismo.</p>
    </header>

      <div class="clinic" id="clinic">
        <div class="stage">
          <span class="stage-tag">El chequeo del mes</span>
          <div class="figwrap">
            <svg class="figure" viewBox="-40 -680 970 2280" role="group" aria-label="Cuerpo del gobierno: los cinco sistemas" preserveAspectRatio="xMidYMid meet">
