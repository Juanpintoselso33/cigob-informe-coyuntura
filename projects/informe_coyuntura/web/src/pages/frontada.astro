                <circle class="hit" cx="256" cy="256" r="120"></circle>
              </g></g>

              <!-- HÍGADO = hígado (Delapouite, CC BY 3.0) -->
              <g transform="translate(400,131) scale(0.43)"><g class="organ" data-id="liver" style={`opacity:${REST}`}>
                <path class="sil" style={`fill:${C[byId.liver.st]}`} d="M154.13 98.45c-74.523-.454-118.57 44.693-124.821 87.952-13.777 104.53-24.78 197.596 42.572 226.59 21.234 9.14 139.689-96.135 223.23-119.239 10.255-63.758 9.712-95.298 3.509-157.142 0 0-3.245-18.8-17.582-21.94-29.596-6.482-80.816-16.355-126.909-16.22zm267.935 10.313c-30.34-.091-65.864 3.56-95.367 9.5-6.687 1.347-10.656 15.303-9.916 19.024 5.8 59.214 6.503 87.53-2.395 149.486 165.98-69.253 180.409-116.413 178.531-136.756-2.967-32.153-33.145-41.14-70.853-41.254zM284.659 314.628c-39.357 14.62-79.953 40.882-113.676 64.54 20.086 5.945 56.674 6.638 74.525-3.397 18.28-15.838 34.462-37.393 39.15-61.143z"></path>
                <circle class="hit" cx="256" cy="256" r="210"></circle>
              </g></g>

              <!-- MÚSCULO = vientre muscular anatómico (dibujo propio) sobre el muslo -->
              <g transform="translate(245,585) scale(1.02)"><g class="organ" data-id="muscle" style={`opacity:${REST}`}>
                <path class="sil" style={`fill:${C[byId.muscle.st]}`} d="M85 6 C 108 6 118 26 118 52 C 150 96 148 170 122 214 C 112 240 106 280 98 314 L 72 314 C 64 280 58 240 48 214 C 22 170 20 96 52 52 C 52 26 62 6 85 6 Z"></path>
                <path class="fib" d="M85 48 C 66 120 66 250 78 300"></path>
                <path class="fib" d="M85 48 C 104 120 104 250 92 300"></path>
                <path class="fib" d="M85 56 C 44 132 48 235 74 288"></path>
                <path class="fib" d="M85 56 C 126 132 122 235 96 288"></path>
                <circle class="hit" cx="85" cy="160" r="165"></circle>
              </g></g>

              <!-- PIEL = contorno -->
              <use href="#body" class="contour" id="contour" style={`stroke:${C[byId.skin.st]}`}></use>
              <use href="#body" class="hit" id="skinHit" style="fill:none;stroke:#000;stroke-width:34;opacity:0;cursor:pointer" data-id="skin"></use>

              <line class="scan" id="scanLine" x1="-60" y1="-680" x2="950" y2="-680"></line>
            </svg>
          </div>
        </div>

        <div class="panel">
          <p class="panel-head">Diagnóstico del sistema</p>
          <p class="verdict" id="verdict" set:html={verdictHtml}></p>
          <div class="diag" id="diag" style={`--dot:${C[sel.st]};--dot-ink:${INK[sel.st]};--dot-soft:${SOFT[sel.st]}`}>
            <div class="diag-top">
              <span class="diag-part" id="dPart">{sel.part}</span>
              <span class="diag-belt" id="dBelt">· {sel.belt}</span>
              <span class="diag-status" id="dStatus"><span class="d"></span><span id="dStatusTxt">{LABEL[sel.st]}</span></span>
            </div>
            <p class="diag-line" id="dLine">{sel.line}</p>
            <div class="diag-metrics">
              <div class="metric"><div class="n" id="dScore">{sel.score} <small>/10</small></div><div class="l">Tensión / 10</div></div>
            </div>
            <a class="diag-cta" id="dCta" href={sel.href}><span id="dCtaTxt">Ver el detalle de {sel.belt}</span> <span class="arw">→</span></a>
          </div>
          <div class="legend" id="legend">
            {SYS.map((s) => (
              <button class="lg-row" data-id={s.id} type="button" style={`--d-ink:${INK[s.st]};--d-soft:${SOFT[s.st]}`}>
                <span class="lg-dot" style={`background:${C[s.st]}`}></span>
                <span class="lg-part">{s.part}</span><span class="lg-belt">· {s.belt}</span>
                <span class="lg-status">{LABEL[s.st]}</span><span class="lg-score">{s.score}</span>
              </button>
            ))}
          </div>
          <p class="tally" id="tally" set:html={tallyHtml}></p>
        </div>
      </div>

      <div class="resumen">
        <p class="rh">Resumen ejecutivo</p>
        <p set:html={resumenHtml}></p>
      </div>

      <div class="ctas">
        <a class="btn primary" href={`${base}/`}>Ver el informe completo <span aria-hidden="true">→</span></a>
        <a class="btn ghost" href={`${base}/metodologia`}>Ir al anexo metodológico</a>
      </div>

      <p class="credit">Actualizado el {fechaAct}. Silueta: <a href="https://commons.wikimedia.org/wiki/File:Human_body_silhouette.svg">M. Häggström</a> (dominio público). Órganos: <a href="https://game-icons.net">game-icons.net</a> (Lorc, Delapouite — CC BY 3.0).</p>
  </main>
  <Footer />
</Layout>

<style>
  /* Alineado al sistema visual del informe: usa los tokens globales de
     dashboard.css (neutrales verdosos, radios, sombras, semáforo y los
     colores por cinturón). Sin paleta propia. */
  .frontada{padding-top:30px; line-height:1.55}
  .frontada *{box-sizing:border-box}
  .fr-head{max-width:960px; margin:0 0 30px}
  .fr-h1{font-weight:800; font-size:clamp(30px,4.4vw,50px); line-height:1.1;
    letter-spacing:-.02em; color:var(--dark); margin:0; text-wrap:balance}
  .fr-h1 em{font-style:italic; color:var(--cta)}
  .lead{font-size:16.5px; color:var(--muted); max-width:72ch; margin:16px 0 0; line-height:1.62}
  .lead b{font-weight:700; color:var(--dark)}

  /* Card principal con el mismo tratamiento que .cg-bluf: borde superior con
     los cinco colores de cinturón. */
  .clinic{display:grid; grid-template-columns:minmax(0,.92fr) minmax(0,1.08fr);
    background:var(--paper); border:1px solid var(--bd); border-radius:var(--radius-big);
    box-shadow:var(--shadow-card); overflow:hidden; position:relative}
  .clinic::before{content:''; position:absolute; top:0; left:0; right:0; height:4px; z-index:3;
    background:linear-gradient(90deg,var(--c-macro),var(--c-politica),var(--c-vida),var(--c-gestion),var(--c-humor))}
  .stage{position:relative; display:flex; min-height:560px;
    background:linear-gradient(180deg,#fff 0%,var(--bg-page) 100%);
    border-right:1px solid var(--bd-soft)}
  .stage-tag{position:absolute; top:20px; left:22px; z-index:2;
    font-size:11px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; color:var(--teal)}
  .figwrap{flex:1; display:flex; align-items:center; justify-content:center; padding:40px 10px 22px}
  .figure{width:100%; height:auto; max-height:520px; display:block; overflow:visible}

  .body-base{fill:var(--teal-soft); stroke:var(--teal-dark); stroke-width:6; stroke-linejoin:round}
  .contour{fill:none; stroke-width:12; opacity:0; transition:opacity .4s; pointer-events:none;
    stroke-linejoin:round}
  .organ{cursor:pointer; transition:opacity .35s ease, transform .35s ease; transform-box:fill-box; transform-origin:center}
  .organ .sil{transition:fill .3s; stroke:#fff; stroke-width:5; stroke-linejoin:round; paint-order:stroke; pointer-events:none}
  .organ .fib{fill:none; stroke:#fff; stroke-width:9; stroke-linecap:round; opacity:.55; pointer-events:none}
  .organ .hit{fill:#000; opacity:0}
  .clinic.focusing .organ:not(.hot){opacity:.14}
  .clinic.focusing .organ.hot{transform:scale(1.06)}
  .clinic.focusing.hot-skin .body-base{fill:#EAF3FB}
  .scan{stroke:var(--teal); stroke-width:3; opacity:0}

  .panel{padding:30px 30px 26px; display:flex; flex-direction:column}
  .panel-head{font-size:11px; font-weight:800; letter-spacing:.12em; text-transform:uppercase;
    color:var(--teal); margin:0 0 12px}
  .verdict{font-weight:800; font-size:clamp(19px,1.6vw,23px); line-height:1.3;
    letter-spacing:-.012em; color:var(--dark); margin:0 0 22px}
  .verdict :global(.hl){background:linear-gradient(transparent 62%, var(--teal-soft) 62%); padding:0 2px}

  .diag{border:1px solid var(--bd); border-radius:var(--radius-card); padding:19px 20px 17px;
    background:var(--paper); position:relative; overflow:hidden; box-shadow:var(--shadow-card)}
  .diag::before{content:""; position:absolute; left:0; top:0; bottom:0; width:4px; background:var(--dot)}
  .diag-top{display:flex; align-items:baseline; gap:9px; flex-wrap:wrap; padding-left:6px}
  .diag-part{font-size:26px; font-weight:800; color:var(--dark); line-height:1; letter-spacing:-.015em}
  .diag-belt{font-size:13px; color:var(--muted); font-weight:600}
  .diag-status{margin-left:auto; display:inline-flex; align-items:center; gap:7px;
    font-size:11px; font-weight:800; letter-spacing:.06em; text-transform:uppercase;
    padding:5px 12px; border-radius:999px; color:var(--dot-ink); background:var(--dot-soft)}
  .diag-status .d{width:8px; height:8px; border-radius:50%; background:var(--dot)}
  /* Altura reservada: las descripciones tienen largos distintos (el hígado
     entra en 1 línea, el resto en 2). Sin esto, cambiar de sistema achica la
     tarjeta, se acorta la fila del grid y la figura —centrada— salta. */
  .diag-line{margin:12px 0 0; padding-left:6px; font-size:14.5px; color:var(--muted); line-height:1.5;
    min-height:3em}
  .diag-metrics{display:flex; gap:26px; margin:16px 0 2px; padding-left:6px; align-items:flex-end}
  .metric .n{font-family:'JetBrains Mono',ui-monospace,monospace; font-size:27px; font-weight:700;
    color:var(--dark); line-height:1; font-variant-numeric:tabular-nums}
  .metric .n small{font-size:14px; color:var(--muted); font-weight:500}
  .metric .l{font-size:10px; font-weight:700; color:var(--muted); text-transform:uppercase;
    letter-spacing:.08em; margin-top:6px}
  .diag-cta{display:inline-flex; align-items:center; gap:6px; margin-top:17px; padding-left:6px;
    font-size:13.5px; font-weight:800; color:var(--cta-dark); text-decoration:none}
  .diag-cta .arw{transition:transform .2s} .diag-cta:hover .arw{transform:translateX(3px)}

  .legend{margin:20px 0 0; border-top:1px solid var(--bd-soft); padding-top:12px}
  .lg-row{display:flex; align-items:center; gap:12px; width:100%; text-align:left;
    padding:9px 8px; border:0; background:none; border-radius:10px; cursor:pointer;
    font-family:inherit; color:inherit; transition:background .15s}
  .lg-row:hover,.lg-row:focus-visible{background:var(--bg-page); outline:none}
  .lg-row.active{background:var(--bg-page)}
  .lg-row.active .lg-part{color:var(--teal-dark)}
  .lg-dot{width:11px; height:11px; border-radius:50%; flex:none; box-shadow:0 0 0 3px var(--d-soft)}
  .lg-part{font-weight:700; font-size:14px; color:var(--dark)}
  .lg-belt{font-size:12px; color:var(--muted); margin-left:1px}
  .lg-status{margin-left:auto; font-size:11px; font-weight:800; letter-spacing:.05em;
    text-transform:uppercase; color:var(--d-ink)}
  .lg-score{font-family:'JetBrains Mono',ui-monospace,monospace; font-size:12.5px;
    color:var(--muted-soft); width:34px; text-align:right; font-variant-numeric:tabular-nums}

  .tally{margin:14px 4px 0; font-size:12.5px; color:var(--muted); display:flex; gap:6px; flex-wrap:wrap}
  .tally :global(b){color:var(--dark); font-weight:800} .tally :global(.sep){color:var(--muted-soft)}

  .resumen{margin:34px 0 0; border-left:3px solid var(--cta); padding:2px 0 2px 20px; max-width:78ch}
  .resumen .rh{font-size:11px; font-weight:800; letter-spacing:.12em; text-transform:uppercase;
    color:var(--teal); margin:0 0 10px}
  .resumen p{margin:0; font-size:16.5px; line-height:1.62; color:var(--muted)}
  .resumen p :global(b){font-weight:700; color:var(--dark)}

  .ctas{display:flex; gap:12px; flex-wrap:wrap; margin:28px 0 0}
  .btn{display:inline-flex; align-items:center; gap:8px; font-size:14px; font-weight:700;
    padding:12px 22px; border-radius:12px; text-decoration:none; cursor:pointer;
    border:1.5px solid; transition:transform .12s, background .2s, border-color .2s}
  .btn.primary{background:var(--teal); border-color:var(--teal); color:#fff}
  .btn.primary:hover{background:var(--teal-dark); border-color:var(--teal-dark); transform:translateY(-1px)}
  .btn.ghost{background:var(--paper); border-color:var(--bd); color:var(--dark)}
  .btn.ghost:hover{border-color:var(--teal); color:var(--teal-dark); transform:translateY(-1px)}

  .credit{margin:30px 0 0; font-size:11.5px; color:var(--muted-soft); line-height:1.6}
  .credit a{color:var(--muted)}

  @media (max-width:840px){
    .clinic{grid-template-columns:1fr}
    .stage{border-right:0; border-bottom:1px solid var(--bd-soft); min-height:440px}
    .figure{max-height:410px}
    .panel{padding:24px 20px 22px}
    /* en angosto las descripciones envuelven en 3 líneas: reservar una más */
    .diag-line{min-height:4.5em}
  }
  @keyframes beat{0%,100%{transform:scale(1)}14%{transform:scale(1.08)}28%{transform:scale(1)}42%{transform:scale(1.05)}56%{transform:scale(1)}}
  .organ.beat{animation:beat 1.7s ease-in-out infinite}
  @media (prefers-reduced-motion:reduce){.frontada *{animation:none!important; transition:none!important}}
</style>

<script define:vars={{ SYS, DEFAULT }}>
  (function () {
    var C = { verde: "#16A34A", amarillo: "#CA8A04", rojo: "#DC2626" };
    var INK = { verde: "#0F7A38", amarillo: "#8A5D04", rojo: "#B01B1B" };
    var SOFT = { verde: "#DCFCE7", amarillo: "#FEF3C7", rojo: "#FEE2E2" };
    var LABEL = { verde: "Saludable", amarillo: "Alerta", rojo: "En crisis" };
    var byId = {}; SYS.forEach(function (s) { byId[s.id] = s; });
    var clinic = document.getElementById("clinic");
    var REST = 0.62;
    var el = {
      part: document.getElementById("dPart"), belt: document.getElementById("dBelt"),
      statusTxt: document.getElementById("dStatusTxt"), line: document.getElementById("dLine"),
      score: document.getElementById("dScore"), cta: document.getElementById("dCta"),
      ctaTxt: document.getElementById("dCtaTxt"), diag: document.getElementById("diag"),
    };
    var selected = DEFAULT;

    function render(id) {
      var s = byId[id]; if (!s) return;
      el.diag.style.setProperty("--dot", C[s.st]);
      el.diag.style.setProperty("--dot-ink", INK[s.st]);
      el.diag.style.setProperty("--dot-soft", SOFT[s.st]);
      el.part.textContent = s.part; el.belt.textContent = "· " + s.belt;
      el.statusTxt.textContent = LABEL[s.st]; el.line.textContent = s.line;
      el.score.innerHTML = s.score + ' <small>/10</small>';
      el.cta.setAttribute("href", s.href); el.ctaTxt.textContent = "Ver el detalle de " + s.belt;
      document.querySelectorAll(".lg-row").forEach(function (r) {
        r.classList.toggle("active", r.getAttribute("data-id") === id);
      });
    }
    function paintOrgans(activeId) {
      document.querySelectorAll(".organ").forEach(function (o) {
        o.classList.toggle("hot", o.getAttribute("data-id") === activeId);
      });
      document.getElementById("contour").style.opacity = activeId === "skin" ? 1 : 0;
    }
    function hot(id) { clinic.classList.add("focusing"); clinic.classList.toggle("hot-skin", id === "skin"); paintOrgans(id); render(id); }
    function cool() { clinic.classList.remove("focusing", "hot-skin"); paintOrgans(selected); render(selected); }

    function wire(nodes) {
      nodes.forEach(function (node) {
        if (!node) return;
        var id = node.getAttribute("data-id");
        if (node.tagName.toLowerCase() !== "button") {
          node.setAttribute("tabindex", "0"); node.setAttribute("role", "button");
          node.setAttribute("aria-label", (byId[id] ? byId[id].part + " — " + byId[id].belt : id));
        }
        node.addEventListener("mouseenter", function () { hot(id); });
        node.addEventListener("mouseleave", cool);
        node.addEventListener("focus", function () { hot(id); });
        node.addEventListener("blur", cool);
        node.addEventListener("click", function () { selected = id; cool(); });
        node.addEventListener("keydown", function (e) {
          if (e.key === "Enter" || e.key === " ") { e.preventDefault(); selected = id; cool(); }
        });
      });
    }
    wire(Array.prototype.slice.call(document.querySelectorAll(".organ")));
    wire([document.getElementById("skinHit")]);
    wire(Array.prototype.slice.call(document.querySelectorAll(".lg-row")));

    cool();

    var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion:reduce)").matches;
    if (!reduce) {
      var line = document.getElementById("scanLine");
      document.querySelectorAll(".organ").forEach(function (o) { o.style.transition = "none"; o.style.opacity = 0; });
      var t0 = null, DUR = 1700, y0 = -680, y1 = 1580;
      line.style.opacity = 1;
      var pos = { nervous: -515, heart: -22, liver: 241, muscle: 748 };
      function step(ts) {
        if (!t0) t0 = ts;
        var p = Math.min((ts - t0) / DUR, 1), y = y0 + p * (y1 - y0);
        line.setAttribute("y1", y); line.setAttribute("y2", y);
        document.querySelectorAll(".organ").forEach(function (o) {
          var id = o.getAttribute("data-id");
          if (y > pos[id]) { o.style.transition = "opacity .5s"; o.style.opacity = (id === selected ? 1 : REST); }
        });
        if (p < 1) requestAnimationFrame(step);
        else { line.style.transition = "opacity .5s"; line.style.opacity = 0;
          var h = document.getElementById("heartOrgan"); if (h) h.classList.add("beat"); }
      }
      requestAnimationFrame(step);
    } else {
      var h = document.getElementById("heartOrgan"); if (h) h.classList.add("beat");
    }
  })();
</script>
