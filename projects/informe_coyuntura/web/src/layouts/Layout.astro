---
const { title = "Realidad Política Argentina · Observatorio CIGOB" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, ""); // "/biblitotecario-ai/informe"
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      /* Modo embebido: si el informe corre dentro de un iframe (ej. cigob.org/Wix),
         el header/menú de CiGob ya está arriba → marcamos <html> para ocultar la
         cromática propia redundante (logo, footer institucional). Corre antes de
         pintar para evitar flash. El try/catch cubre el iframe cross-origin. */
      try { if (window.self !== window.top) document.documentElement.classList.add("embedded"); }
      catch (e) { document.documentElement.classList.add("embedded"); }
    </script>
    <link rel="icon" type="image/png" href={`${base}/logo-cigob.png`} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,600&family=JetBrains+Mono:wght@400;500;700&display=swap" />
    <link rel="stylesheet" href={`${base}/dashboard.css`} />
    <link rel="stylesheet" href={`${base}/overrides.css`} />
  </head>
  <body>
    <slot />
    <script is:inline>
      /* Height-poster (Plan B del embed en cigob.org/Wix): cuando el informe
         corre dentro de un iframe, avisa su altura real al contenedor vía
         postMessage para que el iframe se estire y no haya doble scroll.
         El contenedor escucha {type: "cigob-informe-height"} (snippet Velo
         en Wix o listener plano — ver test-embed-wix.html). Si el contenedor
         no escucha, no pasa nada: queda el alto fijo del iframe (Plan A). */
      try {
        if (window.self !== window.top) {
          var postAltura = function () {
            parent.postMessage({
              type: "cigob-informe-height",
              height: document.documentElement.scrollHeight,
            }, "*");
          };
          window.addEventListener("load", postAltura);
          if (window.ResizeObserver) {
            new ResizeObserver(postAltura).observe(document.body);
          }
        }
      } catch (e) { /* cross-origin estricto: sin auto-resize */ }
    </script>
  </body>
</html>
