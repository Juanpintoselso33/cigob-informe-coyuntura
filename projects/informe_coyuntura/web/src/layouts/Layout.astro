---
import Analytics from "@vercel/analytics/astro";
import MuroAcceso from "../components/MuroAcceso.astro";

const { title = "Realidad Política Argentina · Observatorio CIGOB" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, ""); // "/biblitotecario-ai/informe"

// GA4 se inyecta solo si PUBLIC_GA_ID está cargada (Vercel → Settings → Environment
// Variables). Sin la variable el sitio no pide gtag.js ni escribe cookies.
// Se valida la forma G-XXXXXXXXXX: una variable mal cargada no debe terminar
// interpolada dentro del <script>.
const rawGaId = import.meta.env.PUBLIC_GA_ID?.trim();
const gaId = rawGaId && /^G-[A-Z0-9]+$/i.test(rawGaId) ? rawGaId : undefined;

// Muro de acceso (ADR-0342). PUBLIC_MURO=0 lo apaga: es lo que usa el
// seguimiento diario interno y el informe en un solo archivo. En la portada
// salta al salir del hero; en el resto, al entrar.
const muro = import.meta.env.PUBLIC_MURO?.trim() !== "0";
// Seguimiento diario interno (punto 8 de la reunión del 6-oct, ADR-0347): el
// mismo sitio con los datos de cada noche, en una URL larga que no se difunde.
// Una URL difícil de adivinar no es privada, así que al menos no se indexa.
const esDiario = import.meta.env.PUBLIC_SITIO?.trim() === "diario";
const esPortada = Astro.url.pathname.replace(/\/$/, "") === base;
const modoMuro = esPortada ? "al-bajar" : "inmediato";
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="192x192" href={`${base}/favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}/favicon.png`} />
    <title>{title}</title>
    {esDiario && <meta name="robots" content="noindex, nofollow" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Las cuatro familias del Manual de Marca que existen en Google Fonts,
         cada una con los pesos que el manual le asigna y ni uno más: Lora
         (títulos), Lato (cuerpos, con itálica real para <em>), Inter (interfaz)
         y Work Sans (datos). La quinta, Garet, es comercial y se sirve desde
         public/fuentes/ — ver marca.css. -->
    <link rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600&family=Lato:ital,wght@0,400;0,700;1,400&family=Lora:wght@400;700&family=Work+Sans:wght@400;700&display=swap" />
    <!-- marca.css define los tokens; dashboard.css los consume. El orden importa. -->
    <link rel="stylesheet" href={`${base}/marca.css`} />
    <link rel="stylesheet" href={`${base}/dashboard.css`} />
    <link rel="stylesheet" href={`${base}/overrides.css`} />
    <!-- SEMÁFORO — ÚNICA FUENTE DE VERDAD (nov-2026).
         dashboard.css no se puede tocar desde acá, así que los cuatro colores
         se definen ACÁ y pisan a los de esa hoja. `html:root` (y `html` delante
         de cada regla) les da más especificidad que la hoja original, así que
         ganan sin depender del orden en que se carguen.
         Reglas: (1) ningún componente escribe un hex del semáforo: usa
         var(--verde|--amarillo|--naranja|--rojo); (2) los tonos pálidos y la
         trama roja se DERIVAN del color base con color-mix, así que si cambia
         un color se mueven solos; (3) el semáforo no lleva transparencia: el
         mismo color se tiene que ver igual en la barra, el genoma y los puntos.
         El verde pasó de #16A34A a uno de la misma intensidad que el amarillo
         limón, el naranja franco y el rojo puro (pedido del 8-nov-2026). -->
    <style is:global>
      html:root {
        --verde:         #1FAE4B;
        --amarillo:      #FFD60A;
        --naranja:       #F76B15;
        --rojo:          #D00000;
        --verde-soft:    color-mix(in srgb, var(--verde) 20%, #fff);
        --amarillo-soft: color-mix(in srgb, var(--amarillo) 20%, #fff);
        --naranja-soft:  color-mix(in srgb, var(--naranja) 20%, #fff);
        --rojo-soft:     color-mix(in srgb, var(--rojo) 20%, #fff);
        --rojo-trama:    color-mix(in srgb, var(--rojo) 75%, #000);
      }
      /* Genoma: sin transparencia (se mezclaba con el fondo y cambiaba el tono)
         y trama roja derivada del rojo del semáforo. */
      html .cg-genoma-seg { opacity: 1; }
      html .cg-genoma-seg.sem-rojo {
        background: repeating-linear-gradient(45deg,
          var(--rojo), var(--rojo) 4px, var(--rojo-trama) 4px, var(--rojo-trama) 7px);
      }
      /* Barra de puntaje del modal: tenía el amarillo y el rojo viejos escritos. */
      html .cg-score-fill {
        background: linear-gradient(90deg, var(--verde) 0%, var(--amarillo) 50%, var(--rojo) 100%);
      }
      /* Variación de los mini-gráficos: tintes pálidos de la misma paleta. */
      html .cg-chart-mini-delta.up,
      html .cg-chart-mini-delta.empeora { background: var(--rojo-soft); }
      html .cg-chart-mini-delta.down,
      html .cg-chart-mini-delta.mejora  { background: var(--verde-soft); }
      /* Chip «suspendido» y píldora de estado: tenían mostaza y amarillo viejos.
         El texto va en tinta oscura (el amarillo limón no se lee como texto). */
      html .cg-suspendido-chip { border-color: var(--amarillo); color: #713F12; }
      html .cg-status-pill.is-signed .cg-status-dot { box-shadow: 0 0 0 3px color-mix(in srgb, var(--verde) 18%, transparent); }
      html .cg-status-pill.is-draft  .cg-status-dot { box-shadow: 0 0 0 3px color-mix(in srgb, var(--amarillo) 25%, transparent); }
    </style>
    {muro && (
      <script is:inline define:vars={{ modoMuro }}>
        // Antes de pintar: quien ya pasó el muro no lo ve; en modo inmediato,
        // el contenido no llega a verse sin tapar. Se reconoce por la cookie
        // `cigob_lector` (la escribe el servidor, api/_acceso.ts: Safari no la
        // borra a los 7 días) o, de respaldo, por el localStorage de antes.
        // `data-muro-via` le dice a MuroAcceso.astro por dónde se reconoció,
        // para renovar la cookie y medirlo. Las claves son las mismas que usa
        // MuroAcceso.astro.
        (function () {
          var html = document.documentElement, via = "";
          if (/(?:^|;\s*)cigob_lector=/.test(document.cookie)) via = "cookie";
          try {
            if (localStorage.getItem("cigob-muro-v1")) via = via ? "ambos" : "local";
            // La cruz lo cierra por el resto de la visita (sessionStorage).
            if (!via && sessionStorage.getItem("cigob-muro-cerrado")) via = "cerrado";
          } catch (e) {}
          if (via) { html.classList.add("muro-ok"); html.setAttribute("data-muro-via", via); }
          else if (modoMuro === "inmediato") html.classList.add("muro-activo");
        })();
      </script>
    )}
    {gaId && (
      <Fragment>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline set:html={`
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', '${gaId}');
        `}></script>
      </Fragment>
    )}
  </head>
  <body>
    <slot />
    {muro && <MuroAcceso modo={modoMuro} />}
    <Analytics />
  </body>
</html>
