---
import Analytics from "@vercel/analytics/astro";

const { title = "Realidad Política Argentina · Observatorio CIGOB" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, ""); // "/biblitotecario-ai/informe"

// GA4 se inyecta solo si PUBLIC_GA_ID está cargada (Vercel → Settings → Environment
// Variables). Sin la variable el sitio no pide gtag.js ni escribe cookies.
// Se valida la forma G-XXXXXXXXXX: una variable mal cargada no debe terminar
// interpolada dentro del <script>.
const rawGaId = import.meta.env.PUBLIC_GA_ID?.trim();
const gaId = rawGaId && /^G-[A-Z0-9]+$/i.test(rawGaId) ? rawGaId : undefined;
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="192x192" href={`${base}/favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}/favicon.png`} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Las cuatro familias del Manual de Marca que existen en Google Fonts,
         cada una con los pesos que el manual le asigna y ni uno más: Lora
         (títulos), Lato (cuerpos, con itálica real para <em>), Inter (interfaz)
         y Work Sans (datos). La quinta, Garet, es comercial y se sirve desde
         public/fuentes/ — ver marca.css. -->
    <link rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600&family=Lato:ital,wght@0,400;0,700;1,400&family=Lora:wght@400;700&family=Work+Sans:wght@400;700&display=swap" />
    <!-- marca.css define los tokens; dashboard.css los consume. El orden importa. -->
    <link rel="stylesheet" href={`${base}/marca.css`} />
    <link rel="stylesheet" href={`${base}/dashboard.css`} />
    <link rel="stylesheet" href={`${base}/overrides.css`} />
    {gaId && (
      <Fragment>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline set:html={`
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', '${gaId}');
        `}></script>
      </Fragment>
    )}
  </head>
  <body>
    <slot />
    <Analytics />
  </body>
</html>
