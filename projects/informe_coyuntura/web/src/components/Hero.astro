---
// El titular del informe se lee por la BARRA DE TENSIÓN, no por cuatro números.
//
// Antes había un párrafo institucional de seis líneas y una fila de cuatro
// stats numéricas (edición, cinturones en rojo, score /10, riesgo dominante).
// El lector tenía que leer para saber si el país está bien o mal. La barra
// contesta eso antes de leer nada; la bajada ya no narra el mes —eso pasó a
// ser la lectura editorial del BLUF— sino que dice qué es este producto.
// El encuadre conceptual del observatorio vive en /metodologia.
//
// La barra va de BANDA bajo el lead, no en una segunda columna: es ancha y
// baja, y metida en una columna propia quedaba apretada contra el título
// (ADR-0204). La aguja de arco que estaba antes sí pedía columna.
import { informe, cap, mesLegible,
         cinturonDominante, colorPorTension, LECTURA_SEMAFORO } from "../lib/datos.ts";
import NivelTension from "./NivelTension.astro";

const f = informe.generated_at;
const datosAl = `${f.slice(8, 10)}/${f.slice(5, 7)}/${f.slice(0, 4)}`;
// generated_at es la fecha del ARMADO del snapshot, no de todos los datos:
// cada fuente tiene su propio rezago, que sigue visible por indicador. Desde
// oct-2026 la línea del inicio muestra sólo la fecha (pedido editorial): salen
// la píldora de cinturones tensionados y el conteo de indicadores con rezago.

// El pie de la barra NOMBRA al cinturón dominante, no sólo al barbarismo
// (ADR-0237). "Riesgo dominante: Político" mandaba al lector a la card
// Política —3,3 y verde— cuando el que lo produce es Impacto social en 6,1:
// `politica` y `vida_cotidiana` comparten barbarismo. El veredicto era
// correcto y parecía contradecir a su propia tabla.
const dominante = cinturonDominante(informe);
// Sin número (ADR-0337): el cinturón dominante se nombra con la palabra de su
// tramo, igual que la barra que tiene arriba.
const colorDominante = dominante ? colorPorTension(dominante.score) : null;
const lecturaDominante = colorDominante ? LECTURA_SEMAFORO[colorDominante] : null;
const pieRiesgo = `Riesgo dominante: ${cap(informe.barbarismo_activo)}`
  + (dominante ? ` — ${dominante.nombre}${lecturaDominante ? ` (${lecturaDominante.toLowerCase()})` : ""}` : "");

---
<header class="cg-hero" id="top">
  <div class="cg-hero-inner cg-hero-inner--nivel">
    <div class="cg-hero-texto">
      <p class="cg-hero-eyebrow">Observatorio · Fundación CiGob · {mesLegible(informe.period)}</p>
      <h1 class="cg-hero-title">Gobernar la tensión: <em>monitor de viabilidad y restricciones del proyecto de gobierno del presidente Milei.</em></h1>
      <p class="cg-hero-lead">
        Monitor de evaluación de Proyectos de Gobierno basado en la metodología CIGOB-MATUS.
      </p>
      {/* Sólo la fecha. Toma la forma de la píldora que ocupaba este lugar
          (mismo borde, sombra y radio) para no dejar un texto suelto de 12px
          bajo un título de 64: la línea conserva su peso visual. */}
      <p class="cg-hero-meta">
        <span class="cg-status-pill cg-hero-fecha">
          Actualizado el <time datetime={f.slice(0, 10)}>{datosAl}</time>
        </span>
      </p>
    </div>
    <div class="cg-hero-nivel">
      <NivelTension
        tension={informe.score_global}
        titulo="Tensión general"
        tamano="grande"
        pie={pieRiesgo}
        ocultarLectura
      />
    </div>
  </div>
</header>

<style>
  .cg-hero-fecha {
    font-weight: 600;
    letter-spacing: .01em;
  }
  .cg-hero-fecha time {
    font-weight: 800;
    color: var(--dark);
    font-variant-numeric: tabular-nums;
  }
</style>
