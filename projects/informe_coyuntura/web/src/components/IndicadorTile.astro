---
import { presentacion, label, visualDe, badgeEstado, periodoDato, series, formatValor, num, semaforoDe, semaforoAriaLabel, UNIDADES_SERIE, UNIDADES_CORTAS } from "../lib/datos.ts";
import { DESCRIPCIONES } from "../lib/descripciones.ts";
import { chartPath } from "../lib/sparkline.ts";

// `compacto`: la variante de la página de cinturón. Deja el punto de color, el
// nombre y el valor, y saca la descripción y el chip de origen. No se pierde
// nada: el tile entero abre el modal, que trae la descripción completa, la
// fuente y la evolución. Sirve a las dos metas del rediseño a la vez —menos
// texto en la superficie, y el estado de TODOS los indicadores del cinturón
// visible junto en vez de repartido en cinco pantallas de scroll.
const { ikey, ind, slug, compacto = false } = Astro.props;
const pres = presentacion(ikey, ind);
const vis = visualDe(ikey, ind);
const badge = badgeEstado(ind);
// semaforoDe() no distingue "sin dato" de un color real (su contrato son
// 4 colores, no 5) — por eso el gate va acá, en el render: sin bloque
// `semaforo` publicado no hay punto, en vez de pintar uno que el indicador
// no se ganó. Le pasa a asistencia_directa (TDPS 100%, fuera del índice por
// saturado — ADR-0100): amarillo ahí leería "tensión media" sobre un logro.
const color = ind.semaforo?.color ? semaforoDe(ind) : null;
// Las ramas de origen y ausencia de universo van explícitas y
// no con un `else` de bolsa: cuando se sumó "Semiautomático" cayó en el
// catch-all y las cards semiautomáticas salían con `.estim`, o sea en itálica
// —la marca que el sitio reserva para las estimaciones—. El rótulo decía una
// cosa y el estilo otra.
const badgeCls = badge === "Automático" ? "auto"
  : badge === "Semiautomático" ? "semi"
  : badge === "Carga manual" ? "manual"
  : badge === "Sin universo" ? "sin-universo"
  : "estim";
// El chip muestra el período del dato en vez del rótulo "Automático" (que no
// informaba nada); manual/estimación conservan su rótulo — ahí el origen ES
// la información, y la fecha ya la aporta aclaracion() en el modal.
const chip = badge === "Automático" ? periodoDato(ikey, ind) : badge;
const chipTitle = badge === "Automático"
  ? `Actualización automática · dato a ${ind.fecha_dato}`
  : undefined;
const desc = DESCRIPCIONES[ikey]?.que ?? "";

// Cuando el visual es una barra de avance (gestión), el número grande es el
// avance, para que el headline y la barra coincidan. En el resto, el valor normal.
let headline = pres.texto;
let unidad = pres.unidad;
let micro = ikey === "eficacia_legislativa" && typeof ind.aprobados_n === "number" && typeof ind.enviados_n === "number" ? `${ind.aprobados_n} de ${ind.enviados_n} sancionados` : "";
if (vis.tipo === "barra" && vis.avance) {
  headline = formatValor(vis.pct);
  unidad = "%";
  micro = "avance";
}

// Salud: el porcentaje sin su total no se entiende, y la variante compacta no
// lleva el chip con el mes (auditoría externa, oct-2026).
const millones = (n: number) => `${num(n / 1e6)} M`;
const total = ikey === "libertad_opcion_salud" && typeof ind.derivados === "number" && typeof ind.usuarios_prepagas === "number"
  ? `${millones(ind.derivados)} de ${millones(ind.usuarios_prepagas)} usuarios de prepagas · ${periodoDato(ikey, ind)}` : "";
// En gestión el valor (avance, % o variación) y el puntaje del índice son dos
// números distintos, y los dos parecen porcentajes de cumplimiento: «avance
// 50» con «puntaje 55» confundía. Se dicen por separado.
const puntaje = slug === "gestion" && typeof ind.puntaje_banda === "number"
  && Math.abs(ind.puntaje_banda - Number(ind.valor)) >= 0.05
  ? `puntaje ${num(ind.puntaje_banda)} / 100` : "";

const sp = vis.tipo === "sparkline" ? chartPath(series[ikey] ?? [], 240, 44, 5) : null;
---
{/* Es un disparador de verdad: `role`, `tabindex` y nombre accesible. Antes
    era un <article> con un listener de click, o sea alcanzable sólo con mouse.
    Con la variante compacta eso pasó de defecto a bloqueo: la descripción y la
    fuente se fueron al modal, y quien navega con teclado se quedaba sin ninguna
    forma de llegar a ellas. Copia el patrón que ya usaban las cards de
    dimensión (cg-dim--clickable). */}
<article
  class:list={["cg-tile", `cg-tile--${slug}`, "cg-ind--clickable", { "cg-tile--compacto": compacto }]}
  data-indicador={ikey} data-cinturon={slug}
  role="button" tabindex="0"
  aria-label={`${label(ikey)}: ver qué mide, su fuente y su evolución`}>
  <div class="cg-tile-head">
    {color && (
      <span
        class:list={["cg-tile-dot", `sem-${color}`]}
        role="img"
        aria-label={semaforoAriaLabel(ind.semaforo)}
      ></span>
    )}
    <span class="cg-tile-name">{label(ikey)}</span>
    {!compacto && <span class:list={["cg-tile-badge", badgeCls]} title={chipTitle}>{chip}</span>}
  </div>
  {!compacto && desc && <p class="cg-tile-desc">{desc}</p>}
  <div class="cg-tile-value">
    <span class="cg-tile-num">{headline}</span>
    {unidad && <span class="cg-tile-unit">{unidad}</span>}
    {micro && <span class="cg-tile-micro">{micro}</span>}
  </div>
  {total && <p class="cg-tile-nota">{total}</p>}
  {puntaje && <p class="cg-tile-nota">{puntaje}</p>}
  {/* La sparkline se dibuja en SVG y, con JS, la reemplaza un mini gráfico de
      ApexCharts animado y con tooltip por punto (IndicadorModal.astro), el mismo
      de «La evolución de cada cinturón» (pedido de Juan, 11-oct-2026). */}
  <div class:list={["cg-tile-vis", `cg-tile-vis--${slug}`]}
       data-spark-key={vis.tipo === "sparkline" && sp && !sp.vacio ? ikey : undefined}
       data-spark-slug={slug}
       data-spark-unidad={UNIDADES_SERIE[ikey] ?? UNIDADES_CORTAS[ikey] ?? ""}>
    {vis.tipo === "sparkline" && sp && !sp.vacio && (
      <svg viewBox="0 0 240 44" width="100%" height="44" preserveAspectRatio="none" aria-hidden="true">
        <path class="cg-spark-area" d={sp.area} />
        <path class="cg-spark-line" d={sp.linea} />
      </svg>
    )}
    {vis.tipo === "barra" && (
      <div class="cg-bar" role="img" aria-label={`${vis.pct}%`}>
        <div class="cg-bar-fill" style={`width:${vis.pct}%`}></div>
      </div>
    )}
  </div>
</article>
