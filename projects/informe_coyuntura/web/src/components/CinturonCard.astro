---
import { indicadoresOrdenados, cap, indiceDe, semaforoDe, peorDimension, num } from "../lib/datos.ts";
import Aguja from "./Aguja.astro";
import { DIM_DESCRIPCIONES } from "../lib/descripciones.ts";
import IndicadorRow from "./IndicadorRow.astro";
const { slug, nombre, sub, cinturon } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// La píldora de `estado` (estable/en_tension/tensionado) sale de la card y la
// reemplaza la aguja. No es cosmética: sobre la MISMA tensión 0-10 había dos
// particiones distintas y no coincidían. Con los datos de agosto de 2026, macro
// en 3,9 era "en tensión" para `estado` y verde para el semáforo; vida en 6,9
// era "tensionado" y naranja. El lector veía dos veredictos del mismo número.
//
// Acá se unifica el CANAL VISUAL: todo color de cinturón sale de los cortes
// publicados (`semaforo_cortes`). El `estado` no se toca ni se reinterpreta —
// es metodología y sigue mandando en la regla sistémica del panel de tensión—,
// pero deja de expresarse en colores para no contradecir a la aguja.
const filas = indicadoresOrdenados(cinturon);
const MAX = 6;
const visibles = filas.slice(0, MAX);
const ocultos = filas.length - visibles.length;
const href = `${base}/${slug}/`;
// Genoma del cinturón: un tramo por dimensión del índice (ancho = peso,
// color = semáforo derivado de la fórmula de tensión publicada). Cada tramo
// abre el modal de dimensión que ya usa la página del cinturón (mismo
// wiring: cg-dim--clickable + data-dimension/data-cinturon). Espíritu de
// época no tiene paramétrica → sin genoma.
const indice = indiceDe(cinturon);
const dims: [string, any][] = indice ? Object.entries(indice.data.dimensiones) : [];
const pesoPct = (d: any) => Math.round((d.peso_efectivo ?? d.peso) * 100);
// La leyenda nombra la dimensión que más tensión aporta (revisión
// adversarial 2026-07-11: el genoma solo-color no alcanzaba para la
// lectura rápida — el texto siempre visible responde "qué explica la
// tensión" sin hover ni modal, y cubre también la lectura sin color).
const peor = peorDimension(cinturon);
---
<article class:list={["cg-cint", `cg-cint--${slug}`]}>
  <div class="cg-cint-head">
    <div class="cg-cint-titles">
      <div class="cg-cint-sub">{sub}</div>
      <div class="cg-cint-name"><a href={href} class="cg-cint-link">{nombre}</a></div>
    </div>
    <Aguja tension={cinturon.score} titulo={`Tensión de ${nombre}`} ocultarTitulo />
  </div>
  {dims.length > 0 && (
    <>
      <div class="cg-genoma" role="group" aria-label={`Dimensiones del ${indice.sigla}: el ancho de cada tramo es su peso en el índice`}>
        {dims.map(([dkey, dim]) => (
          <>
            <button
              type="button"
              class:list={["cg-genoma-seg", `sem-${semaforoDe(dim)}`, "cg-dim--clickable", { "is-critica": dim.critica }]}
              data-dimension={dkey} data-cinturon={slug}
              style={`flex-grow:${pesoPct(dim)};`}
              aria-label={`${dim.nombre}: puntaje ${num(dim.puntaje)}, pesa ${pesoPct(dim)}% del índice — tocá para ver qué mide`}></button>
            <span class="cg-genoma-tip" aria-hidden="true">
              <span class="cg-genoma-tip-head">{dim.nombre} · <strong>{num(dim.puntaje)}{indice.base100 ? "" : "/100"}</strong> · pesa {pesoPct(dim)}%{dim.critica ? " · dimensión crítica" : ""}</span>
              {DIM_DESCRIPCIONES[dkey] && <span class="cg-genoma-tip-desc">{DIM_DESCRIPCIONES[dkey]}</span>}
              <span class="cg-genoma-tip-cta">Tocá para ver la composición completa</span>
            </span>
          </>
        ))}
      </div>
      <div class="cg-genoma-cap">{dims.length} dimensiones (ancho = peso){peor ? ` · mayor tensión: ${peor.nombre.toLowerCase()} (${num(peor.puntaje)}${peor.base100 ? "" : "/100"})` : ""} · tocá un tramo</div>
    </>
  )}
  {!indice && (
    <div class="cg-genoma-cap cg-genoma-cap--solo">Cinturón cualitativo · sin índice de dimensiones — se lee por su indicador</div>
  )}
  <ul class="cg-ind-list">
    {visibles.map(({ key, ind, bucket }) => <IndicadorRow ikey={key} ind={ind} bucket={bucket} slug={slug} />)}
  </ul>
  <div class="cg-cint-foot">
    {/* El score ya lo dice la aguja; acá queda solo el riesgo, que no está en
        ningún otro lado de la card. */}
    <span>{cap(cinturon.barbarismo_riesgo)}</span>
    {/* El enlace decía "ver detalle" en minúscula cuando había ocultos y "Ver
        detalle" cuando no: la card de espíritu de época (sin ocultos) quedaba
        distinta de las otras cuatro. El contador va aparte del rótulo. */}
    <a href={href} class="cg-cint-ver">{ocultos > 0 ? `+${ocultos} · ` : ""}Ver detalle →</a>
  </div>
</article>
