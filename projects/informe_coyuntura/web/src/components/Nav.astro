---
import { informe, mesLegible } from "../lib/datos.ts";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.replace(/\/$/, "");
const links = [
  { href: `${base}/`, label: "Resumen", seg: "" },
  { href: `${base}/macro/`, label: "Macro", seg: "macro" },
  { href: `${base}/politica/`, label: "Política", seg: "politica" },
  { href: `${base}/vida/`, label: "Vida cotidiana", seg: "vida" },
  { href: `${base}/gestion/`, label: "Gestión", seg: "gestion" },
  // Apunta a la PÁGINA de metodología, no al ancla de la portada. Mientras
  // apuntó a `/#metodologia` el marco conceptual quedaba a dos clics del lector
  // que usa el Nav, y el ítem no se encendía nunca (ADR-0199/0200 lo declararon
  // como deuda; ADR-0201 la cierra). La sección de la portada sigue existiendo
  // con su propio CTA al diccionario: lo que cambia es a dónde manda el Nav.
  { href: `${base}/metodologia/`, label: "Metodología", seg: "metodologia" },
];
function isActive(seg: string): boolean {
  if (seg === "") return path === base;
  const destino = `${base}/${seg}`;
  // Coincidencia por rama, no exacta: /metodologia tiene una subpágina por
  // ficha (/metodologia/itcm, /metodologia/ipc_total…) y el ítem tiene que
  // quedarse encendido ahí adentro. Los cinturones no tienen subpáginas hoy,
  // así que para ellos se comporta igual que la comparación exacta.
  return path === destino || path.startsWith(`${destino}/`);
}
---
<nav class="cg-nav">
  <div class="cg-nav-inner">
    <div class="cg-nav-left">
      <a class="cg-nav-brand" href="https://www.cigob.org" target="_self">
        <span class="cg-nav-logo"><img src={`${base}/cigob-icono.png`} alt="CiGob" /></span>
        <span class="cg-nav-titles">
          <span class="cg-nav-title">CiGob</span>
          <span class="cg-nav-sub">Ciencias para gobernar</span>
        </span>
      </a>
      <a class="cg-nav-producto" href={`${base}/`}>Informe de Coyuntura<span class="cg-nav-mes">{mesLegible(informe.period)}</span></a>
    </div>
    <button class="cg-nav-burger" id="cg-nav-burger" aria-label="Secciones del informe"
            aria-expanded="false" aria-controls="cg-nav-links">☰</button>
    <div class="cg-nav-links" id="cg-nav-links">
      {links.map(l => (
        <a href={l.href} class:list={{ active: isActive(l.seg) }} aria-current={isActive(l.seg) ? "page" : undefined}>{l.label}</a>
      ))}
    </div>
  </div>
</nav>
<script is:inline>
  (function () {
    const nav = document.querySelector(".cg-nav");
    const btn = document.getElementById("cg-nav-burger");
    if (!nav || !btn) return;
    btn.addEventListener("click", () => {
      const abierto = nav.classList.toggle("abierto");
      btn.setAttribute("aria-expanded", String(abierto));
      btn.textContent = abierto ? "✕" : "☰";
    });
    // navegar o tocar fuera cierra el menú
    document.getElementById("cg-nav-links").addEventListener("click", e => {
      if (e.target.tagName === "A") { nav.classList.remove("abierto"); btn.textContent = "☰"; }
    });
    document.addEventListener("click", e => {
      if (!nav.contains(e.target) && nav.classList.contains("abierto")) {
        nav.classList.remove("abierto");
        btn.setAttribute("aria-expanded", "false");
        btn.textContent = "☰";
      }
    });
  })();
</script>
