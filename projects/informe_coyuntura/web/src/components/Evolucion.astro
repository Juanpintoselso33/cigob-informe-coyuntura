---
import { informe, CINTURONES, indiceDe, num } from "../lib/datos.ts";

// "Cómo va la película" DE VERDAD (revisión estructural 2026-07-11): antes
// esta sección repetía en grande 10 indicadores que ya están en las cards
// (cada fila trae sparkline y su modal con tabla/CSV) — redundancia pura.
// Lo que la home NO mostraba en ningún lado es la trayectoria de los
// CINTURONES: acá van las series mensuales reconstruidas de los 4 índices, en
// la escala de cada índice (ADR-0337: la tensión 0-10 no se muestra como
// número en la web). Cada mini-gráfico tiene su propio eje; el ITCIS es
// base-100 y los otros tres, puntaje 0-100. En los cuatro, subir es mejorar.
// La reconstrucción completa se publica separada de los pares del panel:
// series de componentes SIN ajustes del analista — el nivel puede diferir
// del publicado. La evolución también puede cambiar por cobertura (nota abajo).
// Oct-2026 (pedido editorial): cada tile se titula por su cinturón.
const TITULO_TILE: Record<string, string> = {
  macro: "Cinturón Macro",
  politica: "Cinturón de la Política",
  vida: "Cinturón del Impacto Social",
  gestion: "Cinturón de la Gestión",
};
// Eje vertical en degradado de semáforo (oct-2026): verde arriba, rojo abajo,
// con cada color centrado en su banda. Los cortes son los de CORTES_SEMAFORO
// (parametrica.py) en la escala de cada índice; si cambian allá, cambiar acá.
// El de impacto social pasa a rango fijo 80-110 para que la franja de color
// coincida con la altura real de la línea (con rango automático no coincidía).
const RANGO_BASE100: [number, number] = [80, 110];
function ejeSemaforo(rango: [number, number], cortes: [number, number, number]) {
  const [lo, hi] = rango;
  const pos = (v: number) => Math.max(0, Math.min(100, ((hi - v) / (hi - lo)) * 100));
  const [c1, c2, c3] = cortes; // verde≥c1, amarillo c2-c1, naranja c3-c2, rojo<c3
  const p = (n: number) => `${n.toFixed(1)}%`;
  const verde = pos((hi + c1) / 2), amarillo = pos((c1 + c2) / 2),
        naranja = pos((c2 + c3) / 2), rojo = pos((c3 + lo) / 2);
  return `linear-gradient(to bottom, #2E9E5B 0%, #2E9E5B ${p(verde)}, #E8C547 ${p(amarillo)}, `
       + `#EE8A2F ${p(naranja)}, #D64541 ${p(rojo)}, #D64541 100%)`;
}

const MES_ABREV = ["ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic"];
const mesCorto = (ym: string) => `${MES_ABREV[+ym.slice(5, 7) - 1]}-${ym.slice(0, 4)}`;

const trayectorias = CINTURONES
  .map(meta => {
    const c = informe.cinturones[meta.key];
    const idx = c ? indiceDe(c) : null;
    // La falta de un dato del contraste externo no recorta la historia propia.
    const pares: [string, number][] = idx?.data?.serie_mensual ?? [];
    if (!idx || pares.length < 2) return null;
    const serie = pares.map(([ym, v]) => ({ fecha: `${ym}-01`, valor: Math.round(v * 10) / 10 }));
    const ahora = serie.at(-1)!.valor;
    const previo = serie.at(-2)!.valor;
    const delta = Math.round((ahora - previo) * 10) / 10;
    // Brecha contra el punto de partida: el índice puntúa NIVEL contra anclas
    // fijas, así que por sí solo no responde "¿estamos mejor que en la
    // transición?". Se calcula sobre la MISMA serie reconstruida (primer punto
    // vs último) — comparar el reconstruido de hoy contra el publicado sería
    // mezclar dos cosas distintas. En el índice, subir es mejorar.
    const deltaInicio = Math.round((ahora - serie[0].valor) * 10) / 10;
    return { meta, idx, serie, ahora, delta, deltaInicio,
             desde: mesCorto(pares[0][0]), hasta: mesCorto(pares.at(-1)![0]) };
  })
  .filter((x): x is NonNullable<typeof x> => !!x);
---
{/* Sin serie no hay sección: un cartel de «en construcción» no le dice nada a
    quien lee (pedido de Juan, 7-oct-2026, al verlo en el archivo de junio). */}
{trayectorias.length > 0 && (
<section class="cg-section" id="evolucion">
  <div class="cg-section-head">
    <h2 class="cg-h2">La evolución de cada cinturón, mes a mes</h2>
    <p class="cg-h2-sub">Se muestra la evolución de cada cinturón desde diciembre de 2023. En los cuatro, subir es mejorar: el Cinturón del Impacto Social parte de 100 como nivel del último trimestre del 2023 y los otros tres van de 0 a 100.</p>
  </div>
    <div class="cg-chart-grid" id="cg-chart-grid">
      {trayectorias.map(t => (
        <div class:list={["cg-chart-mini-card", t.meta.slug]}>
          <h3>{TITULO_TILE[t.meta.slug] ?? t.idx.Corto}</h3>
          <div class="cg-sub">{t.desde} → {t.hasta} · {t.serie.length} meses</div>
          <div class="cg-evo-eje-wrap">
            <span class="cg-evo-eje" aria-hidden="true"
                  title="Verde arriba (mejor), rojo abajo (peor)"
                  style={`background: ${t.idx.base100 ? ejeSemaforo(RANGO_BASE100, [105, 95, 85]) : ejeSemaforo([0, 100], [60, 40, 20])}`}></span>
            <div class="cg-chart-mini" data-evo-key={`__indice_${t.meta.slug}`}
                 data-evo-rango={t.idx.base100 ? RANGO_BASE100.join(",") : "0,100"}
                 data-evo-slug={t.meta.slug} data-evo-unidad={t.idx.base100 ? "índice (100 = 4T-2023)" : "puntos (0-100)"}
                 data-evo-serie={JSON.stringify(t.serie)}></div>
          </div>
          <div class="cg-chart-mini-foot">
            <div class="cg-chart-mini-now">{num(t.ahora)}</div>
            <span class:list={["cg-chart-mini-delta", t.delta > 0 ? "mejora" : t.delta < 0 ? "empeora" : "flat"]}>
              {t.delta > 0 ? "+" : ""}{num(t.delta)}
            </span>
          </div>
          <div class="cg-sub">
            Desde {t.desde}: <strong>{t.deltaInicio > 0 ? "+" : ""}{num(t.deltaInicio)}</strong>
            {t.deltaInicio > 0 ? " puntos (mejoró)" : t.deltaInicio < 0 ? " puntos (empeoró)" : " puntos"}
          </div>
        </div>
      ))}
    </div>
  <style>
    .cg-evo-eje-wrap {
      display: flex;
      align-items: stretch;
      gap: 8px;
    }
    .cg-evo-eje {
      flex: 0 0 6px;
      border-radius: 3px;
      opacity: .9;
    }
    .cg-evo-eje-wrap > .cg-chart-mini {
      flex: 1 1 auto;
      min-width: 0;
    }
  </style>
  <p class="cg-evolucion-nota">Series reconstruidas con los datos disponibles en cada mes, sin ajustes del analista. Los componentes con datos pueden cambiar entre meses: las variaciones combinan cambios de valores y de cobertura. El nivel puede diferir del informe publicado en su momento.</p>
</section>
)}
