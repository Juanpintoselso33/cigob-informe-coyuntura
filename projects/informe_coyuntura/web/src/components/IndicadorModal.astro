---
import { informe, series, label, presentacion, formatValor, periodoDato, UNIDADES_LARGAS, UNIDADES_SERIE, CINTURONES, BARRA_0_100, CONTEXTO_DURO_META } from "../lib/datos.ts";
import { DESCRIPCIONES, DIM_DESCRIPCIONES } from "../lib/descripciones.ts";
import { FORMULAS } from "../lib/formulas.ts";

const CINT_NOMBRE: Record<string, string> = {
  macro: "Macroeconomía", politica: "Política",
  vida_cotidiana: "Vida cotidiana", gestion: "Gestión",
  espiritu_epoca: "Espíritu de época",
};
const SLUG_DE: Record<string, string> =
  Object.fromEntries(CINTURONES.map(c => [c.key, c.slug]));

// Índice paramétrico y metadata de ponderación por indicador. Se conservan
// peso efectivo y puntaje aplicado del snapshot: pueden diferir de los
// nominales cuando hay faltantes o ajustes del analista (ADR-0053).
// INDICE_KEY se conserva como objetivo del guard de wiring estático de
// test_web_labels.py (mapea cinturón → índice en forma literal cinturon: "itcm").
const INDICE_KEY: Record<string, string> = {
  macro: "itcm", gestion: "itcg", vida_cotidiana: "itvc", politica: "itcp",
};
const INDICE_CFG: Record<string, { key: string; sigla: string; base100: boolean }> = {
  macro: { key: "itcm", sigla: "ITCM", base100: false },
  gestion: { key: "itcg", sigla: "ITCG", base100: false },
  vida_cotidiana: { key: "itvc", sigla: "ITVC", base100: true },
  politica: { key: "itcp", sigla: "ITCP", base100: false },
};
const numero = (valor: unknown): number | null =>
  typeof valor === "number" && Number.isFinite(valor) ? valor : null;
type MetaIndiceIndicador = {
  dimNombre: string;
  sigla: string;
  base100: boolean;
  pesoInternoNominal: number | null;
  pesoDimensionNominal: number | null;
  pesoDimensionEfectivo: number | null;
  pesoEfectivo: number | null;
  puntajeAplicado: number | null;
  aporteIndice: number | null;
};
const indiceMetaDe: Record<string, MetaIndiceIndicador> = {};
for (const [ckey, c] of Object.entries(informe.cinturones)) {
  const cfg = INDICE_CFG[ckey];
  const blk = cfg ? (c as any)[cfg.key] : null;
  if (!blk?.dimensiones) continue;
  for (const dim of Object.values(blk.dimensiones) as any[]) {
    for (const [ikey, i] of Object.entries(dim.indicadores ?? {}) as [string, any][]) {
      const ind = (c as any).indicadores?.[ikey];
      if (ind?.en_indice === false) continue;
      const pesoInternoNominal = numero(i.peso);
      const pesoDimensionNominal = numero(dim.peso);
      const pesoDimensionEfectivo = numero(dim.peso_efectivo) ?? pesoDimensionNominal;
      const pesoEfectivo = numero(i.peso_efectivo)
        ?? numero(ind?.peso_efectivo)
        ?? (pesoDimensionEfectivo !== null && pesoInternoNominal !== null
          ? pesoDimensionEfectivo * pesoInternoNominal
          : null);
      const puntajePublicado = numero(ind?.[`puntaje_${cfg.key}`]);
      const puntajeAplicado = numero(i.puntaje_aplicado)
        ?? numero(i.puntaje_banda)
        ?? puntajePublicado
        ?? numero(ind?.puntaje_banda);
      indiceMetaDe[`${SLUG_DE[ckey] ?? ckey}.${ikey}`] = {
        dimNombre: dim.nombre,
        sigla: cfg.sigla,
        base100: cfg.base100,
        pesoInternoNominal,
        pesoDimensionNominal,
        pesoDimensionEfectivo,
        pesoEfectivo,
        puntajeAplicado,
        aporteIndice: pesoEfectivo !== null && puntajeAplicado !== null
          ? pesoEfectivo * puntajeAplicado
          : null,
      };
    }
  }
}

// Contraste de migración real (contexto_duro de indice_intencion_migratoria):
// se precomputa acá la fila lista para mostrar — label público, valor
// formateado y período legible — así el script del modal no repite lógica.
const MES_ABREV = ["ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic"];
function periodoLegible(p: string): string {
  const m = /^(\d{4})-(\d{2})$/.exec(p);
  return m ? `${MES_ABREV[+m[2] - 1]} ${m[1]}` : p;
}
function contextoDuroFilas(ctx: unknown): { label: string; valor: string; periodo: string; nota: string | null }[] | null {
  if (!ctx || typeof ctx !== "object") return null;
  const filas = Object.entries(CONTEXTO_DURO_META)
    .filter(([k]) => (ctx as any)[k] && typeof (ctx as any)[k].valor === "number")
    .map(([k, meta]) => {
      const p = (ctx as any)[k];
      return {
        label: meta.label,
        valor: formatValor(p.valor),
        periodo: `${periodoLegible(String(p.periodo))} · ${meta.freq}`,
        nota: meta.nota ?? null,
      };
    });
  return filas.length ? filas : null;
}

// Ficha por indicador, namespaced por slug de cinturón: icc_utdt y
// sentimiento_digital existen en vida Y espíritu de época — sin namespace el
// último cinturón iterado pisaría al primero en el modal.
const info: Record<string, unknown> = {};
for (const [ckey, c] of Object.entries(informe.cinturones)) {
  for (const [ikey, ind] of Object.entries(c.indicadores)) {
    const p = presentacion(ikey, ind);
    const d = DESCRIPCIONES[ikey] ?? { que: "", aporta: "", frecuencia: "—", tipo: "—" };
    const estado = ind.estado === "placeholder"
      ? "Estimación"
      : ind.desactualizado ? "Carga manual" : "Automático";
    const claveInfo = `${SLUG_DE[ckey] ?? ckey}.${ikey}`;
    const indiceMeta = ind.en_indice === false ? null : (indiceMetaDe[claveInfo] ?? null);
    info[claveInfo] = {
      label: label(ikey), cinturon: CINT_NOMBRE[ckey] ?? ckey,
      que: d.que, aporta: d.aporta,
      valor: p.texto, unidad: p.unidad, unidadSerie: UNIDADES_SERIE[ikey] ?? p.unidad,
      unidadLarga: UNIDADES_LARGAS[ikey] ?? ind.unidad ?? "—",
      frecuencia: d.frecuencia, tipo: d.tipo,
      fuente: ind.fuente ?? "", fecha: ind.fecha_dato ?? "", estado,
      periodo: periodoDato(ikey, ind),
      aporteScore: ind.aporte_score ?? null,
      aporteFormula: ind.aporte_formula ?? null,
      aporteNota: ind.aporte_nota ?? null,
      aporteLectura: ind.aporte_lectura ?? null,
      aporteInputTxt: ind.aporte_input_txt ?? null,
      scoreCint: c.score, scoreExpl: c.score_explicacion ?? "",
      slug: SLUG_DE[ckey] ?? ckey,
      avance: typeof ind.avance_pct === "number" ? ind.avance_pct : null,
      componentes: ind.componentes ?? null,
      valorNum: typeof ind.valor === "number" ? ind.valor : null,
      // Para indicadores que son un % sobre un total chico y contable (hoy
      // solo adhesion_reformas_provincial, 24 jurisdicciones): mostrar
      // también el conteo absoluto junto al %, más legible que un
      // porcentaje sobre una base que no es 100 (66,7% de 24 se lee peor
      // que "16 de 24"). "jurisdicciones", NO "provincias": de las 24, una
      // es CABA, que no es una provincia -- llamarlas "24 provincias" acá
      // sería impreciso y contradice la propia descripción del indicador.
      valorAbsolutoTxt: typeof ind.n_provincias === "number" ? `${ind.n_provincias} de 24 jurisdicciones` : null,
      es0100: BARRA_0_100.has(ikey),
      unidadCorta: p.unidad ?? "",
      formula: FORMULAS[ikey]?.latex ?? null,
      formulaLeyenda: FORMULAS[ikey]?.leyenda ?? null,
      contextoDuro: contextoDuroFilas((ind as any).contexto_duro),
      dimTxt: indiceMeta
        ? `${indiceMeta.dimNombre} · ${indiceMeta.pesoInternoNominal !== null ? Math.round(indiceMeta.pesoInternoNominal * 100) + "% interno" : "peso interno no disponible"}`
        : (ind.en_indice === false ? "Contexto — no integra el índice" : null),
      indiceMeta,
    };
  }
}
const infoJson = JSON.stringify(info);
const seriesJson = JSON.stringify(series);

// Ficha por DIMENSIÓN de los índices paramétricos (modal de dimensión):
// composición (indicadores, pesos internos, puntajes interpolados), aporte al
// índice y flag de dimensión crítica (ADR-0020).
const dims: Record<string, unknown> = {};
for (const [ckey, c] of Object.entries(informe.cinturones)) {
  const cfg = INDICE_CFG[ckey];
  const blk = cfg ? (c as any)[cfg.key] : null;
  if (!blk?.dimensiones) continue;
  for (const [dkey, dim] of Object.entries(blk.dimensiones) as [string, any][]) {
    const comps = Object.entries(dim.indicadores ?? {}).map(([ikey, i]: [string, any]) => {
      const ind = (c as any).indicadores[ikey];
      const p = ind ? presentacion(ikey, ind) : null;
      return {
        key: ikey, label: label(ikey),
        puntaje: i.puntaje_aplicado, banda: i.puntaje_banda, peso: i.peso,
        ajustado: i.puntaje_aplicado !== i.puntaje_banda,
        valor: p ? `${p.texto}${p.unidad ? " " + p.unidad : ""}` : null,
      };
    });
    const miembros = new Set(comps.map(x => x.key));
    dims[`${SLUG_DE[ckey] ?? ckey}.${dkey}`] = {
      sigla: cfg.sigla, base100: cfg.base100,
      cinturon: CINT_NOMBRE[ckey] ?? ckey, slug: SLUG_DE[ckey] ?? ckey,
      nombre: dim.nombre, puntaje: dim.puntaje,
      peso: dim.peso_efectivo ?? dim.peso, critica: !!dim.critica,
      indiceValor: blk.valor, que: DIM_DESCRIPCIONES[dkey] ?? "",
      comps,
      ajustes: (blk.ajustes_aplicados ?? []).filter((a: any) => miembros.has(a.indicador)),
    };
  }
}
const dimsJson = JSON.stringify(dims);
---
<div class="cg-modal" id="cg-modal" hidden>
  <div class="cg-modal-card">
    <button class="cg-modal-close" id="cg-modal-close" aria-label="Cerrar">×</button>
    <p class="cg-eyebrow" id="cg-modal-eyebrow">Indicador</p>
    <h3 class="cg-modal-title" id="cg-modal-title"></h3>
    <p class="cg-modal-desc" id="cg-modal-que"></p>
    <dl class="cg-modal-ficha" id="cg-modal-ficha"></dl>
    <div class="cg-modal-aporta" id="cg-modal-aporta"></div>
    <div class="cg-modal-formula" id="cg-modal-formula" hidden>
      <h4 class="cg-modal-h4">Cómo se construye</h4>
      <div class="cg-formula-math" id="cg-formula-math"></div>
      <p class="cg-formula-leyenda" id="cg-formula-leyenda"></p>
    </div>
    <div class="cg-modal-score" id="cg-modal-score"></div>
    <div class="cg-modal-contexto" id="cg-modal-contexto" style="display:none"></div>
    <h4 class="cg-modal-h4" id="cg-modal-serie-h">Evolución histórica</h4>
    <div class="cg-chart-modal" id="cg-modal-chart" role="img" aria-label="Gráfico del indicador" hidden></div>
    <p class="cg-modal-sub" id="cg-modal-sub"></p>
    <table class="cg-modal-table" id="cg-modal-table"></table>
    <button class="cg-modal-csv" id="cg-modal-csv" type="button" hidden>
      <span aria-hidden="true">↓</span> Descargar serie (CSV)
    </button>
  </div>
</div>
<script type="application/json" id="cg-info-data" set:html={infoJson}></script>
<script type="application/json" id="cg-series-data" set:html={seriesJson}></script>
<script type="application/json" id="cg-dims-data" set:html={dimsJson}></script>
<script>
  // ApexCharts se carga en demanda (import dinámico) la primera vez que se abre un
  // indicador, para no pesar en la carga de página cuando nadie abre el modal.
  let CHARTS = null;
  async function ensureCharts() {
    if (!CHARTS) CHARTS = await import("../lib/charts.ts");
    return CHARTS;
  }
  // KaTeX también on-demand: la fórmula "Cómo se construye" del modal.
  let MATH = null;
  async function mostrarFormula(latex, leyenda) {
    const caja = document.getElementById("cg-modal-formula");
    if (!latex) { caja.setAttribute("hidden", ""); return; }
    caja.removeAttribute("hidden");
    document.getElementById("cg-formula-leyenda").textContent = leyenda || "";
    document.getElementById("cg-formula-leyenda").style.display = leyenda ? "" : "none";
    if (!MATH) MATH = await import("../lib/math.ts");
    MATH.renderFormula(document.getElementById("cg-formula-math"), latex);
  }
  const INFO = JSON.parse(document.getElementById("cg-info-data").textContent);
  const SERIES = JSON.parse(document.getElementById("cg-series-data").textContent);
  const modal = document.getElementById("cg-modal");
  const nf = new Intl.NumberFormat("es-AR", { maximumFractionDigits: 2 });
  const nfPct = new Intl.NumberFormat("es-AR", { maximumFractionDigits: 1 });
  const esc = (s) => String(s).replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
  const pctIndice = (n) => `${nfPct.format(n * 100)}%`;
  function incidenciaIndiceHtml(meta) {
    if (!meta || typeof meta.pesoEfectivo !== "number") return "";
    const pesoNominalEsperado = typeof meta.pesoInternoNominal === "number" && typeof meta.pesoDimensionNominal === "number"
      ? meta.pesoInternoNominal * meta.pesoDimensionNominal
      : null;
    const sinRenormalizacion = pesoNominalEsperado !== null
      && Math.abs(pesoNominalEsperado - meta.pesoEfectivo) < 0.0005;
    let ponderacion;
    if (sinRenormalizacion) {
      ponderacion = `${pctIndice(meta.pesoInternoNominal)} interno × ` +
        `${pctIndice(meta.pesoDimensionNominal)} de la dimensión = ` +
        `<strong>${pctIndice(meta.pesoEfectivo)} efectivo del ${esc(meta.sigla)}</strong>.`;
    } else {
      const nominales = typeof meta.pesoInternoNominal === "number" && typeof meta.pesoDimensionNominal === "number"
        ? ` Pesos nominales: ${pctIndice(meta.pesoInternoNominal)} interno y ${pctIndice(meta.pesoDimensionNominal)} de la dimensión.`
        : "";
      const dimensionEfectiva = typeof meta.pesoDimensionEfectivo === "number"
        && typeof meta.pesoDimensionNominal === "number"
        && Math.abs(meta.pesoDimensionNominal - meta.pesoDimensionEfectivo) >= 0.0005
        ? ` La dimensión pesa ${pctIndice(meta.pesoDimensionEfectivo)} tras la renormalización.`
        : "";
      ponderacion = `<strong>${pctIndice(meta.pesoEfectivo)} efectivo del ${esc(meta.sigla)}</strong>.` +
        `${nominales}${dimensionEfectiva} La ponderación efectiva refleja los datos disponibles en el período.`;
    }
    const aporte = typeof meta.aporteIndice === "number" && typeof meta.puntajeAplicado === "number"
      ? `<p class="cg-score-map"><strong>Aporte actual:</strong> ` +
        `${meta.base100 ? `nivel aplicado ${nf.format(meta.puntajeAplicado)} (100 = 4T-2023)` : `puntaje aplicado ${nf.format(meta.puntajeAplicado)}/100`} ` +
        `× ${pctIndice(meta.pesoEfectivo)} ≈ <strong>${nf.format(meta.aporteIndice)} puntos del ${esc(meta.sigla)}</strong>.</p>`
      : "";
    return `<h4 class="cg-modal-h4">Cómo entra al ${esc(meta.sigla)}</h4>` +
      `<p class="cg-score-map"><strong>Ponderación vigente:</strong> ${ponderacion}</p>${aporte}`;
  }

  // Tipo de gráfico según el indicador: serie temporal → línea/área ·
  // avance sin serie → medidor radial · componentes → barras.
  let chartInstance = null;
  function destruirChart() { if (chartInstance) { chartInstance.destroy(); chartInstance = null; } }
  function hayComponentes(comp) { return comp && Object.values(comp).some(v => typeof v === "number"); }
  // Elige el gráfico: serie → línea · avance → gauge · componentes → barras ·
  // nivel 0-100 → gauge del valor · resto (con aporte) → gauge de tensión.
  function tipoChart(d, serie) {
    if (serie && serie.length >= 2) return "linea";
    if (typeof d.avance === "number") return "gauge_avance";
    if (hayComponentes(d.componentes)) return "barra";
    if (d.es0100 && typeof d.valorNum === "number") return "gauge_valor";
    if (typeof d.aporteScore === "number") return "gauge_tension";
    return null;
  }
  // Monta el gráfico. Debe llamarse con el modal YA visible (ApexCharts mide el
  // contenedor; con display:none renderiza a 0px). Async: carga la librería on-demand.
  async function renderChart(tipo, key, d, serie) {
    const el = document.getElementById("cg-modal-chart");
    destruirChart();
    if (!tipo) { el.setAttribute("hidden", ""); return; }
    el.removeAttribute("hidden");
    const C = await ensureCharts();
    const color = C.colorDe(d.slug);
    // Series comparadas: indicadores que se leen contra sus pares (el TCRM
    // multilateral junto a los bilaterales, la presentación del BCRA) con
    // una referencia histórica punteada.
    const MULTI = {
      tcrm: { series: [["tcrm", "Multilateral"], ["tcrm_bilateral_brasil", "Bilateral Brasil"], ["tcrm_bilateral_eeuu", "Bilateral EE.UU."]],
              refY: 106, refLabel: "mediana histórica 1997-2026" },
    };
    const baseKey = key.split(".").pop();
    const multi = MULTI[baseKey];
    if (tipo === "linea" && multi && multi.series.every(([k]) => (SERIES[k] || []).length > 1)) {
      chartInstance = C.multiTimeChart(el,
        multi.series.map(([k, nombre]) => ({ nombre, puntos: SERIES[k] })),
        { color, unidad: d.unidad, refY: multi.refY, refLabel: multi.refLabel });
    }
    else if (tipo === "linea") chartInstance = C.timeChart(el, serie, { color, nombre: d.label, unidad: d.unidadSerie ?? d.unidad, indicador: baseKey });
    else if (tipo === "gauge_avance") chartInstance = C.gaugeChart(el, d.avance, { color, label: "avance ejecutado" });
    else if (tipo === "gauge_valor") chartInstance = C.gaugeChart(el, d.valorNum, { color, label: "nivel actual",
               centerText: `${nf.format(d.valorNum)}${d.unidadCorta ? " " + d.unidadCorta : ""}` });
    else if (tipo === "gauge_tension") chartInstance = C.gaugeChart(el, d.aporteScore * 10, { color, label: "tensión equivalente",
               centerText: `${nf.format(d.aporteScore)} / 10` });
    else if (tipo === "barra") chartInstance = C.barChart(el, C.componentesDe(key, d.componentes), { color, unidad: d.unidad });
  }
  const close = () => { destruirChart(); modal.setAttribute("hidden", ""); };
  document.getElementById("cg-modal-close").addEventListener("click", close);
  modal.addEventListener("click", e => { if (e.target === modal) close(); });
  document.addEventListener("keydown", e => { if (e.key === "Escape") close(); });

  // Descarga de la serie del indicador abierto como CSV (fecha,valor).
  const csvBtn = document.getElementById("cg-modal-csv");
  let serieActual = [], keyActual = "";
  csvBtn.addEventListener("click", () => {
    if (!serieActual.length) return;
    const filas = [["fecha", "valor"], ...serieActual.map(p => [p.fecha, p.valor])];
    const csv = filas.map(r => r.join(",")).join("\r\n") + "\r\n";
    const blob = new Blob(["﻿" + csv], { type: "text/csv;charset=utf-8;" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `${keyActual}_serie.csv`;
    document.body.appendChild(a); a.click(); a.remove();
    URL.revokeObjectURL(url);
  });

  document.querySelectorAll(".cg-ind--clickable[data-indicador]").forEach(li => {
    li.addEventListener("click", () => {
      const key = li.getAttribute("data-indicador");
      const cint = li.getAttribute("data-cinturon") || "";
      const d = INFO[`${cint}.${key}`] || INFO[key] || { label: key, cinturon: "", que: "", aporta: "", valor: "—", unidad: "", fuente: "", fecha: "", estado: "" };
      const serie = SERIES[key] || [];

      document.getElementById("cg-modal-eyebrow").textContent = d.cinturon ? `Indicador · ${d.cinturon}` : "Indicador";
      document.getElementById("cg-modal-title").textContent = d.label;
      document.getElementById("cg-modal-que").textContent = d.que;

      const aporta = document.getElementById("cg-modal-aporta");
      aporta.innerHTML = d.aporta ? `<strong>Qué aporta al cinturón:</strong> ${esc(d.aporta)}` : "";
      aporta.style.display = d.aporta ? "" : "none";

      const fuenteCorta = d.fuente && /^https?:\/\//.test(d.fuente)
        ? d.fuente.replace(/^https?:\/\//, "").replace(/\/.*$/, "")
        : (d.fuente || "—");
      const celda = (rotulo, valor, titulo) =>
        `<div><dt>${rotulo}</dt><dd${titulo ? ` title="${esc(titulo)}"` : ""}>${esc(valor)}</dd></div>`;
      document.getElementById("cg-modal-ficha").innerHTML =
        celda("Último valor", `${d.valor} ${d.unidad}`.trim() + (d.valorAbsolutoTxt ? ` (${d.valorAbsolutoTxt})` : "")) +
        celda("Unidad", d.unidadLarga || d.tipo || "—") +
        celda("Dimensión", d.dimTxt || "—") +
        celda("Frecuencia", d.frecuencia || "—") +
        celda("Actualización", d.estado === "Automático"
          ? `${d.periodo || "—"} · dato al ${d.fecha || "—"}`
          : `${d.fecha || "—"} · ${d.estado}`) +
        celda("Fuente", fuenteCorta, d.fuente);
      mostrarFormula(d.formula, d.formulaLeyenda);

      const score = document.getElementById("cg-modal-score");
      const indiceHtml = incidenciaIndiceHtml(d.indiceMeta);
      let tensionHtml = "";
      if (d.aporteScore != null) {
        const pct = Math.max(0, Math.min(100, d.aporteScore * 10));
        tensionHtml =
          `<h4 class="cg-modal-h4">${d.indiceMeta ? "Tensión equivalente del indicador" : "Cómo incide en el score"}</h4>` +
          `<div class="cg-score-row">` +
            `<div class="cg-score-val">${nf.format(d.aporteScore)}<span>/10</span></div>` +
            `<div class="cg-score-track"><div class="cg-score-fill" style="width:${pct}%"></div>` +
              `<span class="cg-score-c0">sin tensión</span><span class="cg-score-c10">tensión máx.</span>` +
            `</div>` +
          `</div>` +
          (d.aporteInputTxt ? `<p class="cg-score-map"><strong>Valor usado:</strong> ${esc(d.aporteInputTxt)}</p>` : "") +
          (d.aporteFormula ? `<p class="cg-score-map"><strong>Cómo se calcula:</strong> ${esc(d.aporteFormula)}</p>` : "") +
          `<p class="cg-score-note">${esc(d.aporteLectura || `Este indicador equivale a una tensión de ${nf.format(d.aporteScore)} de 10.`)} ` +
            `Score del cinturón: <strong>${nf.format(d.scoreCint)}/10</strong>. ` +
            `${esc(d.scoreExpl || "Promedio de las tensiones de sus indicadores.")}` +
            (d.indiceMeta ? ` Esta tensión equivalente no es el aporte aritmético al ${esc(d.indiceMeta.sigla)} mostrado arriba.` : "") +
          `</p>`;
      } else if (d.aporteNota) {
        tensionHtml =
          `<h4 class="cg-modal-h4">Cómo incide en el score</h4>` +
          `<p class="cg-score-note">${esc(d.aporteNota)}</p>`;
      }
      score.innerHTML = indiceHtml + tensionHtml;
      score.style.display = score.innerHTML ? "" : "none";

      // Contraste de migración real (solo indice_intencion_migratoria): la
      // intención expresada en búsquedas no debe leerse sin la migración
      // efectiva al lado — ADR de diseño del indicador.
      const ctxCaja = document.getElementById("cg-modal-contexto");
      if (d.contextoDuro && d.contextoDuro.length) {
        ctxCaja.innerHTML =
          `<h4 class="cg-modal-h4">La migración real, como contraste</h4>` +
          `<p class="cg-ctx-intro">El índice mide interés de búsqueda, no personas que se van. ` +
          `Estos registros administrativos de los destinos principales muestran la migración efectiva ` +
          `y acompañan al indicador solo como contraste: no suman ni restan al score. ` +
          `Cada fuente publica con su propio calendario, por eso los períodos difieren.</p>` +
          d.contextoDuro.map(f =>
            `<div class="cg-ctx-row">` +
              `<span class="cg-ctx-nombre">${esc(f.label)}${f.nota ? ` <span class="cg-ctx-nota">(${esc(f.nota)})</span>` : ""}</span>` +
              `<span class="cg-ctx-valor"><strong>${esc(f.valor)}</strong> <span class="cg-ctx-periodo">${esc(f.periodo)}</span></span>` +
            `</div>`).join("");
        ctxCaja.style.display = "";
      } else {
        ctxCaja.style.display = "none";
      }

      const serieH = document.getElementById("cg-modal-serie-h");
      const sub = document.getElementById("cg-modal-sub");
      const table = document.getElementById("cg-modal-table");
      serieActual = serie; keyActual = key;
      const tipo = tipoChart(d, serie);
      const HEAD = { linea: "Evolución histórica", gauge_avance: "Avance de la reforma",
                     gauge_valor: "Nivel actual", gauge_tension: "Aporte de tensión",
                     barra: "Composición del indicador" };
      // Encabezado del gráfico
      serieH.style.display = tipo ? "" : "none";
      if (tipo) serieH.textContent = HEAD[tipo] ?? "Indicador";
      // Serie de datos + CSV: siempre que haya al menos un dato (histórico acumulado).
      if (serie.length >= 1) {
        sub.style.display = "";
        sub.textContent = serie.length >= 2
          ? `${serie.length} datos · se muestran los últimos ${Math.min(12, serie.length)}`
          : "1 dato · el histórico se va acumulando mes a mes";
        const rows = serie.slice(-12).reverse()
          .map(p => `<tr><td>${esc(p.fecha)}</td><td>${nf.format(p.valor)}</td></tr>`).join("");
        table.innerHTML = `<thead><tr><th>Fecha</th><th>Valor</th></tr></thead><tbody>${rows}</tbody>`;
        csvBtn.removeAttribute("hidden");
      } else {
        sub.style.display = "none";
        table.innerHTML = "";
        csvBtn.setAttribute("hidden", "");
      }
      modal.removeAttribute("hidden");
      requestAnimationFrame(() => renderChart(tipo, key, d, serie));
    });
  });

  // Modal de DIMENSIÓN de los índices paramétricos: composición (indicadores,
  // pesos internos, puntajes interpolados), aporte al índice y flag crítica.
  const DIMS = JSON.parse(document.getElementById("cg-dims-data")?.textContent || "{}");
  document.querySelectorAll(".cg-dim--clickable[data-dimension]").forEach(card => {
    const abrir = () => {
      const d = DIMS[`${card.getAttribute("data-cinturon")}.${card.getAttribute("data-dimension")}`];
      if (!d) return;
      const uni = d.base100 ? "" : "/100";
      const aporte = +(d.peso * d.puntaje).toFixed(1);
      document.getElementById("cg-modal-eyebrow").textContent = `Dimensión · ${d.sigla} · ${d.cinturon}`;
      document.getElementById("cg-modal-title").textContent = d.nombre;
      document.getElementById("cg-modal-que").textContent = d.que;

      const aporta = document.getElementById("cg-modal-aporta");
      aporta.innerHTML =
        `<strong>Cómo entra al ${esc(d.sigla)}:</strong> pesa ${Math.round(d.peso * 100)}% del índice — ` +
        `su puntaje ${nf.format(d.puntaje)}${uni} aporta <strong>${nf.format(aporte)}</strong> ` +
        `de los ${nf.format(d.indiceValor)} puntos del ${esc(d.sigla)}.` +
        (d.critica
          ? `<br><br><span class="cg-dim-critica-chip">Dimensión crítica</span> Puntaje debajo del umbral ` +
            `(${d.base100 ? 85 : 30}): el promedio del índice la compensa aritméticamente con las dimensiones ` +
            `fuertes, pero en la realidad los frentes no se sustituyen — el flag evita que el titular esconda ` +
            `este agujero.`
          : "");
      aporta.style.display = "";

      document.getElementById("cg-modal-ficha").innerHTML = [
        ["Puntaje", `${nf.format(d.puntaje)}${uni || " (base 100)"}`],
        ["Peso en el índice", `${Math.round(d.peso * 100)}%`],
        ["Aporte al índice", `${nf.format(aporte)} pts`],
        ["Indicadores", `${d.comps.length}`],
        ["Agregación", "Promedio ponderado (interpolado)"],
        ["Ajustes del analista", d.ajustes.length ? `${d.ajustes.length} vigente${d.ajustes.length > 1 ? "s" : ""}` : "ninguno"],
      ].map(([k, v]) => `<div><dt>${k}</dt><dd>${esc(v)}</dd></div>`).join("");
      mostrarFormula(
        String.raw`\text{puntaje de la dimensi\'on}=\sum_{\text{indicadores}}\text{peso}\times\text{puntaje interpolado}`,
        "Los pesos internos son los de la paramétrica CIGOB; el puntaje de cada indicador se interpola entre las anclas de sus umbrales. Si un indicador se queda sin dato, los pesos se renormalizan entre los presentes.",
      );

      const filas = d.comps.map(cmp => {
        const pct = d.base100
          ? Math.max(3, Math.min(100, ((cmp.puntaje - 60) / 70) * 100))
          : Math.max(3, Math.min(100, cmp.puntaje));
        const aporteCmp = +(cmp.peso * cmp.puntaje).toFixed(1);
        return `<div class="cg-dimm-row">` +
          `<div class="cg-dimm-top">` +
            `<span class="cg-dimm-name">${esc(cmp.label)}${cmp.valor ? ` <span class="cg-dimm-raw">· ${esc(cmp.valor)}</span>` : ""}</span>` +
            `<span class="cg-dimm-val"><strong>${nf.format(cmp.puntaje)}</strong>${uni} × ${Math.round(cmp.peso * 100)}% = ${nf.format(aporteCmp)} pts</span>` +
          `</div>` +
          `<div class="cg-bar"><div class="cg-bar-fill" style="width:${pct}%"></div></div>` +
          (cmp.ajustado ? `<p class="cg-dimm-aj">Ajustado por el analista (puntaje de banda: ${nf.format(cmp.banda)})</p>` : "") +
        `</div>`;
      }).join("");
      const ajTxt = d.ajustes.map(a => esc(a.justificacion)).join(" · ");
      document.getElementById("cg-modal-score").innerHTML =
        `<h4 class="cg-modal-h4">Composición de la dimensión</h4>` +
        `<div class="cg-dimm-list cg-dimm--${esc(d.slug)}">${filas}</div>` +
        (ajTxt ? `<p class="cg-score-map"><strong>Justificación del ajuste:</strong> ${ajTxt}</p>` : "") +
        `<p class="cg-score-note">El puntaje de la dimensión es la suma ponderada de los puntajes ` +
        `interpolados de sus indicadores (pesos internos de la paramétrica; si un indicador se queda sin ` +
        `dato, los pesos se renormalizan). El ${esc(d.sigla)} compone sus dimensiones igual: ` +
        `${Math.round(d.peso * 100)}% × ${nf.format(d.puntaje)} = <strong>${nf.format(aporte)}</strong> puntos.</p>`;
      document.getElementById("cg-modal-score").style.display = "";

      document.getElementById("cg-modal-contexto").style.display = "none";
      // Sin gráfico aparte: las filas de composición YA son el visual (un
      // bar chart de puntajes repetiría la misma información).
      document.getElementById("cg-modal-serie-h").style.display = "none";
      document.getElementById("cg-modal-sub").style.display = "none";
      document.getElementById("cg-modal-table").innerHTML = "";
      csvBtn.setAttribute("hidden", "");
      serieActual = []; keyActual = "";
      destruirChart();
      document.getElementById("cg-modal-chart").setAttribute("hidden", "");
      modal.removeAttribute("hidden");
    };
    card.addEventListener("click", abrir);
    card.addEventListener("keydown", e => {
      if (e.key === "Enter" || e.key === " ") { e.preventDefault(); abrir(); }
    });
  });

  // Mini-gráficos de la sección "Evolución" de la home (si está presente). Se montan
  // recién al entrar en viewport, reusando SERIES y la carga on-demand de ApexCharts.
  // Va en este script (no en Evolucion.astro) para que la home tenga UN solo módulo
  // hoisted — con dos, Astro referencia uno y dejaba el modal sin cablear.
  const evoGrid = document.getElementById("cg-chart-grid");
  if (evoGrid) {
    let evoMontado = false;
    const io = new IntersectionObserver(async (es) => {
      if (evoMontado || !es.some(e => e.isIntersecting)) return;
      evoMontado = true; io.disconnect();
      const C = await ensureCharts();
      evoGrid.querySelectorAll("[data-evo-key]").forEach(el => {
        // data-evo-serie: serie embebida inline (tiles de tensión por
        // cinturón, que no viven en series.json) — tiene prioridad.
        const inline = el.getAttribute("data-evo-serie");
        const serie = inline ? JSON.parse(inline) : SERIES[el.getAttribute("data-evo-key")];
        if (!serie || serie.length < 2) return;
        C.sparkChart(el, serie, {
          color: C.colorDe(el.getAttribute("data-evo-slug")),
          unidad: el.getAttribute("data-evo-unidad") || "",
        });
      });
    }, { rootMargin: "250px" });
    io.observe(evoGrid);
  }
</script>
