---
import { label, aclaracion, presentacion } from "../lib/datos.ts";
import Sparkline from "./Sparkline.astro";
const { ikey, ind, bucket, slug } = Astro.props;
// Solo para el punto del sparkline (cg-spark-dot), que Sparkline.astro solo
// dibuja cuando bucket==="fresco" -- en la práctica siempre resuelve a
// "verde" (marca "dato fresco", no una lectura de tensión) y sus otras dos
// ramas están muertas.
const estDot = bucket === "fresco" ? "verde" : bucket === "rezagado" ? "amarillo" : "rojo";
const nota = aclaracion(bucket, ind);
const clickable = bucket !== "placeholder";
const pres = presentacion(ikey, ind);
---
<li class:list={["cg-ind", { "cg-ind--clickable": clickable }]} data-indicador={ikey} data-cinturon={slug} title={pres.titulo}>
  <span class="cg-ind-name">
    {label(ikey)}
    {nota && <em style="font-style:normal;color:var(--muted-soft);font-size:11px;margin-left:6px;">({nota})</em>}
  </span>
  {bucket === "fresco" && (
    <span class="cg-ind-sparkline"><Sparkline indicador={ikey} estado={estDot} /></span>
  )}
  <span class="cg-ind-value">
    {pres.texto}
    {pres.unidad && <span class="cg-ind-unit">{pres.unidad}</span>}
    {/* Frescura/origen del dato, no tensión -- iba coloreado verde/amarillo/
        rojo con la paleta del semáforo, en la misma card donde el genoma
        pinta tensión real (mismo defecto que A1, acá en la card de resumen
        de la portada: un "— pendiente" pintaba rojo, como si fuera crisis).
        Clase por bucket, no por color (revisión de coherencia UI, ago-2026). */}
    <span class:list={["cg-ind-est", bucket]} aria-hidden="true"></span>
  </span>
</li>
