---
// Aguja de temperatura: la lectura primaria del informe.
//
// Dibuja la tensión 0-10 sobre un arco partido en los cuatro tramos del
// semáforo. El arco sale de `tramosSemaforo()`, que lee los cortes del
// snapshot: acá no hay ningún umbral escrito a mano, y si mañana cambian los
// cortes la aguja se redibuja sola.
//
// El color NO es el único canal, por tres razones concretas: hay lectores que
// no distinguen rojo de verde, el informe se imprime y se fotocopia en gris, y
// un lector de pantalla no ve nada de esto. Así que cada aguja lleva, además
// del color: un ARCO BASE neutro con marcas y números en los extremos —que
// sobrevive a la escala de grises y le da referencia a la posición del
// puntero—, una ETIQUETA con el nombre del tramo, y un `aria-label` que dice
// todo en una frase.
//
// Dos ausencias distintas, que antes se confundían en una (revisión
// adversarial, ago-2026): que no haya TENSIÓN y que no haya ESCALA. Sin cortes
// publicados el componente decía "Sin dato" mientras imprimía el número al
// lado. Ahora la falta de escala se nombra como lo que es y el valor se sigue
// mostrando, porque el dato existe: lo que falta es cómo clasificarlo.
import { tramosSemaforo, colorPorTension, LECTURA_SEMAFORO, TENSION_MAX, num } from "../lib/datos.ts";

interface Props {
  tension: number | null | undefined;
  titulo: string;
  /** "grande" para el titular del informe, "chica" para cards y listas. */
  tamano?: "grande" | "chica";
  /** Texto corto bajo la etiqueta (p. ej. el riesgo dominante). Opcional. */
  pie?: string;
  /** El título sigue nombrando la aguja para el lector de pantalla, pero no
      se dibuja. Para cuando el contexto ya lo dice (la card del cinturón ya
      lleva su nombre arriba y repetirlo es ruido). */
  ocultarTitulo?: boolean;
}
const { tension, titulo, tamano = "chica", pie, ocultarTitulo = false } = Astro.props as Props;

const tramos = tramosSemaforo();
const hayEscala = tramos.length > 0;
const valor = typeof tension === "number" && Number.isFinite(tension) ? tension : null;
const color = hayEscala ? colorPorTension(tension) : null;

// Geometría del arco. Semicírculo de 180°: 0 de tensión a la izquierda, el
// máximo a la derecha. El viewBox es fijo y el tamaño real lo pone el CSS, así
// que la misma geometría sirve para la aguja grande y la chica.
const R = 100;
const CX = 120;
const CY = 116;
const GROSOR = tamano === "grande" ? 22 : 18;
// El tramo activo se dibuja más grueso (es su canal no cromático), así que la
// geometría de las marcas tiene que usar ESTE número y no el de los inactivos:
// si no, la marca no cruza la banda activa y quedan colas sin cortar.
const GROSOR_ACTIVO = tamano === "grande" ? 30 : 26;

const rad = (t: number) => Math.PI * (1 - Math.min(Math.max(t, 0), TENSION_MAX) / TENSION_MAX);
const punto = (t: number, radio = R) => {
  const a = rad(t);
  return [CX + radio * Math.cos(a), CY - radio * Math.sin(a)];
};
const arco = (desde: number, hasta: number) => {
  const [x0, y0] = punto(desde);
  const [x1, y1] = punto(hasta);
  // sweep=1: en coordenadas SVG (y hacia abajo) recorre el arco por arriba.
  return `M ${x0.toFixed(2)} ${y0.toFixed(2)} A ${R} ${R} 0 0 1 ${x1.toFixed(2)} ${y1.toFixed(2)}`;
};

const [px, py] = valor !== null ? punto(valor, R - GROSOR / 2 - 2) : [CX, CY];

// Separadores de tramo: CRUZAN la banda de lado a lado en vez de rozarla por
// fuera. Por fuera medían 5 unidades y en las agujas chicas quedaban en ~2 px,
// que el antialiasing borra; cruzando la banda se ven a cualquier tamaño y son
// lo que deja leer la escala cuando el color no llega.
const tick = (t: number) => {
  const [xa, ya] = punto(t, R - GROSOR_ACTIVO / 2 - 1);
  const [xb, yb] = punto(t, R + GROSOR_ACTIVO / 2 + 1);
  return { x1: xa.toFixed(2), y1: ya.toFixed(2), x2: xb.toFixed(2), y2: yb.toFixed(2) };
};
const rotulo = (t: number) => {
  const [x, y] = punto(t, R + GROSOR_ACTIVO / 2 + 12);
  return { x: x.toFixed(2), y: (y + 4).toFixed(2) };
};

const lectura = color ? LECTURA_SEMAFORO[color] : null;
const aria = valor === null
  ? `${titulo}: sin dato`
  : lectura
    ? `${titulo}: tensión ${num(valor)} de ${TENSION_MAX} — ${lectura} (${color})`
    : `${titulo}: tensión ${num(valor)} de ${TENSION_MAX} — escala de colores no disponible`;
---
<figure class:list={["cg-aguja", `cg-aguja--${tamano}`, color ? `sem-${color}` : "is-sinescala"]}>
  {/* El viewBox deja margen a los lados: los rótulos 0 y 10 van centrados en
      x=-4 y x=244, así que con el encuadre justo se salían por los bordes.
      Y arriba, el tramo activo engrosado llega a y=1. */}
  <svg viewBox="-20 -2 288 132" role="img" aria-label={aria} class="cg-aguja-svg">
    {/* Arco base neutro: es la referencia que queda cuando el color no llega
        —impresión en gris, forced-colors, cortes ausentes— y lo que convierte
        al ángulo de la aguja en una posición legible sobre una escala. */}
    <path d={arco(0, TENSION_MAX)} class="cg-aguja-base" stroke-width={GROSOR} fill="none" stroke-linecap="butt" />
    {tramos.map(t => (
      <path
        d={arco(t.desde, t.hasta)}
        class:list={["cg-aguja-tramo", `sem-${t.color}`, { "is-activo": t.color === color }]}
        stroke-width={GROSOR}
        fill="none"
        stroke-linecap="butt"
      />
    ))}
    {/* Una marca por corte, no solo en los extremos: son las divisiones que
        permiten leer en qué tramo cae la aguja cuando el color no llega. */}
    {tramos.map(t => <line {...tick(t.desde)} class="cg-aguja-tick" />)}
    <line {...tick(TENSION_MAX)} class="cg-aguja-tick" />
    <text {...rotulo(0)} class="cg-aguja-escala" text-anchor="middle">0</text>
    <text {...rotulo(TENSION_MAX)} class="cg-aguja-escala" text-anchor="middle">{TENSION_MAX}</text>
    {valor !== null && (
      <>
        {/* La aguja: una línea desde el centro hasta el arco. Es la que se lee
            en blanco y negro. */}
        <line x1={CX} y1={CY} x2={px.toFixed(2)} y2={py.toFixed(2)} class="cg-aguja-linea" />
        <circle cx={CX} cy={CY} r={tamano === "grande" ? 7 : 6} class="cg-aguja-eje" />
      </>
    )}
  </svg>
  <figcaption class="cg-aguja-cap">
    {!ocultarTitulo && <span class="cg-aguja-titulo">{titulo}</span>}
    {valor === null
      ? <span class="cg-aguja-lectura is-sindato">Sin dato</span>
      : lectura
        ? <span class="cg-aguja-lectura">{lectura}</span>
        : <span class="cg-aguja-lectura is-sinescala">Escala no disponible</span>}
    {valor !== null && (
      <span class="cg-aguja-valor">{num(valor)}<span class="cg-aguja-valor-max">/{TENSION_MAX}</span></span>
    )}
    {pie && <span class="cg-aguja-pie">{pie}</span>}
  </figcaption>
</figure>
