---
// Sección Metodología de la portada: el recorrido del dato (fuentes →
// extracción → gates → índices → tensión), los índices paramétricos con sus
// valores vivos, los controles de credibilidad y el acceso al diccionario de fichas.
// TODOS los números salen del snapshot en el build — nada cargado a mano.
import { informe, CINTURONES, indiceDe, badgeEstado, num } from "../lib/datos.ts";
import { FICHAS } from "../lib/fichas.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// conteos vivos: indicadores únicos, automáticos y fuentes distintas
const vistos = new Set<string>();
const fuentes = new Set<string>();
let autos = 0;
for (const c of Object.values(informe.cinturones)) {
  for (const [k, ind] of Object.entries(c.indicadores)) {
    if (!vistos.has(k)) {
      vistos.add(k);
      if (badgeEstado(ind) === "Automático") autos++;
    }
    if (ind.fuente) fuentes.add(ind.fuente as string);
  }
}
const nInd = vistos.size;
const nFuentes = fuentes.size;
const nFichas = Object.keys(FICHAS).length;

// los índices paramétricos, con valor vivo y composición
const indices = CINTURONES
  .map(c => ({ meta: c, indice: indiceDe(informe.cinturones[c.key]) }))
  .filter(x => x.indice) as { meta: (typeof CINTURONES)[number]; indice: NonNullable<ReturnType<typeof indiceDe>> }[];
const compDe = (i: (typeof indices)[number]["indice"]) => {
  const dims = Object.values(i.data.dimensiones);
  const nDims = dims.length;
  const nComp = dims.reduce((s, d) => s + Object.keys(d.indicadores ?? {}).length, 0);
  return `${nDims} dimensiones · ${nComp} ${i.base100 ? "componentes" : "indicadores"}`;
};
---
<section class="cg-section cg-method" id="metodologia">
  <div class="cg-section-head">
    <p class="cg-eyebrow">Cómo se construye</p>
    <h2 class="cg-h2">El método de los cinturones</h2>
    <p class="cg-h2-sub">De la fuente oficial al color, sin pasos a mano.</p>
  </div>

  <!-- El recorrido del dato: de la fuente oficial al semáforo, con números vivos -->
  <div class="cg-met-flow" role="list" aria-label="El recorrido del dato, de la fuente a la tensión">
    <div class="cg-met-step" role="listitem">
      <span class="cg-met-num">{nFuentes}</span>
      <span class="cg-met-lbl">Fuentes</span>
      <span class="cg-met-desc">INDEC, BCRA, Hacienda, InfoLeg, HCDN y más: públicas y citadas.</span>
    </div>
    <span class="cg-met-arrow" aria-hidden="true">→</span>
    <div class="cg-met-step" role="listitem">
      <span class="cg-met-num">{nInd}</span>
      <span class="cg-met-lbl">Indicadores</span>
      <span class="cg-met-desc">{autos} se extraen solos cada madrugada; el resto se declara manual o estimación.</span>
    </div>
    <span class="cg-met-arrow" aria-hidden="true">→</span>
    <div class="cg-met-step" role="listitem">
      <span class="cg-met-num">6</span>
      <span class="cg-met-lbl">Controles</span>
      <span class="cg-met-desc">Si un dato no cierra, no se publica: queda en pie la edición anterior.</span>
    </div>
    <span class="cg-met-arrow" aria-hidden="true">→</span>
    <div class="cg-met-step" role="listitem">
      <span class="cg-met-num">{indices.length}</span>
      <span class="cg-met-lbl">Índices</span>
      <span class="cg-met-desc">ITCM, ITCP, ITVC e ITCG: los cuatro cinturones derivan su tensión de un índice.</span>
    </div>
    <span class="cg-met-arrow" aria-hidden="true">→</span>
    <div class="cg-met-step" role="listitem">
      <span class="cg-met-num">{num(informe.score_global)}<small>/10</small></span>
      <span class="cg-met-lbl">Tensión global hoy</span>
      <span class="cg-met-desc">Pondera los cuatro cinturones según la fase del mandato.</span>
    </div>
  </div>

  <!-- Los índices paramétricos, con su valor vivo → ficha metodológica -->
  <div class="cg-met-indices">
    {indices.map(({ meta, indice }) => (
      <a class={`cg-met-ind cg-met-ind--${meta.slug}`} href={`${base}/metodologia/${indice.sigla.toLowerCase()}/`}>
        <div class="cg-met-ind-head">
          <span class="cg-met-ind-sigla">{indice.sigla}</span>
          <span class="cg-met-ind-cint">{meta.nombre}</span>
        </div>
        <div class="cg-met-ind-val">
          {num(indice.data.valor)}<small>{indice.base100 ? " · base 100" : "/100"}</small>
        </div>
        <div class="cg-met-ind-banda">{indice.data.banda_legible}</div>
        {/* "umbrales publicados", no "institucionales": vale para los cuatro
            índices — los del ITCM/ITCG salen de un documento institucional,
            los del ITCP son decisión editorial declarada en su propia ficha,
            y todos están documentados indicador por indicador. */}
        <div class="cg-met-ind-comp">{compDe(indice)} · puntaje {indice.base100 ? "por evolución vs. 4T-2023" : "interpolado entre umbrales publicados"}</div>
        <div class="cg-met-ind-cta">Ficha metodológica →</div>
      </a>
    ))}
  </div>

  {/* Acceso a /metodologia: el marco conceptual + la documentación completa.
      El CTA nombra las fichas porque es lo que cuenta el número que tiene al
      lado, pero la página ya no se llama "el diccionario" (ADR-0202).

      Comentario JSX y no HTML a propósito: los `<!-- -->` de Astro se publican
      en el HTML servido, y este es una nota interna. */}
  <a class="cg-met-cta" href={`${base}/metodologia/`}>
    <div>
      <span class="cg-met-cta-num">{nFichas}</span>
      <div class="cg-met-cta-txt">
        <strong>fichas metodológicas — una por indicador e índice.</strong>
        Qué mide, de dónde sale, cómo puntúa y qué limitaciones declara.
      </div>
    </div>
    <span class="cg-met-cta-go">Abrir la metodología →</span>
  </a>
</section>
