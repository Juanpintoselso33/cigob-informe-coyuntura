---
import { informe, mesLegible } from "../lib/datos.ts";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<footer class="cg-foot">
    <div class="cg-foot-inner">
        <a class="cg-foot-brand" href="https://www.cigob.org" target="_blank" rel="noopener">
            <span class="cg-foot-logo"><img src={`${base}/cigob-icono.png`} alt="CiGob" /></span>
            <div>
                <strong>CiGob</strong>
                <span>Ciencias para gobernar</span>
                <span class="cg-foot-prod">Monitor del Plan de Gobierno</span>
            </div>
        </a>
        <div class="cg-foot-cols">
            <div>
                <h4>El observatorio</h4>
                <a href={`${base}/#snapshot`}>Mes actual</a>
                <a href={`${base}/#evolucion`}>Evolución</a>
                {/* Mismo destino que el ítem del Nav (ADR-0201): un rótulo
                    "Metodología" no puede llevar a dos lugares distintos según
                    desde dónde se lo toque. */}
                <a href={`${base}/metodologia/`}>Metodología</a>
            </div>
            <div>
                <h4>Institucional</h4>
                <a href="https://cigob.org" target="_blank" rel="noopener">cigob.org</a>
                <a href="mailto:info@cigob.org.ar">info@cigob.org.ar</a>
            </div>
            <div>
                <h4>Para investigadores</h4>
                {/* Los dos destinos que le sirven a quien viene a auditar: el
                    encuadre y el diccionario. Antes eran "Metodología" (al
                    ancla de la portada) y "Fichas", o sea un resumen y el
                    detalle, con el marco en ningún lado. */}
                <a href={`${base}/metodologia/#marco`}>Marco metodológico</a>
                <a href={`${base}/metodologia/`}>Fichas metodológicas</a>
                <p style="margin-top:8px;color:var(--tinta-tenue);font-size:12.5px;">
                    Buenos Aires · República Argentina
                </p>
            </div>
        </div>
    </div>
    <div class="cg-foot-legal">
        © 2026 Fundación CiGob · Observatorio independiente de indicadores públicos · Edición {mesLegible(informe.period)} · Datos generados: <span id="cg-foot-time">{informe.generated_at.slice(0, 10)}</span>
    </div>
</footer>
