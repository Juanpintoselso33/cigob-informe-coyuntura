.vscode/
*.swp
*.swo
*~

# ============================================================
# Lenguajes y package managers
# ============================================================
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.venv/
venv/
env/
node_modules/
# package-lock.json NO se ignora: el deploy (pages.yml) corre `npm ci`,
# que requiere el lockfile versionado para builds reproducibles.

# ============================================================
# Credenciales y secretos
# ============================================================
.env
.env.local
.env.*.local
*.pem
*.key
client_secret*.json
credentials.json
service-account*.json

# ============================================================
# Backup y temporales
# ============================================================
backup/
*.bak
*.backup

# ============================================================
# Output generado en runtime
# ============================================================
output/*.png
output/main_script.js
output/review_screenshots/

# Outputs de colectores e informes CIGOB
# SE VERSIONAN para que los colaboradores tengan el reporte y los datos ya
# generados sin tener que correr los colectores (que pegan a APIs que a veces
# fallan). Incluye: output/cache/*.json, output/informe.{json,md}, output/series/
# y scripts/vida_cotidiana/data/. El pipeline diario (CI) los actualiza.

